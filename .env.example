# API KEYS — DO NOT PUT REAL KEYS HERE.
# This file is a TEMPLATE committed to the repo. Real keys live OUTSIDE the repo
# (and outside your shell env) so they never override your Claude Code / Codex OAuth
# during regular use.
#
# Real key file (create this, chmod 600, never commit):
#   ~/.config/harnesseval/keys.env
#       HARNESS_ANTHROPIC_API_KEY=sk-ant-...
#       HARNESS_OPENAI_API_KEY=sk-...
#       HARNESS_LUNAROUTE_API_KEY=...
#       LUNAROUTE_BASE_URL=https://gw.lunaroute.com/v1   (NOT prefixed — not a collision risk)
#       HARNESS_MARTIAN_API_KEY=...                       (optional: Martian-proxy judge cross-check)
#
# Why outside the repo + outside the shell profile:
#   - Claude Code uses ANTHROPIC_API_KEY over OAuth if the env var is set.
#   - Codex reads OPENAI_API_KEY over ChatGPT OAuth if set.
#   So these must NEVER be exported in ~/.zshrc / ~/.bash_profile / etc.
#   The harness (harnesseval/keys.py) reads ~/.config/harnesseval/keys.env ONLY during
#   API-direct phases (A, C) and passes keys to SDK constructors directly; Phase B
#   (CLI/OAuth) never loads this file, so OAuth stays the default.
#
#   KEY NAMES (explicit, as of 2026-08-22): the file uses HARNESS_-prefixed names so they
#   can NEVER collide with the env-var names the CLIs watch for — an accidental `source`d
#   or leaked file therefore cannot override your Claude Code / Codex OAuth:
#       HARNESS_ANTHROPIC_API_KEY  -> harness passes to Anthropic(api_key=...) / Inspect anthropic provider
#       HARNESS_OPENAI_API_KEY      -> harness passes to OpenAI(api_key=...)       / Inspect openai provider
#       HARNESS_LUNAROUTE_API_KEY   -> harness passes to OpenAI(base_url=LUNAROUTE_BASE_URL, api_key=...) for GLM/Kimi
#       HARNESS_MARTIAN_API_KEY    -> harness passes to AsyncOpenAI(base_url=https://api.withmartian.com/v1) for judge cross-check (optional)
#       LUNAROUTE_BASE_URL          -> base_url for the Lunaroute OpenAI-compatible client (NOT prefixed)
#   The harness (harnesseval/keys.py) reads this file ONLY during API-direct phases (A, C)
#   and passes values to SDK constructors directly. Phase B (CLI/OAuth) never loads it.
#   Even so, never `source` this file or export these into any shell.
#
# Optional gold standard: store keys in macOS Keychain instead of the plaintext file
# (security add-generic-password -s harnesseval-anthropic -a $USER -w) and the harness
# reads via `security find-generic-password -s harnesseval-anthropic -w`.

KEYS_FILE=~/.config/harnesseval/keys.env

# Pinned upstream SHAs (re-pin if upstream moves; update docs/SPEC.md too)
MARTIAN_CRB_SHA=2b092b670f
METAREVIEW_SHA=

# Judge models (Martian's, for calibration compatibility — STAY on the old trio)
JUDGE_OPUS=claude-opus-4-5-20251101
JUDGE_SONNET=claude-sonnet-4-5-20250929
JUDGE_GPT=openai/gpt-5.2

# Models under test (run #2, after calibration).
# Effort cells: {medium, xhigh}. Use FULL snapshot IDs, never aliases.
# Claude (OAuth via Claude Code for Phase B; Anthropic API for Phase C):
MUT_OPUS_48=            # resolve full snapshot id in Phase 0
MUT_OPUS_5=             # resolve full snapshot id in Phase 0
MUT_FABLE=              # resolve full snapshot id in Phase 0
# Codex (OAuth via Codex CLI for Phase B; OpenAI API for Phase C):
MUT_CODEX_SOL=gpt-5.6-sol
# Older anchors:
MUT_SONNET=claude-sonnet-4-5-20250929
MUT_GPT=openai/gpt-5.2
# GLM + Kimi (Lunaroute subscription, flat-fee → free marginal, all phases):
MUT_GLM=glm-5.2-vision-flex
MUT_KIMI=kimi-k3
# Effort mapping (provider-native reasoning_effort value to send to each API):
#   Claude/GPT/GLM:  medium->medium,  xhigh->xhigh
#   Kimi:           medium->high,    xhigh->max   (pi thinkingLevelMap)

# Gemini 2.5 Pro: DROPPED (no paid Gemini subscription).
# Codex 5.6 Terra: DROPPED (per user, 2026-08-22).

# Token price table date for $ estimates (derived, labeled)
PRICE_DATE=2026-08-22
