import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";

import { vi, describe, it, beforeEach, expect } from "vitest";

vi.mock("@calcom/lib/server/queries/teams", () => ({
  isTeamAdmin: vi.fn().mockResolvedValue(false),
  isTeamOwner: vi.fn().mockResolvedValue(false),
}));

vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
  getUsersCredentials: vi.fn().mockResolvedValue([]),
}));

vi.mock("@calcom/lib/server", async (importOriginal) => {
  const actual = await importOriginal<typeof import("@calcom/lib/server")>();
  return {
    ...actual,
    getTranslation: vi.fn().mockResolvedValue((key: string) => key),
  };
});

vi.mock("@calcom/emails", () => ({
  sendAddGuestsEmails: vi.fn().mockResolvedValue(undefined),
}));

vi.mock("@calcom/core/EventManager", () => ({
  default: class {
    updateCalendarAttendees = vi.fn().mockResolvedValue(undefined);
  },
}));

import { addGuestsHandler } from "./addGuests.handler";

describe("addGuestsHandler — attendee authorization on inactive bookings", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("does not let an attendee add guests to a cancelled booking", async () => {
    const user = { id: 1, email: "attendee@example.com" };
    const organizer = {
      id: 999,
      email: "organizer@example.com",
      name: "Organizer",
      timeZone: "UTC",
      locale: "en",
    };

    const cancelledBooking = {
      id: 1,
      uid: "booking-uid",
      title: "Cancelled meeting",
      description: "",
      startTime: new Date("2020-01-01T10:00:00Z"),
      endTime: new Date("2020-01-01T11:00:00Z"),
      status: "CANCELLED",
      userId: organizer.id,
      userPrimaryEmail: organizer.email,
      location: null,
      destinationCalendar: null,
      references: [],
      attendees: [{ id: 1, email: user.email, name: "Attendee", timeZone: "UTC", locale: "en" }],
      eventType: {
        teamId: 0,
        title: "Cancelled meeting",
        recurringEvent: null,
        seatsPerTimeSlot: null,
        seatsShowAttendees: null,
      },
      user: { id: organizer.id, destinationCalendar: null, credentials: [] },
    };

    prismaMock.booking.findFirst.mockResolvedValue(cancelledBooking as any);
    prismaMock.user.findFirstOrThrow.mockResolvedValue(organizer as any);
    prismaMock.booking.update.mockResolvedValue(cancelledBooking as any);

    const input = { bookingId: 1, guests: ["uninvited@example.com"] };

    await expect(
      addGuestsHandler({ ctx: { user }, input })
    ).rejects.toThrow();
  });
});
