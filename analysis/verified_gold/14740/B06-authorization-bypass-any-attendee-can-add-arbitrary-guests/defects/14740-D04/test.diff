import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";

import { describe, it, expect, vi, beforeEach } from "vitest";

import { TRPCError } from "@trpc/server";

vi.mock("@calcom/prisma", () => ({
  prisma: prismaMock,
  default: prismaMock,
}));

vi.mock("@calcom/emails", () => ({
  sendAddGuestsEmails: vi.fn().mockResolvedValue(undefined),
}));

vi.mock("@calcom/core/EventManager", () => ({
  default: class EventManagerMock {
    updateCalendarAttendees = vi.fn().mockResolvedValue(undefined);
  },
}));

vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
  getUsersCredentials: vi.fn().mockResolvedValue([]),
}));

vi.mock("@calcom/lib/server/queries/teams", () => ({
  isTeamAdmin: vi.fn().mockResolvedValue(false),
  isTeamOwner: vi.fn().mockResolvedValue(false),
}));

vi.mock("@calcom/lib/server", () => ({
  getTranslation: vi.fn().mockResolvedValue((key: string) => key),
}));

vi.mock("@calcom/lib", () => ({
  parseRecurringEvent: vi.fn().mockReturnValue(undefined),
}));

import { addGuestsHandler } from "./addGuests.handler";

const attendeeUser = { id: 42, email: "attendee@example.com", username: "attendee" };

beforeEach(() => {
  vi.clearAllMocks();

  prismaMock.booking.findFirst.mockResolvedValue({
    id: 100,
    uid: "booking-uid",
    title: "Cancelled booking",
    description: "",
    startTime: new Date("2020-01-01T10:00:00Z"),
    endTime: new Date("2020-01-01T11:00:00Z"),
    status: "CANCELLED",
    userId: 1,
    userPrimaryEmail: "organizer@example.com",
    location: null,
    attendees: [
      { email: "attendee@example.com", name: "Attendee", timeZone: "UTC", locale: "en" },
    ],
    eventType: {
      id: 5,
      title: "Event",
      teamId: null,
      recurringEvent: null,
      seatsPerTimeSlot: null,
      seatsShowAttendees: true,
    },
    destinationCalendar: null,
    references: [],
    user: {
      id: 1,
      email: "organizer@example.com",
      destinationCalendar: null,
      credentials: [],
    },
  } as any);

  prismaMock.user.findFirstOrThrow.mockResolvedValue({
    name: "Organizer",
    email: "organizer@example.com",
    timeZone: "UTC",
    locale: "en",
  } as any);

  prismaMock.booking.update.mockResolvedValue({
    id: 100,
    attendees: [
      { email: "attendee@example.com", name: "Attendee", timeZone: "UTC", locale: "en" },
      { email: "newguest@example.com", name: "", timeZone: "UTC", locale: "en" },
    ],
  } as any);
});

describe("addGuestsHandler — attendee authorization on cancelled booking", () => {
  it("forbids a non-organizer attendee from adding guests to a cancelled booking", async () => {
    await expect(
      addGuestsHandler({
        ctx: { user: attendeeUser as any },
        input: { bookingId: 100, guests: ["newguest@example.com"] },
      })
    ).rejects.toThrow(TRPCError);
  });
});
