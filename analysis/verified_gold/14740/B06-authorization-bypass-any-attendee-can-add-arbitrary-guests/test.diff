diff --git a/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts b/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts
@@ -0,0 +1,125 @@
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, beforeEach, expect } from "vitest";
+
+import dayjs from "@calcom/dayjs";
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn().mockReturnValue(null),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockImplementation(async () => (key: string) => key),
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: class MockEventManager {
+    updateCalendarAttendees = vi.fn().mockResolvedValue(undefined);
+  },
+}));
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn().mockResolvedValue(undefined),
+}));
+
+const attendeeUser = {
+  id: 1,
+  email: "attendee@example.com",
+  name: "Attendee",
+  username: "attendee",
+  locale: "en",
+  timeZone: "UTC",
+  role: "USER",
+  avatarUrl: null,
+  completedOnboarding: true,
+  twoFactorEnabled: false,
+  identityProvider: "CAL",
+  identityProviderId: null,
+  allowDynamicBooking: true,
+} as any;
+
+function makeBooking(overrides: Record<string, unknown> = {}) {
+  return {
+    id: 1,
+    uid: "booking-uid",
+    title: "Meeting",
+    description: "",
+    startTime: dayjs().add(1, "day").toDate(),
+    endTime: dayjs().add(1, "day").add(30, "minute").toDate(),
+    userId: 999,
+    status: "ACCEPTED",
+    location: null,
+    userPrimaryEmail: null,
+    destinationCalendar: null,
+    references: [],
+    attendees: [
+      { id: 1, name: "Attendee", email: attendeeUser.email, timeZone: "UTC", locale: "en" },
+    ],
+    eventType: {
+      id: 1,
+      title: "Meeting",
+      teamId: null,
+      recurringEvent: null,
+      seatsPerTimeSlot: null,
+      seatsShowAttendees: false,
+    },
+    user: { destinationCalendar: null, credentials: [] },
+    ...overrides,
+  };
+}
+
+describe("addGuestsHandler - authorization / booking state", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    prismaMock.user.findFirstOrThrow.mockResolvedValue({
+      name: "Organizer",
+      email: "organizer@example.com",
+      timeZone: "UTC",
+      locale: "en",
+    });
+    prismaMock.booking.update.mockResolvedValue({
+      attendees: [
+        { name: "Attendee", email: attendeeUser.email, timeZone: "UTC", locale: "en" },
+        { name: "Guest", email: "guest@example.com", timeZone: "UTC", locale: "en" },
+      ],
+    });
+  });
+
+  it("rejects adding guests to a CANCELLED booking even for an attendee", async () => {
+    prismaMock.booking.findFirst.mockResolvedValue(
+      makeBooking({ status: "CANCELLED" }) as any
+    );
+    const { addGuestsHandler } = await import("./addGuests.handler");
+    await expect(
+      addGuestsHandler({
+        ctx: { user: attendeeUser },
+        input: { bookingId: 1, guests: ["guest@example.com"] },
+      })
+    ).rejects.toThrow(/cancel|inactive|state|status/i);
+  });
+
+  it("rejects adding guests to a booking that is in the past", async () => {
+    prismaMock.booking.findFirst.mockResolvedValue(
+      makeBooking({
+        startTime: dayjs().subtract(2, "day").toDate(),
+        endTime: dayjs().subtract(2, "day").add(30, "minute").toDate(),
+      }) as any
+    );
+    const { addGuestsHandler } = await import("./addGuests.handler");
+    await expect(
+      addGuestsHandler({
+        ctx: { user: attendeeUser },
+        input: { bookingId: 1, guests: ["guest@example.com"] },
+      })
+    ).rejects.toThrow(/past|expired|inactive|state/i);
+  });
+});
