import { describe, it, expect, vi } from "vitest";
import { render, screen, fireEvent } from "@testing-library/react";
import React, { useState } from "react";

vi.mock("@calcom/lib/hooks/useLocale", () => ({
  useLocale: () => ({ t: (key: string) => key }),
}));

vi.mock("@calcom/ui", () => ({
  Button: ({ children, StartIcon, color, variant, ...rest }: any) => (
    <button {...rest}>{children}</button>
  ),
  Icon: () => <span data-testid="icon" />,
  Tooltip: ({ children }: any) => <>{children}</>,
  EmailField: ({
    value,
    onChange,
    onClickAddon,
    addOnSuffix,
    className,
    label,
    placeholder,
    required,
    disabled,
    ...rest
  }: any) => (
    <div>
      <input value={value} onChange={onChange} />
      {onClickAddon ? (
        <button type="button" data-testid="remove-email" onClick={onClickAddon} />
      ) : null}
      {addOnSuffix}
    </div>
  ),
}));

import MultiEmail from "./MultiEmail";

// CLAIM: list items are keyed by array index, so after removing a middle row React
// reuses the wrong DOM nodes and associates the shifted values with stale inputs.

function Harness() {
  const [value, setValue] = useState<string[]>(["a", "b", "c"]);
  return <MultiEmail value={value} readOnly={false} label="Emails" setValue={setValue} />;
}

describe("MultiEmail list keys", () => {
  it("keeps the same DOM input element for a surviving value after a middle row is removed", () => {
    render(<Harness />);

    const before = screen.getAllByRole("textbox") as HTMLInputElement[];
    expect(before.map((i) => i.value)).toEqual(["a", "b", "c"]);

    // The DOM node currently bound to the value "c" (last row).
    const nodeHoldingC = before[2];

    // Remove the middle row (index 1, value "b").
    fireEvent.click(screen.getAllByTestId("remove-email")[1]);

    const after = screen.getAllByRole("textbox") as HTMLInputElement[];
    expect(after.map((i) => i.value)).toEqual(["a", "c"]);

    // With a stable key, React must move the existing "c" input node up.
    // With key={index} React instead reuses the node that used to render "b",
    // leaving the node that held "c" unmounted and the inputs stale/shifted.
    expect(after[1]).toBe(nodeHoldingC);
  });
});
