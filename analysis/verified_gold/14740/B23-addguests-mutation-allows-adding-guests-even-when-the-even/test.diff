+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: vi.fn().mockImplementation(function () {
+    return { updateCalendarAttendees: vi.fn() };
+  }),
+}));
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn(),
+}));
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn().mockReturnValue(null),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockImplementation(() => Promise.resolve((k: string) => k)),
+}));
+
+const user = {
+  id: 1,
+  email: "attendee@example.com",
+  name: "Attendee",
+  timeZone: "UTC",
+  locale: "en",
+} as any;
+
+beforeEach(() => {
+  vi.clearAllMocks();
+
+  prismaMock.booking.findFirst.mockResolvedValue({
+    id: 100,
+    userId: 99,
+    title: "Test Booking",
+    uid: "booking-uid",
+    startTime: new Date(),
+    endTime: new Date(),
+    attendees: [{ email: "attendee@example.com" }],
+    eventType: {
+      id: 5,
+      title: "Event Type",
+      disableGuests: true,
+      teamId: null,
+      recurringEvent: null,
+      seatsPerTimeSlot: null,
+      seatsShowAttendees: false,
+    },
+    destinationCalendar: null,
+    references: [],
+    user: {
+      destinationCalendar: null,
+      credentials: [],
+    },
+  } as any);
+
+  prismaMock.user.findFirstOrThrow.mockResolvedValue({
+    name: "Organizer",
+    email: "organizer@example.com",
+    timeZone: "UTC",
+    locale: "en",
+  } as any);
+
+  prismaMock.booking.update.mockResolvedValue({
+    attendees: [
+      { email: "attendee@example.com" },
+      { email: "guest@example.com", name: "", timeZone: "UTC", locale: "en" },
+    ],
+  } as any);
+});
+
+describe("addGuestsHandler — event type guest restrictions", () => {
+  it("rejects adding guests when the EventType has guests disabled", async () => {
+    const { addGuestsHandler } = await import("./addGuests.handler");
+
+    await expect(
+      addGuestsHandler({
+        ctx: { user } as any,
+        input: { bookingId: 100, guests: ["guest@example.com"] },
+      })
+    ).rejects.toThrowError(/guest|disabled|forbidden|not allowed/i);
+  });
+});
