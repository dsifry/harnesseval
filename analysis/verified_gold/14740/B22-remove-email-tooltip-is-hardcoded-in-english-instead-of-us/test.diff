@@ -0,0 +1,36 @@
+import React from "react";
+import { render } from "@testing-library/react";
+import { describe, it, expect, vi } from "vitest";
+
+const tooltipContentSpy = vi.fn();
+
+vi.mock("@calcom/lib/hooks/useLocale", () => ({
+  useLocale: () => ({ t: (key: string) => `TRANSLATED[${key}]` }),
+}));
+
+vi.mock("@calcom/ui", () => ({
+  Button: ({ children }: any) => <button>{children}</button>,
+  EmailField: ({ addOnSuffix }: any) => <div>{addOnSuffix}</div>,
+  Icon: () => <span />,
+  Tooltip: ({ content, children }: any) => {
+    tooltipContentSpy(content);
+    return <div>{children}</div>;
+  },
+}));
+
+import MultiEmail from "./MultiEmail";
+
+describe("MultiEmail i18n", () => {
+  it("should use i18n for the remove-email tooltip instead of hardcoded English", () => {
+    render(
+      <MultiEmail
+        value={["test@example.com"]}
+        readOnly={false}
+        label="Emails"
+        setValue={() => {}}
+      />
+    );
+    const tooltipContent = tooltipContentSpy.mock.calls[0]?.[0];
+    expect(tooltipContent).toContain("TRANSLATED");
+  });
+});
