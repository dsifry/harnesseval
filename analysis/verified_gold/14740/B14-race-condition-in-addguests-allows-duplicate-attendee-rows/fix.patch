+const withAddGuestsLock = async <T>(fn: () => Promise<T>): Promise<T> => {
+  let releaseLock: (() => void) | undefined;
+  const prevLock = addGuestsLock;
+  addGuestsLock = new Promise<void>((resolve) => {
+    releaseLock = resolve;
+  });
+  await prevLock;
+  try {
+    return await fn();
+  } finally {
+    releaseLock?.();
+  }
+};
