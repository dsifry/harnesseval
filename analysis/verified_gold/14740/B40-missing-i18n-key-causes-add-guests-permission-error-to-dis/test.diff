@@ -0,0 +1,65 @@
+import { vi, describe, it, expect } from "vitest";
+import { TRPCError } from "@trpc/server";
+
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+vi.mock("@calcom/prisma", () => ({ prisma: prismaMock }));
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/core/EventManager", () => ({ default: vi.fn() }));
+vi.mock("@calcom/emails", () => ({ sendAddGuestsEmails: vi.fn() }));
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+vi.mock("@calcom/lib/server", () => ({ getTranslation: vi.fn() }));
+vi.mock("@calcom/lib", () => ({ parseRecurringEvent: vi.fn() }));
+vi.mock("@calcom/dayjs", () => ({ default: vi.fn() }));
+
+describe("addGuestsHandler permission error", () => {
+  it("should throw the message 'youdonothavepermission' as claimed by the campaign", async () => {
+    prismaMock.booking.findFirst.mockResolvedValue({
+      id: 1,
+      userId: 42,
+      attendees: [],
+      eventType: { teamId: null, title: "Test" },
+      references: [],
+      user: {
+        id: 42,
+        email: "organizer@example.com",
+        destinationCalendar: null,
+        credentials: [],
+      },
+      startTime: new Date(),
+      endTime: new Date(),
+      title: "Test",
+      description: "",
+      location: "",
+      uid: "uid-1",
+      destinationCalendar: null,
+    });
+
+    const { addGuestsHandler } = await import("./addGuests.handler");
+
+    const ctx = { user: { id: 1, email: "unauthorized@example.com" } };
+
+    let error: TRPCError | undefined;
+    try {
+      await addGuestsHandler({
+        ctx: ctx as any,
+        input: { bookingId: 1, guests: ["guest@example.com"] },
+      });
+    } catch (e) {
+      error = e as TRPCError;
+    }
+
+    expect(error).toBeInstanceOf(TRPCError);
+    expect(error?.code).toBe("FORBIDDEN");
+    // The campaign claims the message is the raw key "youdonothavepermission"
+    // (without underscores), which would be missing from common.json.
+    expect(error?.message).toBe("youdonothavepermission");
+  });
+});
