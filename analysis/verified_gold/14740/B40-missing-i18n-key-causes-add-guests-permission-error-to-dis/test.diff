--- /dev/null
+++ b/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts
@@ -0,0 +1,97 @@
+import fs from "node:fs";
+import path from "node:path";
+
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, expect, beforeEach } from "vitest";
+import { TRPCError } from "@trpc/server";
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: vi.fn().mockImplementation(() => ({
+    updateCalendarAttendees: vi.fn().mockResolvedValue(undefined),
+  })),
+}));
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn().mockResolvedValue(undefined),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockResolvedValue((key: string) => key),
+}));
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn().mockReturnValue(null),
+}));
+
+vi.mock("@calcom/dayjs", () => ({
+  default: (v: unknown) => ({ format: () => String(v) }),
+}));
+
+function loadEnCommon(): Record<string, unknown> {
+  const candidates = [
+    "apps/web/public/static/locales/en/common.json",
+    "packages/lib/locales/en/common.json",
+  ];
+  for (const rel of candidates) {
+    const abs = path.resolve(process.cwd(), rel);
+    if (fs.existsSync(abs)) {
+      return JSON.parse(fs.readFileSync(abs, "utf8")) as Record<string, unknown>;
+    }
+  }
+  throw new Error("Could not locate en common.json locale file");
+}
+
+describe("addGuests.handler — permission error message must be translatable", () => {
+  beforeEach(() => {
+    // Booking exists, but the calling user is neither the organizer, an attendee,
+    // nor a team admin/owner — so the FORBIDDEN branch is taken.
+    prismaMock.booking.findFirst.mockResolvedValue({
+      id: 1,
+      userId: 999,
+      attendees: [],
+      eventType: null,
+      references: [],
+      user: { destinationCalendar: null, credentials: [] },
+    } as never);
+  });
+
+  it("throws FORBIDDEN whose message key exists in the common locale", async () => {
+    const { addGuestsHandler } = await import("./addGuests.handler");
+
+    const common = loadEnCommon();
+
+    let caught: unknown;
+    try {
+      await addGuestsHandler({
+        ctx: { user: { id: 1, email: "caller@example.com" } as never },
+        input: { bookingId: 1, guests: ["guest@example.com"] } as never,
+      });
+    } catch (err) {
+      caught = err;
+    }
+
+    expect(caught).toBeInstanceOf(TRPCError);
+    const err = caught as TRPCError;
+    expect(err.code).toBe("FORBIDDEN");
+
+    const message = err.message;
+    expect(typeof message).toBe("string");
+
+    // The FORBIDDEN message must resolve to a translated string, i.e. the
+    // key supplied must be present in the en common.json locale file.
+    expect(
+      Object.prototype.hasOwnProperty.call(common, message),
+      `forbidden message key "${message}" is missing from en/common.json, so users see the raw "forbidden: ${message.replace(/_/g, "")}" string`
+    ).toBe(true);
+  });
+});
