+import { describe, it, expect } from "vitest";
+import { ZGetInputSchema } from "./get.schema";
+import { ZConfirmInputSchema } from "./confirm.schema";
+
+describe("bookings router input contract: fractional bookingId is rejected with an integer validation error on the bookingId field", () => {
+  it("ZGetInputSchema rejects bookingId=1.5 and the issue is specifically an integer type error on bookingId", () => {
+    const result = ZGetInputSchema.safeParse({ bookingId: 1.5 });
+    expect(result.success).toBe(false);
+    if (!result.success) {
+      const issue = result.error.issues.find((i) => i.path[0] === "bookingId");
+      expect(issue).toBeDefined();
+      expect(issue?.code).toBe("invalid_type");
+      expect(issue?.message.toLowerCase()).toContain("integer");
+    }
+  });
+
+  it("ZConfirmInputSchema rejects bookingId=1.5 and the issue is specifically an integer type error on bookingId", () => {
+    const result = ZConfirmInputSchema.safeParse({ bookingId: 1.5 });
+    expect(result.success).toBe(false);
+    if (!result.success) {
+      const issue = result.error.issues.find((i) => i.path[0] === "bookingId");
+      expect(issue).toBeDefined();
+      expect(issue?.code).toBe("invalid_type");
+      expect(issue?.message.toLowerCase()).toContain("integer");
+    }
+  });
+});
