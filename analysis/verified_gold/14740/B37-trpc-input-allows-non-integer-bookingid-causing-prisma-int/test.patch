import { describe, it, expect } from "vitest";

import { ZAddGuestsInputSchema } from "./addGuests.schema";

describe("bookings.addGuests input contract", () => {
  it("rejects a fractional bookingId so Prisma never receives a float for an Int column", () => {
    const result = ZAddGuestsInputSchema.safeParse({
      bookingId: 1.5,
      guests: [{ email: "guest@example.com", name: "Guest" }],
    });

    // Fixed behaviour: validation fails with an issue on bookingId (integer required).
    // Current behaviour: bookingId is z.number() without .int(), so 1.5 passes and
    // Prisma later throws a PrismaClientValidationError (surfaced as HTTP 500).
    expect(result.success).toBe(false);

    if (!result.success) {
      expect(result.error.issues).toEqual(
        expect.arrayContaining([expect.objectContaining({ path: ["bookingId"] })])
      );
    }
  });
});
