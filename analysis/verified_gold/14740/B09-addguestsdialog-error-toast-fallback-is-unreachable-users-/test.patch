import { describe, it, expect, vi, beforeEach } from "vitest";
import { render } from "@testing-library/react";
import React from "react";

const mocks = vi.hoisted(() => ({
  showToast: vi.fn(),
  capturedOnError: undefined as ((err: unknown) => void) | undefined,
}));

vi.mock("@calcom/lib/hooks/useLocale", () => ({
  useLocale: () => ({
    t: (key: string) => (key === "unable_to_add_guests" ? "Unable to add guests" : key),
  }),
}));

vi.mock("@calcom/trpc/react", () => ({
  trpc: {
    useUtils: () => ({ viewer: { bookings: { invalidate: vi.fn() } } }),
    viewer: {
      bookings: {
        addGuests: {
          useMutation: (opts: { onError?: (err: unknown) => void }) => {
            mocks.capturedOnError = opts.onError;
            return { mutate: vi.fn(), isPending: false };
          },
        },
      },
    },
  },
}));

vi.mock("@calcom/ui", () => ({
  Button: (props: any) => React.createElement("button", props, props.children),
  Dialog: (props: any) => (props.open ? React.createElement("div", null, props.children) : null),
  DialogContent: (props: any) => React.createElement("div", null, props.children),
  DialogFooter: (props: any) => React.createElement("div", null, props.children),
  DialogHeader: (props: any) => React.createElement("div", null, props.title),
  MultiEmail: () => React.createElement("div"),
  Icon: () => React.createElement("div"),
  showToast: (...args: unknown[]) => mocks.showToast(...args),
}));

import { AddGuestsDialog } from "./AddGuestsDialog";

describe("AddGuestsDialog error toast", () => {
  beforeEach(() => {
    mocks.showToast.mockClear();
    mocks.capturedOnError = undefined;
  });

  it("shows the unable_to_add_guests fallback instead of a raw 'undefined:' prefix", () => {
    render(
      <AddGuestsDialog isOpenDialog={true} setIsOpenDialog={vi.fn()} bookingId={1} />
    );

    expect(mocks.capturedOnError).toBeDefined();
    mocks.capturedOnError!({ message: "some_raw_error", data: undefined });

    // Buggy code produces: "undefined: some_raw_error" because
    // `${err.data?.code}: ${t(err.message)}` is always truthy,
    // making the `|| t("unable_to_add_guests")` fallback dead code.
    expect(mocks.showToast).toHaveBeenCalledWith("Unable to add guests", "error");
  });
});
