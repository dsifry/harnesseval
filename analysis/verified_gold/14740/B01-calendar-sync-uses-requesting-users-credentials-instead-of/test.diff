--- /dev/null
+++ b/packages/trpc/server/routers/viewer/bookings/_router.verified.test.tsx
@@ -0,0 +1,60 @@
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, expect, beforeEach } from "vitest";
+
+vi.mock("./addGuests.handler", () => ({
+  addGuestsHandler: vi.fn(async () => ({ success: true })),
+}));
+
+import { bookingsRouter } from "./_router";
+import { addGuestsHandler } from "./addGuests.handler";
+
+describe("bookings.addGuests — calendar sync must use the booking organizer's credentials", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it("passes the booking organizer (not the requesting/attendee user) down to the calendar-sync handler", async () => {
+    const requestingUser = {
+      id: 102,
+      email: "attendee@cal.com",
+      username: "attendee",
+    };
+    const organizer = {
+      id: 101,
+      email: "organizer@cal.com",
+      username: "organizer",
+    };
+
+    // The booking belongs to the organizer, not to the requesting user.
+    prismaMock.booking.findUnique.mockResolvedValue({
+      id: 1,
+      userId: organizer.id,
+      user: organizer,
+      userPrimaryEmail: organizer.email,
+      attendees: [],
+    } as never);
+
+    const ctx = {
+      user: requestingUser,
+      prisma: prismaMock,
+    } as never;
+
+    const caller = bookingsRouter.createCaller(ctx);
+    await caller.addGuests({
+      bookingId: 1,
+      guests: [{ email: "guest@cal.com" }],
+    } as never);
+
+    // CLAIMED BEHAVIOR: calendar synchronization for a booking must run with the
+    // booking organizer's credentials, because only the organizer owns the
+    // destination calendar. Current (post-PR) code forwards ctx.user (the
+    // requesting/attendee user) instead, so this assertion fails.
+    expect(addGuestsHandler).toHaveBeenCalledTimes(1);
+    const handlerArg = (addGuestsHandler as unknown as { mock: { calls: unknown[][] } }).mock
+      .calls[0][0] as { ctx: { user: { id: number; email: string } } };
+
+    expect(handlerArg.ctx.user.id).toBe(organizer.id);
+    expect(handlerArg.ctx.user.email).toBe(organizer.email);
+  });
+});
