--- /dev/null
+++ b/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts
@@ -0,0 +1,91 @@
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, expect, beforeEach } from "vitest";
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn().mockResolvedValue(undefined),
+}));
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: class {
+    updateCalendarAttendees = vi.fn().mockResolvedValue(undefined);
+  },
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockResolvedValue((key: string) => key),
+}));
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn().mockReturnValue({}),
+}));
+
+import { addGuestsHandler } from "./addGuests.handler";
+
+describe("addGuestsHandler - idempotent when all guests already attendees", () => {
+  const user = {
+    id: 1,
+    email: "organizer@example.com",
+    name: "Organizer",
+    timeZone: "UTC",
+    locale: "en",
+    username: "org",
+  } as any;
+
+  beforeEach(() => {
+    vi.clearAllMocks();
+
+    prismaMock.booking.findFirst.mockResolvedValue({
+      id: 42,
+      userId: 1,
+      uid: "abc",
+      title: "Test",
+      description: "",
+      startTime: new Date(),
+      endTime: new Date(),
+      location: null,
+      userPrimaryEmail: "organizer@example.com",
+      attendees: [{ name: "", email: "already@example.com", timeZone: "UTC", locale: "en" }],
+      eventType: {
+        teamId: null,
+        title: "Test",
+        recurringEvent: null,
+        seatsPerTimeSlot: null,
+        seatsShowAttendees: null,
+      },
+      destinationCalendar: null,
+      references: [],
+      user: { destinationCalendar: null, credentials: [] },
+    } as any);
+
+    prismaMock.user.findFirstOrThrow.mockResolvedValue({
+      name: "Organizer",
+      email: "organizer@example.com",
+      timeZone: "UTC",
+      locale: "en",
+    } as any);
+
+    prismaMock.booking.update.mockResolvedValue({
+      id: 42,
+      attendees: [{ name: "", email: "already@example.com", timeZone: "UTC", locale: "en" }],
+    } as any);
+  });
+
+  it("does not throw BAD_REQUEST when every submitted email is already an attendee (idempotent retry, no probing oracle)", async () => {
+    const result = await addGuestsHandler({
+      ctx: { user },
+      input: { bookingId: 42, guests: ["already@example.com"] },
+    });
+
+    expect(result).toEqual({ message: "Guests added" });
+  });
+});
