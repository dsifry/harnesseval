@@ -0,0 +1,113 @@
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, beforeEach, expect } from "vitest";
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: vi.fn().mockImplementation(() => ({
+    updateCalendarAttendees: vi.fn(),
+  })),
+}));
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn(),
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn(),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockResolvedValue((k: string) => k),
+}));
+
+import { addGuestsHandler } from "./addGuests.handler";
+
+const REQUESTER_USER = {
+  id: 1,
+  email: "requester@example.com",
+  username: "requester",
+  name: "Requester",
+  timeZone: "UTC",
+  locale: "en",
+};
+
+const OTHER_TENANT_BOOKING_ID = 999;
+
+const otherTenantBooking = {
+  id: OTHER_TENANT_BOOKING_ID,
+  userId: 2,
+  title: "Other tenant booking",
+  description: "",
+  startTime: new Date(),
+  endTime: new Date(),
+  location: "",
+  uid: "other-uid",
+  userPrimaryEmail: "other@example.com",
+  attendees: [
+    {
+      id: 1,
+      email: "other-attendee@example.com",
+      name: "Other",
+      timeZone: "UTC",
+      locale: "en",
+    },
+  ],
+  eventType: {
+    id: 10,
+    title: "Other event",
+    teamId: 5,
+    recurringEvent: null,
+    seatsPerTimeSlot: null,
+    seatsShowAttendees: null,
+  },
+  references: [],
+  destinationCalendar: null,
+  user: {
+    id: 2,
+    destinationCalendar: null,
+    credentials: [],
+  },
+};
+
+describe("addGuests handler authorization scoping", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+
+    // Simulate a database that enforces the `where` clause.
+    // A properly scoped query (userId, OR, eventType, or AND with userId)
+    // must NOT return a booking that belongs to another tenant.
+    prismaMock.booking.findFirst.mockImplementation(async (args: any) => {
+      const where = args?.where ?? {};
+      const isScoped =
+        "userId" in where ||
+        "OR" in where ||
+        "eventType" in where ||
+        ("AND" in where && JSON.stringify(where).includes("userId"));
+
+      if (where.id === OTHER_TENANT_BOOKING_ID) {
+        return isScoped ? null : otherTenantBooking;
+      }
+      return null;
+    });
+  });
+
+  it("should not load a booking from another tenant before authorization (must return NOT_FOUND)", async () => {
+    const user = REQUESTER_USER as any;
+
+    await expect(
+      addGuestsHandler({
+        ctx: { user },
+        input: { bookingId: OTHER_TENANT_BOOKING_ID, guests: ["newguest@example.com"] },
+      })
+    ).rejects.toThrowError("booking_not_found");
+  });
+});
