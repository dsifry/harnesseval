diff --git a/packages/emails/templates/organizer-add-guests-email.verified.test.ts b/packages/emails/templates/organizer-add-guests-email.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/emails/templates/organizer-add-guests-email.verified.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, vi } from "vitest";
+
+import type { CalendarEvent } from "@calcom/types/Calendar";
+
+vi.mock("../lib/generateIcsString", () => ({
+  default: vi.fn(() => "BEGIN:VCALENDAR\nEND:VCALENDAR"),
+}));
+
+vi.mock("../", () => ({
+  renderEmail: vi.fn(async () => "<html></html>"),
+}));
+
+describe("OrganizerAddGuestsEmail", () => {
+  test("getNodeMailerPayload builds a subject when attendees is empty", async () => {
+    process.env.NEXT_PUBLIC_WEBAPP_URL = "http://localhost:3000";
+    process.env.EMAIL_FROM = "test@example.com";
+
+    const { default: OrganizerAddGuestsEmail } = await import("./organizer-add-guests-email");
+
+    const calEvent = {
+      type: "Test Event",
+      title: "Test Event",
+      attendees: [],
+      organizer: {
+        name: "Organizer",
+        email: "organizer@example.com",
+        timeZone: "UTC",
+      },
+      startTime: "2030-01-01T10:00:00.000Z",
+      endTime: "2030-01-01T11:00:00.000Z",
+      timeZone: "UTC",
+    } as unknown as CalendarEvent;
+
+    const email = Object.create(
+      OrganizerAddGuestsEmail.prototype
+    ) as OrganizerAddGuestsEmail;
+
+    Object.assign(email, {
+      calEvent,
+      teamMember: undefined,
+      t: (key: string) => key,
+      getFormattedDate: () => "Jan 1, 2030",
+      getMailerOptions: () => ({ from: "test@example.com" }),
+      getTextBody: () => "text body",
+    });
+
+    const payload = await (
+      email as unknown as {
+        getNodeMailerPayload: () => Promise<Record<string, unknown>>;
+      }
+    ).getNodeMailerPayload();
+
+    expect(typeof payload.subject).toBe("string");
+    expect(payload.subject).not.toContain("undefined");
+  });
+});
