import { describe, it, expect, vi, beforeEach } from "vitest";
import { renderToString } from "react-dom/server";
import React from "react";

vi.mock("@calcom/ui", () => {
  const Button = vi.fn(({ children }: any) => <button>{children}</button>);
  const EmailField = vi.fn(() => <input />);
  const Icon = vi.fn(() => <svg />);
  const Tooltip = vi.fn(({ children }: any) => <>{children}</>);
  return { Button, EmailField, Icon, Tooltip };
});

vi.mock("@calcom/lib/hooks/useLocale", () => ({
  useLocale: () => ({ t: (key: string) => key }),
}));

import * as ui from "@calcom/ui";

describe("MultiEmail circular dependency", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("should not use exports from the @calcom/ui barrel (to avoid circular dependency)", async () => {
    const { default: MultiEmail } = await import("./MultiEmail");

    renderToString(
      <MultiEmail
        value={["test@example.com"]}
        readOnly={false}
        label="Email"
        setValue={() => {}}
      />
    );

    expect(ui.Button).not.toHaveBeenCalled();
    expect(ui.EmailField).not.toHaveBeenCalled();
    expect(ui.Icon).not.toHaveBeenCalled();
    expect(ui.Tooltip).not.toHaveBeenCalled();
  });
});
