import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { describe, it, expect } from "vitest";

describe("MultiEmail module", () => {
  it("does not import from the @calcom/ui barrel to avoid a circular dependency", async () => {
    // Read the real source file to check its import statements.
    const source = readFileSync(
      fileURLToPath(new URL("./MultiEmail.tsx", import.meta.url)),
      "utf-8"
    );

    // The claimed defect: leaf module imports its own package barrel.
    expect(source).not.toMatch(/from\s+["']@calcom\/ui["']/);

    // Also execute the real module path to ensure it loads without errors.
    const mod = await import("./MultiEmail");
    expect(mod).toHaveProperty("default");
    expect(typeof mod.default).toBe("function");
  });
});
