// @vitest-environment jsdom
import React from "react";
import { render } from "@testing-library/react";
import { describe, it, expect, vi } from "vitest";

vi.mock("@calcom/lib/hooks/useLocale", () => ({
  useLocale: () => ({ t: (key: string) => key }),
}));

vi.mock("@calcom/ui", () => ({
  Button: ({ children, ...props }: any) => <button {...props}>{children}</button>,
  EmailField: ({ label, ...props }: any) => <input data-testid="email-field" {...props} />,
  Icon: () => <span data-testid="icon" />,
  Tooltip: ({ children }: any) => <>{children}</>,
}));

import MultiEmail from "./MultiEmail";

describe("MultiEmail label association", () => {
  it("label htmlFor points to an existing control with matching id", () => {
    const { container } = render(
      <MultiEmail
        value={["test@example.com"]}
        readOnly={false}
        label="Emails"
        setValue={() => {}}
      />
    );

    const label = container.querySelector("label");
    expect(label, "Expected a <label> element to be rendered").not.toBeNull();

    const htmlFor = label!.getAttribute("htmlFor");
    expect(htmlFor, "Expected label to have an htmlFor attribute").toBeTruthy();

    const control = container.querySelector(`#${htmlFor}`);
    expect(
      control,
      `Expected an element with id="${htmlFor}" to exist for label association`
    ).not.toBeNull();
  });
});
