@@ -0,0 +1,106 @@
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, beforeEach, expect } from "vitest";
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: vi.fn().mockImplementation(() => ({
+    updateCalendarAttendees: vi.fn().mockResolvedValue(undefined),
+  })),
+}));
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn().mockResolvedValue(undefined),
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockResolvedValue((k: string) => k),
+}));
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn().mockReturnValue(undefined),
+}));
+
+describe("addGuestsHandler seat capacity enforcement", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    delete process.env.BLACKLISTED_GUEST_EMAILS;
+  });
+
+  it("rejects adding guests that exceed seatsPerTimeSlot for seated events", async () => {
+    const { addGuestsHandler } = await import("./addGuests.handler");
+
+    const existingAttendees = [
+      { email: "existing1@example.com" },
+      { email: "existing2@example.com" },
+    ];
+
+    const booking = {
+      id: 1,
+      userId: 100,
+      title: "Seated event",
+      description: "",
+      location: null,
+      uid: "booking-uid",
+      startTime: new Date(),
+      endTime: new Date(Date.now() + 3600_000),
+      userPrimaryEmail: "organizer@example.com",
+      destinationCalendar: null,
+      references: [],
+      attendees: existingAttendees,
+      user: { destinationCalendar: null, credentials: [] },
+      eventType: {
+        title: "Seated event",
+        seatsPerTimeSlot: 2,
+        seatsShowAttendees: true,
+        recurringEvent: null,
+        teamId: null,
+      },
+    };
+
+    prismaMock.booking.findFirst.mockResolvedValue(booking as any);
+    prismaMock.user.findFirstOrThrow.mockResolvedValue({
+      name: "Organizer",
+      email: "organizer@example.com",
+      timeZone: "UTC",
+      locale: "en",
+    } as any);
+    prismaMock.booking.update.mockResolvedValue({
+      ...booking,
+      attendees: [...existingAttendees, { email: "newguest@example.com" }],
+    } as any);
+
+    const user = {
+      id: 100,
+      email: "organizer@example.com",
+      name: "Organizer",
+      username: "organizer",
+      timeZone: "UTC",
+      locale: "en",
+    } as any;
+
+    let resolvedSuccessfully = false;
+    try {
+      await addGuestsHandler({
+        ctx: { user },
+        input: { bookingId: 1, guests: ["newguest@example.com"] },
+      });
+      resolvedSuccessfully = true;
+    } catch (err) {
+      expect((err as Error).message).toMatch(/seat|capacity/i);
+    }
+
+    expect(
+      resolvedSuccessfully,
+      "Adding guests beyond seatsPerTimeSlot must be rejected, not silently appended"
+    ).toBe(false);
+  });
+});
