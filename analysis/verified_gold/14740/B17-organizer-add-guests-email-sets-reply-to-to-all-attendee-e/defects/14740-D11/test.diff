import { describe, expect, vi, it } from "vitest";

vi.mock("@prisma/extension-accelerate", () => ({}));
vi.mock("@vercel/functions", () => ({}));
vi.mock("@prisma/client", () => ({}));
vi.mock("@calcom/prisma", () => ({}));

vi.mock("../", () => ({
  renderEmail: vi.fn(async () => "<html></html>"),
}));

vi.mock("../lib/generateIcsString", () => ({
  default: vi.fn(() => "BEGIN:VCALENDAR\r\nEND:VCALENDAR"),
}));

describe("OrganizerAddGuestsEmail", () => {
  it("replyTo must not leak attendee emails (organizer only)", async () => {
    const { default: OrganizerAddGuestsEmail } = await import(
      "./organizer-add-guests-email"
    );

    const calEvent: any = {
      organizer: { email: "organizer@example.com", name: "Organizer" },
      attendees: [
        { email: "attendee1@example.com", name: "Attendee One" },
        { email: "attendee2@example.com", name: "Attendee Two" },
        { email: "attendee3@example.com", name: "Attendee Three" },
      ],
      startTime: new Date().toISOString(),
      endTime: new Date(Date.now() + 3600000).toISOString(),
      type: "Test event type",
      title: "Test event",
      uid: "test-uid",
      iCalUID: "test-uid",
    };

    const instance: any = Object.create(OrganizerAddGuestsEmail.prototype);
    Object.assign(instance, {
      calEvent,
      teamMember: undefined,
      t: (key: string) => key,
      getMailerOptions: () => ({ from: "noreply@example.com" }),
      getFormattedDate: () => "Jan 1, 2024",
      getTextBody: () => "text body",
    });

    const payload: any = await (OrganizerAddGuestsEmail.prototype as any)[
      "getNodeMailerPayload"
    ].call(instance);

    // Claim: the Reply-To header must contain only the organizer, not every
    // attendee, to avoid roster leakage and unbounded header growth.
    expect(payload.replyTo).toEqual(["organizer@example.com"]);
  });
});
