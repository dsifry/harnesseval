import { describe, expect, vi } from "vitest";

import { test } from "@calcom/web/test/fixtures/fixtures";

import { buildCalendarEvent, buildPerson } from "../../../lib/test/builder";
import OrganizerAddGuestsEmail from "./organizer-add-guests-email";

vi.mock("../", async () => {
  const actual = await vi.importActual("../");
  return {
    ...actual,
    renderEmail: vi.fn().mockResolvedValue("<html>mocked</html>"),
  };
});

describe("OrganizerAddGuestsEmail", () => {
  test("team-member variant should not leak attendee emails in replyTo and should personalize with team member", async () => {
    const organizer = buildPerson({ email: "organizer@example.com", name: "Organizer" });
    const teamMember = buildPerson({ email: "team@example.com", name: "Team Member" });
    const attendee1 = buildPerson({ email: "attendee1@example.com", name: "Attendee One" });
    const attendee2 = buildPerson({ email: "attendee2@example.com", name: "Attendee Two" });

    const calEvent = buildCalendarEvent({
      organizer,
      attendees: [attendee1, attendee2],
      type: "event type",
    });

    const email = new OrganizerAddGuestsEmail(calEvent, teamMember);
    const payload = await (email as any).getNodeMailerPayload();

    // The replyTo should not include attendee emails; it should only be the organizer or team member
    expect(payload.replyTo).toEqual([organizer.email]);

    // The html should be rendered with the team member as the attendee, not the organizer
    const { renderEmail } = await import("../");
    expect(renderEmail).toHaveBeenCalledWith(
      "OrganizerAddGuestsEmail",
      expect.objectContaining({
        attendee: teamMember,
      })
    );
  });
});