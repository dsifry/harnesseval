import { describe, expect, it, vi } from "vitest";

process.env.NEXT_PUBLIC_WEBAPP_URL = "http://localhost:3000";
process.env.NEXT_PUBLIC_WEBSITE_URL = "http://localhost:3000";
process.env.EMAIL_FROM = "test@example.com";
process.env.EMAIL_SERVER = JSON.stringify({
  host: "localhost",
  port: 1025,
  auth: { user: "user", pass: "pass" },
});

vi.mock("../", async () => {
  const actual = await vi.importActual<any>("../");
  return {
    ...actual,
    renderEmail: vi.fn(async () => "<html>mocked</html>"),
  } as any;
});

describe("OrganizerAddGuestsEmail (team-member variant)", () => {
  it("personalizes content for the team member and does not leak attendee emails via replyTo", async () => {
    const { default: OrganizerAddGuestsEmail } = await import("./organizer-add-guests-email");
    const { buildCalendarEvent, buildPerson } = await import("../../lib/test/builder");
    const { renderEmail } = await import("../");

    const organizer = buildPerson({ email: "organizer@example.com", name: "Organizer Name" });
    const attendeeOne = buildPerson({ email: "attendee.one@example.com", name: "Attendee One" });
    const attendeeTwo = buildPerson({ email: "attendee.two@example.com", name: "Attendee Two" });
    const teamMember = buildPerson({ email: "team.member@example.com", name: "Team Member Name" });

    const calEvent = buildCalendarEvent({
      organizer,
      attendees: [attendeeOne, attendeeTwo],
    });

    const email = new OrganizerAddGuestsEmail(calEvent, teamMember);
    const payload = (await (email as unknown as {
      getNodeMailerPayload(): Promise<Record<string, unknown>>;
    }).getNodeMailerPayload()) as {
      to: string;
      replyTo: string[];
    };

    expect(payload.to).toBe("team.member@example.com");

    expect(payload.replyTo).not.toContain("attendee.one@example.com");
    expect(payload.replyTo).not.toContain("attendee.two@example.com");
    expect(payload.replyTo).toEqual(["team.member@example.com"]);

    const renderEmailMock = renderEmail as unknown as ReturnType<typeof vi.fn>;
    renderEmailMock.mockClear();

    await (email as unknown as {
      getNodeMailerPayload(): Promise<Record<string, unknown>>;
    }).getNodeMailerPayload();

    expect(renderEmailMock).toHaveBeenCalledWith(
      "OrganizerAddGuestsEmail",
      expect.objectContaining({
        attendee: expect.objectContaining({ email: "team.member@example.com" }),
      })
    );
  });
});