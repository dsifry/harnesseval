--- /dev/null
+++ b/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts
@@ -0,0 +1,94 @@
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, beforeEach, expect } from "vitest";
+
+vi.mock("@calcom/dayjs", () => ({
+  default: () => ({ format: () => "2024-01-01T00:00:00Z" }),
+}));
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn().mockReturnValue(null),
+}));
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: vi.fn().mockImplementation(() => ({
+    updateCalendarAttendees: vi.fn().mockResolvedValue(undefined),
+  })),
+}));
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn(),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockImplementation(async () => (key: string) => key),
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+describe("addGuestsHandler — email delivery failure handling", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+
+    prismaMock.booking.findFirst.mockResolvedValue({
+      id: 1,
+      userId: 10,
+      uid: "uid-1",
+      title: "Test booking",
+      description: "",
+      startTime: new Date(),
+      endTime: new Date(),
+      location: null,
+      userPrimaryEmail: "org@test.com",
+      attendees: [],
+      eventType: null,
+      destinationCalendar: null,
+      references: [],
+      user: { destinationCalendar: null, credentials: [] },
+    } as never);
+
+    prismaMock.user.findFirstOrThrow.mockResolvedValue({
+      name: "Org",
+      email: "org@test.com",
+      timeZone: "UTC",
+      locale: "en",
+    } as never);
+
+    prismaMock.booking.update.mockResolvedValue({
+      id: 1,
+      attendees: [
+        { name: "", email: "newguest@test.com", timeZone: "UTC", locale: "en" },
+      ],
+    } as never);
+  });
+
+  it("propagates email send failure instead of silently returning success", async () => {
+    const { sendAddGuestsEmails } = await import("@calcom/emails");
+    (sendAddGuestsEmails as unknown as ReturnType<typeof vi.fn>).mockRejectedValue(
+      new Error("SMTP down")
+    );
+
+    const { addGuestsHandler } = await import("./addGuests.handler");
+
+    await expect(
+      addGuestsHandler({
+        ctx: {
+          user: {
+            id: 10,
+            email: "org@test.com",
+            timeZone: "UTC",
+            locale: "en",
+          },
+        } as never,
+        input: { bookingId: 1, guests: ["newguest@test.com"] } as never,
+      })
+    ).rejects.toThrow(/SMTP down/);
+  });
+});
