import { describe, expect, it } from "vitest";

import { ZAddGuestsInputSchema } from "./addGuests.schema";

describe("addGuests input schema guest fan-out bound", () => {
  it("rejects a payload with more than 1000 guests to prevent unbounded email/DB/calendar fan-out", () => {
    const guests = Array.from({ length: 1001 }, (_, i) => `guest${i}@example.com`);

    const result = ZAddGuestsInputSchema.safeParse({
      bookingId: 1,
      guests,
    });

    expect(
      result.success,
      "guests array has no max() constraint; a single mutation can fan out thousands of attendees"
    ).toBe(false);
  });
});
