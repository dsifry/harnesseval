import { describe, it, expect } from "vitest";

/**
 * Regression evidence for the claim that the addGuests schema permits an
 * unbounded guest list and an empty guest list, which combined with the
 * handler's missing organizer/admin check allows any booking attendee to
 * inject arbitrary emails into the organizer's calendar.
 *
 * The schema is the real, post-PR module (no mocks). On the current code
 * ZAddGuestsInputSchema accepts any number of guests (including zero) and
 * therefore these assertions fail.
 */
describe("addGuests.schema bounds/authorization", () => {
  it("rejects a guest list with an unbounded number of emails (no per-booking cap)", async () => {
    const { ZAddGuestsInputSchema } = await import("./addGuests.schema");

    // Simulates an attendee spamming the organizer's calendar/emails.
    const guests = Array.from({ length: 500 }, (_, i) => `attacker-guest-${i}@evil.example.com`);

    const result = ZAddGuestsInputSchema.safeParse({ bookingId: 1, guests });

    // Claimed behavior: the schema must cap the number of guests an
    // attendee can add. Current code has no `.max(...)` and returns success.
    expect(result.success).toBe(false);
  });

  it("rejects an empty guest list", async () => {
    const { ZAddGuestsInputSchema } = await import("./addGuests.schema");

    const result = ZAddGuestsInputSchema.safeParse({ bookingId: 1, guests: [] });

    // Claimed behavior: an empty request is not a valid guest-add payload.
    expect(result.success).toBe(false);
  });
});
