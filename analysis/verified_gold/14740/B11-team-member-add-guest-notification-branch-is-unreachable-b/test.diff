new file mode 100644
--- /dev/null
+++ b/packages/emails/email-manager.verified.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, vi } from "vitest";
+
+// Capture constructor arguments for the templates used by sendAddGuestsEmails.
+const organizerAddGuestsArgs: any[] = [];
+const attendeeAddGuestsArgs: any[] = [];
+
+vi.mock("./templates/organizer-add-guests-email", () => ({
+  default: class MockOrganizerAddGuestsEmail {
+    sendEmail = vi.fn().mockResolvedValue(undefined);
+    constructor(args: any) {
+      organizerAddGuestsArgs.push(args);
+    }
+  },
+}));
+
+vi.mock("./templates/attendee-add-guests-email", () => ({
+  default: class MockAttendeeAddGuestsEmail {
+    sendEmail = vi.fn().mockResolvedValue(undefined);
+    constructor(...args: any[]) {
+      attendeeAddGuestsArgs.push(args);
+    }
+  },
+}));
+
+vi.mock("./templates/attendee-scheduled-email", () => ({
+  default: class MockAttendeeScheduledEmail {
+    sendEmail = vi.fn().mockResolvedValue(undefined);
+    constructor(_args: any) {}
+  },
+}));
+
+describe("sendAddGuestsEmails (team-member notification)", () => {
+  test("notifies each team member when the booking belongs to a team", async () => {
+    const { sendAddGuestsEmails } = await import("./email-manager");
+
+    const teamMember = { name: "Team Member", email: "team-member@example.com" };
+
+    const calEvent = {
+      type: "team",
+      title: "Team Booking",
+      startTime: new Date().toISOString(),
+      endTime: new Date(Date.now() + 60 * 60 * 1000).toISOString(),
+      attendees: [
+        {
+          name: "Attendee",
+          email: "attendee@example.com",
+          timeZone: "UTC",
+          language: { locale: "en" },
+        },
+      ],
+      organizer: { name: "Organizer", email: "organizer@example.com" },
+      team: { members: [{ ...teamMember }] },
+      iCalUID: "verified-test-uid",
+    } as any;
+
+    await sendAddGuestsEmails(calEvent, []);
+
+    const teamMemberCall = organizerAddGuestsArgs.find(
+      (args) => args && args.teamMember && args.teamMember.email === teamMember.email
+    );
+
+    expect(
+      teamMemberCall,
+      "expected sendAddGuestsEmails to send OrganizerAddGuestsEmail to each team member, but the constructed CalendarEvent omitted team so the team-member branch never ran"
+    ).toBeDefined();
+  });
+});
