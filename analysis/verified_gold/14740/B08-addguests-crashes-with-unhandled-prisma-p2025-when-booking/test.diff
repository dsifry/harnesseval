diff --git a/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts b/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/trpc/server/routers/viewer/bookings/addGuests.handler.verified.test.ts
@@ -0,0 +1,70 @@
+import prismaMock from "../../../../../../tests/libs/__mocks__/prismaMock";
+
+import { vi, describe, it, beforeEach, expect } from "vitest";
+import { TRPCError } from "@trpc/server";
+
+vi.mock("@calcom/prisma", () => ({ prisma: prismaMock }));
+
+vi.mock("@calcom/lib/server/queries/teams", () => ({
+  isTeamAdmin: vi.fn().mockResolvedValue(false),
+  isTeamOwner: vi.fn().mockResolvedValue(false),
+}));
+
+vi.mock("@calcom/lib/server/getUsersCredentials", () => ({
+  getUsersCredentials: vi.fn().mockResolvedValue([]),
+}));
+
+vi.mock("@calcom/emails", () => ({
+  sendAddGuestsEmails: vi.fn().mockResolvedValue(undefined),
+}));
+
+vi.mock("@calcom/core/EventManager", () => ({
+  default: vi.fn().mockImplementation(() => ({
+    updateCalendarAttendees: vi.fn().mockResolvedValue(undefined),
+  })),
+}));
+
+vi.mock("@calcom/lib", () => ({
+  parseRecurringEvent: vi.fn(),
+}));
+
+vi.mock("@calcom/lib/server", () => ({
+  getTranslation: vi.fn().mockResolvedValue((key: string) => key),
+}));
+
+describe("addGuestsHandler", () => {
+  beforeEach(() => {
+    prismaMock.booking.findFirst.mockReset();
+    prismaMock.user.findFirstOrThrow.mockReset();
+
+    // Booking exists but has no associated user (userId is null)
+    prismaMock.booking.findFirst.mockResolvedValue({
+      id: 1,
+      userId: null,
+      attendees: [{ email: "attendee@example.com" }],
+      eventType: { teamId: null },
+      references: [],
+    });
+
+    // Simulate Prisma P2025: record not found
+    prismaMock.user.findFirstOrThrow.mockRejectedValue(
+      new Error(
+        "An operation failed because it depends on one or more records that were required but not found. No 'User' record was found for a query."
+      )
+    );
+  });
+
+  it("should throw a TRPCError instead of an unhandled Prisma error when booking.userId is null", async () => {
+    const { addGuestsHandler } = await import("./addGuests.handler");
+
+    const ctx = {
+      user: {
+        id: 99,
+        email: "attendee@example.com",
+      },
+    };
+    const input = { bookingId: 1, guests: ["newguest@example.com"] };
+
+    await expect(addGuestsHandler({ ctx, input } as any)).rejects.toBeInstanceOf(TRPCError);
+  });
+});
