--- /dev/null
+++ b/spec/verify/groups_controller_spec_verify.rb
@@ -0,0 +1,55 @@
+# Standalone regression evidence for hardcoded automatic-group ids in the
+# Admin::GroupsController spec. Loads the REAL spec file with a minimal RSpec
+# shim (no Rails, no DB) and inspects each example body for hardcoded ids.
+
+SPEC_PATH = File.expand_path('spec/controllers/admin/groups_controller_spec.rb', Dir.pwd)
+
+# Neuter spec_helper so the real spec file can be required standalone.
+def require(path)
+  return false if ['spec_helper', 'spec_helper.rb'].include?(path)
+  super
+end
+
+# Constants referenced at describe-time by the real spec file.
+module Admin
+  class AdminController; end
+  class GroupsController < AdminController; end
+end
+
+# Minimal RSpec DSL: record each example's description + source location.
+$verify_examples = []
+
+def describe(_name, &blk); blk.call; end
+def context(_name, &blk);  blk.call; end
+def before(&_blk); end
+def it(name, &blk); $verify_examples << [name, blk.source_location]; end
+
+require SPEC_PATH
+
+# Extract the full text of an `it` block (it lives at 4-space indent,
+# closing `end` likewise at 4-space indent).
+def example_body(file, start_line)
+  lines = File.readlines(file)
+  body  = []
+  i = start_line - 1
+  while i < lines.size
+    body << lines[i]
+    break if i > start_line - 1 && lines[i] =~ /^\s{4}end\s*$/
+    i += 1
+  end
+  body.join
+end
+
+# Presence of a literal group id of 1 (either param or AR lookup).
+HARDCODED_ID = /\b(?:id|group_id)\s*:\s*1\b|Group\.find\(\s*1\s*\)/
+
+offenders = $verify_examples.select do |(_name, (file, line))|
+  example_body(file, line) =~ HARDCODED_ID
+end
+
+if offenders.empty?
+  puts 'RESULT: PASS'
+else
+  names = offenders.map { |(n, (_f, l))| "#{n.inspect} (line #{l})" }.join('; ')
+  puts "RESULT: FAIL: hardcoded automatic-group id used instead of Fabricate: #{names}"
+end
