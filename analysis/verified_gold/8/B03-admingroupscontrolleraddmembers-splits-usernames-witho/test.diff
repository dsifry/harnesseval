--- /dev/null
+++ b/spec/verify/groups_controller_verify.rb
@@ -0,0 +1,106 @@
+# Minimal standalone harness for Admin::GroupsController#add_members regression.
+# No Rails app, no database.
+
+# --- Stubs -------------------------------------------------------------
+module ActiveRecord
+  class Base; end
+end
+
+module I18n
+  def self.t(key, _opts = {})
+    key.to_s
+  end
+end
+
+class FakeParams
+  def initialize(hash)
+    @hash = hash
+  end
+
+  def [](key)
+    @hash[key]
+  end
+
+  def require(key)
+    raise "missing param #{key}" unless @hash.key?(key)
+    @hash[key]
+  end
+end
+
+class Group < ActiveRecord::Base
+  attr_accessor :automatic, :name, :added
+
+  def initialize
+    @automatic = false
+    @added = []
+  end
+
+  def users
+    @users ||= []
+  end
+
+  def add(user)
+    @added << user
+  end
+
+  def save
+    true
+  end
+
+  def self.find(_id)
+    @@instance ||= new
+  end
+
+  def self.reset!
+    @@instance = nil
+  end
+
+  def self.order(*); self; end
+  def self.where(*); self; end
+  def self.refresh_automatic_groups!; end
+end
+
+class User < ActiveRecord::Base
+  REGISTRY = { 'bob' => :bob_user, 'alice' => :alice_user }.freeze
+
+  def self.find_by_username(name)
+    REGISTRY[name]
+  end
+end
+
+module Admin
+  class AdminController
+    attr_accessor :params
+    attr_reader :rendered
+
+    def render(*args)
+      @rendered = args
+    end
+
+    def render_serialized(*); end
+    def render_json_error(*); end
+
+    def success_json
+      { success: true }
+    end
+  end
+end
+
+require_relative '../../app/controllers/admin/groups_controller'
+
+Group.reset!
+group = Group.find(1)
+group.automatic = false
+
+controller = Admin::GroupsController.new
+controller.params = FakeParams.new({ group_id: 1, usernames: 'bob, alice' })
+controller.add_members
+
+added = group.added
+expected = %i[bob_user alice_user]
+
+if added == expected
+  puts 'RESULT: PASS'
+else
+  puts "RESULT: FAIL: add_members did not strip usernames; added=#{added.inspect} (expected #{expected.inspect}); space-prefixed username silently skipped while action still returned success (#{controller.rendered.inspect})"
+end
