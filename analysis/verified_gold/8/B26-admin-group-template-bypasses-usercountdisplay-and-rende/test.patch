#!/usr/bin/env ruby
# frozen_string_literal: true

# Standalone regression test for the claimed defect in
# app/assets/javascripts/admin/templates/group.hbs
#
# Claim: The admin group template renders raw {{user_count}} instead of
# using the userCountDisplay presentation helper (which hides zero).
#
# This script reads the real template file and checks for the defect.
# It does not require Rails, a database, or any other application code.

require 'pathname'

# Locate the template file relative to the repository root.
# The script is expected to be run from the repo root, but we compute
# the path relative to this file to be robust.
repo_root = Pathname.new(__dir__).parent.parent
template_rel = Pathname.new('app/assets/javascripts/admin/templates/group.hbs')
template_path = repo_root + template_rel

# Fallback: if not found relative to the script, try relative to CWD.
template_path = Pathname.new(Dir.pwd) + template_rel unless template_path.exist?

unless template_path.exist?
  puts "RESULT: FAIL: Could not find template at #{template_path}"
  exit 1
end

source = template_path.read

# The defect pattern: raw {{user_count}} (possibly wrapped in parentheses)
# in the template, instead of using the userCountDisplay helper.
# The claim specifically mentions line ~14 rendering "({{user_count}})".
defect_pattern = /\{\{\s*user_count\s*\}\}/

if source.match?(defect_pattern)
  puts "RESULT: FAIL: Template renders raw {{user_count}} instead of " \
       "using userCountDisplay presentation logic"
  exit 1
elsif !source.match?(/userCountDisplay/i)
  puts "RESULT: FAIL: Template does not use userCountDisplay presentation logic"
  exit 1
else
  puts "RESULT: PASS"
  exit 0
end
