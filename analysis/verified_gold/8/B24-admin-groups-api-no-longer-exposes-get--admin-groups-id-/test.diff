+# spec/verify/routes_verify.rb
+# Standalone regression check for config/routes.rb (no Rails app, no DB).
+# Loads the REAL config/routes.rb with a minimal routing-DSL stub, then asserts
+# that GET /admin/groups/:id/users is still exposed.
+
+module Kernel
+  alias_method :__orig_require_for_routes_verify, :require
+  def require(name)
+    return true if name == "sidekiq/web"
+    __orig_require_for_routes_verify(name)
+  end
+end
+
+def require_dependency(_name); end
+
+class AdminConstraint; end
+class StaffConstraint; end
+class HomepageConstraint; end
+class PermalinkConstraint; end
+
+module Sidekiq; Web = Object.new; end
+module Logster; Web = Object.new; end
+
+module Rails
+  class Env
+    def development?; false; end
+  end
+  def self.env; @env ||= Env.new; end
+end
+
+module RoutePathExtract
+  def extract_path(args)
+    args.each do |a|
+      case a
+      when String
+        return a.sub(%r{\A/}, "")
+      when Hash
+        k = a.keys.find { |x| x.is_a?(String) }
+        return k.sub(%r{\A/}, "") if k
+      end
+    end
+    nil
+  end
+end
+
+class RouteRecorder
+  include RoutePathExtract
+  attr_reader :routes
+  def initialize; @routes = []; end
+  def add(verb, path); @routes << [verb, path]; end
+  def draw; yield Mapper.new(self, []); end
+end
+
+class Mapper
+  include RoutePathExtract
+  def initialize(rec, prefix); @rec = rec; @prefix = prefix; end
+
+  def get(*a);    emit("GET", a);    end
+  def post(*a);   emit("POST", a);   end
+  def put(*a);    emit("PUT", a);    end
+  def delete(*a); emit("DELETE", a); end
+  def match(*a); end
+  def mount(*a); end
+
+  def namespace(name, *rest, &blk)
+    Mapper.new(@rec, @prefix + [name.to_s]).instance_eval(&blk)
+  end
+
+  def scope(path, *rest, &blk)
+    seg = path.to_s.sub(%r{\A/}, "")
+    Mapper.new(@rec, @prefix + [seg]).instance_eval(&blk)
+  end
+
+  def resources(name, *rest, &blk)
+    base = @prefix + [name.to_s]
+    ResourceScope.new(@rec, base).instance_eval(&blk) if blk
+  end
+
+  private
+
+  def emit(verb, args)
+    p = extract_path(args)
+    return if p.nil?
+    @rec.add(verb, (@prefix + [p]).join("/"))
+  end
+end
+
+class ResourceScope
+  include RoutePathExtract
+  def initialize(rec, base); @rec = rec; @base = base; end
+
+  def collection(&blk); Mapper.new(@rec, @base).instance_eval(&blk);        end
+  def member(&blk);     Mapper.new(@rec, @base + [":id"]).instance_eval(&blk); end
+
+  def get(*a);    emit("GET", a);    end
+  def post(*a);   emit("POST", a);   end
+  def put(*a);    emit("PUT", a);    end
+  def delete(*a); emit("DELETE", a); end
+
+  private
+
+  def emit(verb, args)
+    p = extract_path(args)
+    return if p.nil?
+    @rec.add(verb, (@base + [":id", p]).join("/"))
+  end
+end
+
+module Discourse
+  class Application
+    def self.routes; @routes ||= RouteRecorder.new; end
+  end
+end
+
+begin
+  require_relative "../../config/routes.rb"
+rescue Exception => e
+  puts "RESULT: FAIL: could not load config/routes.rb: #{e.class}: #{e.message}"
+  exit 0
+end
+
+routes = Discourse::Application.routes.routes
+target = ["GET", "admin/groups/:id/users"]
+
+puts "recorded admin/groups GET/PUT/DELETE routes: #{routes.select { |v, p| p.start_with?('admin/groups') }.inspect}" if ENV["DEBUG_ROUTES"]
+
+if routes.include?(target)
+  puts "RESULT: PASS"
+else
+  puts "RESULT: FAIL: GET /admin/groups/:id/users is not defined (removed with no read replacement)"
+end
