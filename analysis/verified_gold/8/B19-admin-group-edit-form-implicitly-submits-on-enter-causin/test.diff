diff --git a/spec/verify/group_verify.rb b/spec/verify/group_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/group_verify.rb
@@ -0,0 +1,65 @@
+# Standalone regression evidence for the claimed admin group form defect.
+# Run from repo root: ruby -I. spec/verify/group_verify.rb
+#
+# We must exercise the REAL artifact, not a redefined copy.
+
+rel = "app/assets/javascripts/admin/templates/group.hbs"
+path = File.expand_path(rel, Dir.pwd)
+
+unless File.exist?(path)
+  puts "RESULT: FAIL: real file missing at #{path}"
+  exit 0
+end
+
+src = File.read(path)
+
+# Grab the outer <form ...> ... </form> block (the new wrapper).
+form_match = src.match(%r{<form\b[^>]*>(.*?)</form>}m)
+unless form_match
+  puts "RESULT: FAIL: no <form> wrapper found in #{rel}"
+  exit 0
+end
+
+form_open = form_match[0][0, form_match[0].index('>') + 1]
+form_body = form_match[1]
+
+# Collect all <button ...> tags inside the form wrapper.
+buttons = form_body.scan(%r{<button\b[^>]*>}m)
+
+# A native-submission-safe button must declare type="button" explicitly.
+safe_buttons = buttons.select { |b| b =~ /type\s*=\s*["']button["']/i }
+
+# A form-level submit handler could also neutralize the native submit.
+has_form_submit_handler =
+  form_open =~ /onsubmit\s*=/i ||
+  src =~ /<form\b[^>]*\{\{action\s+["'][^"']*submit/i ||
+  src =~ /submit\s*=\s*\{\{action/i
+
+# The claim specifically covers these two inputs being wrapped by the form.
+wraps_name_input = form_body =~ /\{\{text-field\s+name=["']name["']/ ||
+                    form_body =~ /name=["']name["']/
+wraps_user_selector = form_body =~ /\{\{user-selector\b[^}]*\}\}/ ||
+                       form_body =~ /id=["']user-selector["']/
+
+puts "file: #{rel}"
+puts "form tag: #{form_open.strip}"
+puts "buttons inside form: #{buttons.length}"
+puts "buttons with type=\"button\": #{safe_buttons.length}"
+puts "form submit handler present: #{has_form_submit_handler}"
+puts "form wraps name input: #{!!wraps_name_input}"
+puts "form wraps user-selector: #{!!wraps_user_selector}"
+
+# Defect is present when the form wraps the text inputs, none of its buttons
+# opt out of native submission, and no handler intercepts assigness submit.
+defect = wraps_name_input && wraps_user_selector &&
+         safe_buttons.empty? && buttons.any? && !has_form_submit_handler
+
+if defect
+  reason = "buttons inside <form class=\"form-horizontal\"> lack type=\"button\" " \
+           "(#{buttons.length} button(s), 0 with type=\"button\") and the form has no submit " \
+           "handler, so pressing Enter in the group-name or user-selector input triggers native " \
+           "form submission to the current URL -> full page reload discards unsaved edits"
+  puts "RESULT: FAIL: #{reason}"
+else
+  puts "RESULT: PASS"
+end
