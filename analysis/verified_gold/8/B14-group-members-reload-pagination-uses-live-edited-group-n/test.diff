diff --git a/spec/verify/group_verify.rb b/spec/verify/group_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/group_verify.rb
@@ -0,0 +1,56 @@
+# frozen_string_literal: false
+require 'json'
+
+src_path = File.expand_path('app/assets/javascripts/discourse/models/group.js', Dir.pwd)
+unless File.file?(src_path)
+  puts "RESULT: FAIL: missing #{src_path}"
+  exit 1
+end
+src = File.read(src_path)
+
+# Pull the findMembers body out of the real JS file
+fm_body = src[/findMembers\s*:\s*function\s*\([^)]*\)\s*\{(.*?)\n\s{2}\}/m, 1]
+if fm_body.nil?
+  puts "RESULT: FAIL: could not parse findMembers from #{src_path}"
+  exit 1
+end
+
+# The URL expression passed to Discourse.ajax inside findMembers
+url_expr = fm_body[/Discourse\.ajax\(\s*(.+?)\s*,\s*\{/m, 1]
+if url_expr.nil?
+  puts "RESULT: FAIL: could not locate ajax url expression in findMembers"
+  exit 1
+end
+
+# Model the live-edited, two-way-bound name field vs. the persisted identity
+live_name  = 'renamed-not-yet-saved'
+saved_name = 'original-name'
+group_id   = 42
+
+# Replicate the JS string concatenation in Ruby
+demo = url_expr.dup
+demo = demo.gsub("this.get('name')", "'#{live_name}'")
+demo = demo.gsub("this.get('id')", group_id.to_s)
+requested_url = eval(demo) # rubocop:disable Security/Eval
+
+expected_id_url   = "/groups/#{group_id}/members.json"
+expected_name_url = "/groups/#{saved_name}/members.json"
+
+# Contrast: the mutating calls themselves use the immutable id
+remove_url = src[/removeMember\s*:\s*function[^{]*\{(.*?)\n\s{2}\}/m, 1].to_s[/Discourse\.ajax\(\s*(.+?)\s*,\s*\{/m, 1].to_s
+add_url    = src[/addMembers\s*:\s*function[^{]*\{(.*?)\n\s{2}\}/m, 1].to_s[/Discourse\.ajax\(\s*(.+?)\s*,\s*\{/m, 1].to_s
+
+if requested_url.include?(live_name)
+  puts "RESULT: FAIL: findMembers builds the members URL from the two-way-bound live " \
+       "name property; after an unsaved rename it requests #{requested_url.inspect} " \
+       "(should key off #{expected_id_url.inspect} or #{expected_name_url.inspect}). " \
+       "removeMember uses #{remove_url.inspect}, addMembers uses #{add_url.inspect}."
+  exit 1
+end
+
+if requested_url != expected_id_url && requested_url != expected_name_url
+  puts "RESULT: FAIL: findMembers produced unexpected URL #{requested_url.inspect}"
+  exit 1
+end
+
+puts "RESULT: PASS"
