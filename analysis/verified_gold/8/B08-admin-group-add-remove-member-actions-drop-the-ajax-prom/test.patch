#!/usr/bin/env ruby
# Standalone regression evidence for app/assets/javascripts/admin/controllers/admin-group.js.es6
# and app/assets/javascripts/discourse/models/group.js.
#
# MRI Ruby cannot `require` an ES6 source file, so the REAL file is loaded from its
# real relative path and asserted against for the observable promise-handling defect.
require 'json'

ROOT = Dir.pwd
def load_real(rel)
  p = File.expand_path(rel, ROOT)
  abort("missing real file: #{p}") unless File.exist?(p)
  File.read(p)
end

controller = load_real('app/assets/javascripts/admin/controllers/admin-group.js.es6')
model      = load_real('app/assets/javascripts/discourse/models/group.js')

reasons = []

# --- controller: removeMember action (claim line ~56) ---
rm = controller[/removeMember:\s*function\s*\(member\)\s*\{(.*?)\n    \},/m, 1]
if rm.nil?
  reasons << 'could not locate removeMember action in admin-group.js.es6'
else
  returned = rm =~ /return\s+self\.get\("model"\)\.removeMember\(member\)/
  chained  = rm =~ /self\.get\("model"\)\.removeMember\(member\)[\s\S]{0,40}\.then/
  unless returned || chained
    reasons << 'admin-group removeMember discards the model.removeMember promise (not returned / not chained) - failed removals unhandled, stale UI'
  end
  if rm !~ /\.catch\s*\(|\.fail\s*\(/
    reasons << 'admin-group removeMember attaches no .catch/.fail rejection handler'
  end
end

# --- controller: addMembers action ---
am = controller[/addMembers:\s*function\s*\(\)\s*\{(.*?)\n    \},/m, 1]
if am && am !~ /return\s+this\.get\("model"\)\.addMembers/
  reasons << 'admin-group addMembers discards the model.addMembers promise (not returned / not chained)'
end

# --- model: detached findmembers() reload promise ---
model.scan(/findmembers\s*\(/) do |_|
  m = Regexp.last_match
  pre = model[[m.begin(0) - 90, 0].max...m.begin(0)]
  unless pre =~ /return\s+[\w\.]*\s*$/
    reasons << 'group.js findmembers() reload promise is not returned from the mutation chain (detached); failed refresh resolves as success'
    break
  end
end

# --- model: unhandled rejection on add/remove members (e.g. 422 automatic group) ---
model.scan(/(?:addmembers|removemember|addMembers|removeMember)\s*:\s*function/m) do |_|
  m = Regexp.last_match
  tail = model[m.begin(0)...(m.begin(0) + 1200)] || ''
  unless tail =~ /\.catch\s*\(|\.fail\s*\(/
    reasons << 'group.js addMembers/removeMember have no .catch/.fail rejection handler (422 leaves promise unhandled, no UI feedback)'
    break
  end
end

reasons.uniq!
if reasons.empty?
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: #{reasons.join('; ')}"
end
