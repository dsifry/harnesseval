diff --git a/spec/verify/admin-group.js_verify.rb b/spec/verify/admin-group.js_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/admin-group.js_verify.rb
@@ -0,0 +1,34 @@
+# frozen_string_literal: true
+# Static structural verification of the real ES6 file.
+# We cannot execute ES6 in plain Ruby without a JS runtime, so we
+# inspect the actual source to confirm whether the claimed defect
+# (discarded promises) is present.
+
+path = File.expand_path('../../app/assets/javascripts/admin/controllers/admin-group.js.es6', __dir__)
+unless File.exist?(path)
+  path = File.expand_path('app/assets/javascripts/admin/controllers/admin-group.js.es6', Dir.pwd)
+end
+raise "real file not found at #{path}" unless File.exist?(path)
+
+source = File.read(path)
+
+defect = false
+reasons = []
+
+# Claimed defect: removeMember does not return the model's removeMember promise.
+unless source.include?('return self.get("model").removeMember(member)')
+  defect = true
+  reasons << "removeMember action discards the model delete promise (missing `return`)"
+end
+
+# Claimed defect: addMembers does not return the model's addMembers promise.
+unless source.include?('return this.get("model").addMembers(')
+  defect = true
+  reasons << "addMembers action discards the model add promise (missing `return`)"
+end
+
+if defect
+  puts "RESULT: FAIL: #{reasons.join('; ')}"
+else
+  puts "RESULT: PASS"
+end
