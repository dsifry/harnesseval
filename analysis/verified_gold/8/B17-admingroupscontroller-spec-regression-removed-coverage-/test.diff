diff --git a/spec/verify/groups_controller_spec_verify.rb b/spec/verify/groups_controller_spec_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/groups_controller_spec_verify.rb
@@ -0,0 +1,44 @@
+require 'json'
+
+SPEC_PATH = File.expand_path('../../controllers/admin/groups_controller_spec.rb', __FILE__)
+
+unless File.exist?(SPEC_PATH)
+  puts "RESULT: FAIL: spec file not found at #{SPEC_PATH}"
+  exit
+end
+
+src = File.read(SPEC_PATH)
+
+missing = []
+
+# 1. Paginated members response meta shape (total/limit/offset) that the client pager depends on
+unless src =~ /meta/ && src =~ /total/ && src =~ /limit/ && src =~ /offset/
+  missing << 'paginated members meta shape (meta.total/limit/offset)'
+end
+
+# 2. Adding non-existent / unknown usernames (silent success branch)
+unless src =~ /non[\s_-]?existent|unknown\s+user|non[\s_-]?existing/i
+  missing << 'adding non-existent/unknown usernames'
+end
+
+# 3. Removing a non-member (silent success branch)
+unless src =~ /non[\s_-]?member|not\s+a\s+member/i
+  missing << 'removing a non-member'
+end
+
+# 4. Adding an already-present member
+unless src =~ /already\s+(a\s+)?member|already\s+present/i
+  missing << 'adding an already-present member'
+end
+
+# 5. update changing name/alias_level on non-automatic group
+has_update_context = src =~ /context\s+"\.update"/
+has_auto = src =~ /automatic\s+group/i
+has_alias = src =~ /alias_level/i
+missing << 'update name/alias_level on non-automatic group' unless has_update_context && has_auto && has_alias
+
+if missing.empty?
+  puts 'RESULT: PASS'
+else
+  puts "RESULT: FAIL: #{missing.join('; ')}"
+end
