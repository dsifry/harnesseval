+  end
+
+end
+
+describe GroupsController do
+
+  before do
+    log_in(:admin)
+  end
+
+  context ".members" do
+
+    it "includes pagination meta data" do
+      group = Fabricate(:group)
+      user = Fabricate(:user)
+      group.add(user)
