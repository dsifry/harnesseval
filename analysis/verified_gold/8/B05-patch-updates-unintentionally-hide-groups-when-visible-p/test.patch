require 'app/controllers/admin/groups_controller'

# ---------------------------------------------------------------------------
# Claim: PATCH /admin/groups/:id sets visible=false when the `visible` param
# is omitted, unintentionally hiding the group during a partial update.
# Correct behaviour: omitting `visible` must leave visibility untouched.
# ---------------------------------------------------------------------------
group = Group.new(id: 1, name: 'team', visible: true, automatic: false, alias_level: 0)
STORE[1] = group

controller = Admin::GroupsController.new
controller.params = { id: '1', name: 'team-renamed' }

controller.update

if group.visible == true
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: update with visible omitted set visible=#{group.visible.inspect} (expected true)"
end
