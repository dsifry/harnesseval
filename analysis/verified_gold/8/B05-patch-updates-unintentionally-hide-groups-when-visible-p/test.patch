require 'ostruct'

module I18n
  def self.t(key, opts = {})
    key.to_s
  end
end

class Object
  def present?
    !nil? && !(respond_to?(:empty?) && empty?)
  end
  def blank?
    !present?
  end
end

class NilClass
  def present?; false; end
  def blank?; true; end
end

class Admin
  class AdminController
    attr_accessor :response_body, :response_status

    def params
      @params ||= {}
    end

    def params=(h)
      @params = h
    end

    def render_json_error(obj)
      self.response_body = { errors: [obj.to_s] }
      self.response_status = 422
    end

    def render_serialized(obj, serializer)
      self.response_body = obj
      self.response_status = 200
    end

    def render(opts = {})
      self.response_body = opts[:json]
      self.response_status = opts[:status] || 200
    end

    def success_json
      { success: :OK }
    end
  end
end

STORE = {}

class Group
  attr_accessor :id, :name, :visible, :automatic, :alias_level

  def initialize(attrs = {})
    attrs.each { |k, v| send("#{k}=", v) }
  end

  def save
    true
  end

  def users
    []
  end

  def self.find(id)
    STORE[id.to_i]
  end

  def self.refresh_automatic_groups!
  end
end

class User
  def self.find_by_username(_name)
    nil
