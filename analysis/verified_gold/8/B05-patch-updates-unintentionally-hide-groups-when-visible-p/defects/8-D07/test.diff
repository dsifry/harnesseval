# --- Load the real file under test ---
require_relative '../../app/controllers/admin/groups_controller.rb'

# --- Exercise the controller ---
$last_saved_group = nil

# Simulate an API consumer sending the established nested envelope:
# POST /admin/groups  params: { group: { name: "my_group", visible: "true" } }
controller = Admin::GroupsController.new({ group: { name: "my_group", visible: "true" } })
controller.create

created = $last_saved_group

if created.nil?
  puts "RESULT: FAIL: controller did not attempt to create a group"
elsif created.name == "my_group"
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: nested group[...] params ignored; group created with name=#{created.name.inspect}, visible=#{created.visible.inspect}"
end
