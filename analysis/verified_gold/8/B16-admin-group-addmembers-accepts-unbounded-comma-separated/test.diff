diff --git a/spec/verify/groups_controller_verify.rb b/spec/verify/groups_controller_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/groups_controller_verify.rb
@@ -0,0 +1,73 @@
+require 'json'
+
+module I18n
+  def self.t(key, opts = {}); key.to_s; end
+end
+
+$find_calls = 0
+$add_calls = 0
+
+class User
+  def self.find_by_username(name)
+    $find_calls += 1
+    new
+  end
+end
+
+class Group
+  attr_accessor :automatic
+  def initialize
+    @automatic = false
+  end
+  def self.find(id)
+    new
+  end
+  def add(user)
+    $add_calls += 1
+  end
+  def save; true; end
+  def users; @users ||= []; end
+end
+
+class Params
+  def initialize(h); @h = h; end
+  def [](k); @h[k.to_s]; end
+  def require(k)
+    v = @h[k.to_s]
+    raise "missing #{k}" if v.nil?
+    v
+  end
+end
+
+module Admin
+  class AdminController
+    attr_accessor :params
+    def render_serialized(*args); end
+    def render_json_error(*args); end
+    def success_json; { success: true }; end
+    def render(arg); arg; end
+  end
+end
+
+require_relative '../../app/controllers/admin/groups_controller'
+
+N = 10_000
+usernames = (1..N).map { |i| "user#{i}" }.join(',')
+
+controller = Admin::GroupsController.new
+controller.params = Params.new('group_id' => '1', 'usernames' => usernames)
+
+begin
+  controller.add_members
+rescue => e
+  puts "RESULT: FAIL: raised #{e.class}: #{e.message}"
+  exit
+end
+
+if $find_calls >= N
+  puts "RESULT: FAIL: add_members issued #{$find_calls} find_by_username queries for #{N} usernames (no cap on usernames param)"
+elsif $find_calls >= 1000
+  puts "RESULT: FAIL: add_members processed #{$find_calls} usernames without an effective cap (potential DOS)"
+else
+  puts "RESULT: PASS"
+end
