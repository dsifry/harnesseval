+require 'json'
+
+module I18n
+  def self.t(key); key.to_s; end
+end
+
+class Object
+  def present?; !nil?; end
+end
+
+class NilClass
+  def present?; false; end
+end
+
+module Admin
+  class AdminController
+    def params; $params ||= {}; end
+    def success_json; { success: true }; end
+    def render_serialized(obj, _ser); $captured = obj; end
+    def render_json_error(obj); $captured = obj; end
+    def render(*args); $captured = args; end
+  end
+end
+
+class BasicGroupSerializer; end
+
+class Group
+  attr_accessor :name, :automatic, :visible, :alias_level, :id
+
+  @store = {}
+  class << self
+    attr_accessor :store
+  end
+
+  def self.find(id)
+    store[id] ||= begin
+      g = new
+      g.id = id
+      g.automatic = false
+      g.name = "original"
+      g
+    end
+  end
+
+  def self.reset!
+    self.store = {}
+  end
+
+  def self.order(*_args); []; end
+  def self.where(*_args); []; end
+  def self.refresh_automatic_groups!; end
+
+  def initialize
+    @automatic = false
+  end
+
+  def save; true; end
+end
+
+require_relative '../../app/controllers/admin/groups_controller'
+
+Group.reset!
+
+# CREATE path: create is expected to strip whitespace
+$params = { name: " bob ", visible: "false" }
+$captured = nil
+Admin::GroupsController.new.create
+created_name = $captured && $captured.name
+
+# UPDATE path: does update strip like create does?
+Group.reset!
+Group.find(1)
+$params = { id: 1, name: " bob ", visible: "false" }
+$captured = nil
+Admin::GroupsController.new.update
+updated_name = Group.find(1).name
+
+if created_name == updated_name && created_name.to_s == "bob"
+  puts "RESULT: PASS"
+else
+  puts "RESULT: FAIL: create stored #{created_name.inspect} but update stored #{updated_name.inspect}; update does not strip group name, inconsistent normalization"
+end
