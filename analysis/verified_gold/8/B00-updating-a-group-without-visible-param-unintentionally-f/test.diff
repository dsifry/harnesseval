+# Faithful standalone verification: does updating a group WITHOUT the visible param flip visibility?
+# This drives the REAL Admin::GroupsController#update (the previous test's stubs hid the behaviour).
+# Only collaborators are stubbed; the code under test is the real post-PR file.
+
+require "active_support/core_ext/object/blank"   # the era's nil.present? / hash.present?
+
+module Discourse
+  class InvalidAccess < StandardError; end
+  class InvalidParameters < StandardError; end
+end
+
+class FakeGroup
+  attr_accessor :visible, :alias_level, :name, :automatic, :usernames
+  def initialize(visible: true)
+    @visible = visible; @alias_level = 0; @name = "original"; @automatic = false; @usernames = nil
+  end
+  def save; true; end
+  def add(_u); end
+  def remove(_u); end
+end
+
+$group = nil
+class Group
+  def self.find(_id); $group; end
+  def self.new; FakeGroup.new; end
+  def self.order(_x); []; end
+end
+class User
+  def self.find_by_username(_u); nil; end
+end
+class BasicGroupSerializer; end
+
+class StubRequest
+  def patch?; true; end
+end
+
+module Admin
+  class AdminController
+    def params; @params; end
+    def request; StubRequest.new; end
+    def render(*_args); @rendered = :rendered; end
+    def render_json_error(_o); @rendered = :error; end
+    def render_serialized(_o, _s); @rendered = :serialized; end
+    def success_json; { "success" => true }; end
+    def current_user; nil; end
+    def discourse_expires_in(_t); end
+  end
+end
+
+require File.expand_path("app/controllers/admin/groups_controller.rb", Dir.pwd)
+
+# Scenario: a PATCH-style update that never mentions `visible`.
+$group = FakeGroup.new(visible: true)
+controller = Admin::GroupsController.new
+controller.instance_variable_set(:@params, { "id" => "1", "name" => "renamed" })
+begin
+  controller.update
+rescue => e
+  puts "RESULT: FAIL: update raised #{e.class}: #{e.message}"
+  exit 1
+end
+
+if $group.visible == true
+  puts "RESULT: PASS"
+else
+  puts "RESULT: FAIL: updating a group without the visible param flipped visibility to #{$group.visible.inspect}"
+  exit 1
+end
