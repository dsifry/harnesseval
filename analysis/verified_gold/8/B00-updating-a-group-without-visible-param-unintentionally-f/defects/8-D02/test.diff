# frozen_string_literal: true

# Minimal stubs so the real controller can load without Rails.
class FakeParams
  def initialize(h)
    @h = {}
    h.each { |k, v| @h[k.to_sym] = v }
  end
  def [](k) @h[k.to_sym] end
  def require(k) @h.fetch(k.to_sym) end
end

class Object
  def present?; !nil? end
end
class NilClass
  def present?; false end
end

module Admin
  class AdminController
    attr_accessor :params
    def initialize(p = {})
      @params = FakeParams.new(p)
    end
    def render_serialized(*); end
    def render_json_error(*); end
    def render(*); end
    def success_json; { success: true } end
  end
end

class Group
  attr_accessor :name, :visible, :alias_level, :automatic, :id
  def initialize
    @automatic = false
    @saved = false
  end
  def save; @saved = true; true end
  def self.find(_id); $group end
  def self.order(*); [] end
  def self.where(*); [] end
  def users; [] end
  def add(_); end
  def users=(_); end
end

require_relative '../../app/controllers/admin/groups_controller.rb'

$group = Group.new
$group.id = 1
$group.visible = true
$group.alias_level = 0
$group.name = 'existing_name'
$group.automatic = false

controller = Admin::GroupsController.new(id: 1, alias_level: 2)
controller.update

if $group.visible == true
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: update with absent :visible silently set visible=#{$group.visible.inspect}"
end
