# Standalone regression test for Admin::GroupsController#update
# Demonstrates that updating a group without the `visible` param flips visibility to false.

module Admin; end unless defined?(Admin)

class Admin::AdminController
  attr_accessor :params, :rendered
  def initialize(params = {})
    @params = params
    @rendered = {}
  end
  def render_serialized(obj, serializer); @rendered = { serialized: obj }; end
  def render_json_error(obj); @rendered = { error: obj }; end
  def render(opts); @rendered = opts; end
  def success_json; { success: true }; end
end

class NilClass
  def present?; false; end
end

class Object
  def present?; true; end
end

module I18n
  def self.t(key); key; end
end

class BasicGroupSerializer; end

class Group
  attr_accessor :id, :name, :visible, :alias_level, :automatic

  def self.all; @all ||= {}; end
  def self.find(id); all[id] ||= new(id); end

  def initialize(id = nil)
    @id = id
    @visible = true
    @automatic = false
  end

  def save
    self.class.all[@id] = self
    true
  end

  def users; @users ||= []; end
  def users=(value); @users = value; end
  def add(user); users << user; end
end

require './app/controllers/admin/groups_controller.rb'

group = Group.find(1)
group.visible = true
group.automatic = false
group.name = "public-group"
group.save

admin_params = { "id" => "1", "name" => "public-group-renamed" }
controller = Admin::GroupsController.new(admin_params)
controller.update

saved = Group.find(1)
if saved.visible == true
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: updating a group without the visible param flipped visibility to #{saved.visible.inspect}"
end