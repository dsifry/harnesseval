diff --git a/spec/verify/admin-group.js_verify.rb b/spec/verify/admin-group.js_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/admin-group.js_verify.rb
@@ -0,0 +1,51 @@
+require 'pathname'
+
+# This file is JavaScript, so we cannot `require` it in Ruby.
+# Instead, we statically analyze the real source file to verify the claimed defect.
+file_path = Pathname.new('app/assets/javascripts/admin/controllers/admin-group.js.es6').expand_path
+
+unless file_path.exist?
+  puts "RESULT: FAIL: file not found at #{file_path}"
+  exit 1
+end
+
+source = file_path.read
+lines = source.lines
+
+start_index = lines.index { |l| l =~ /addMembers:\s*function/ }
+if start_index.nil?
+  puts "RESULT: FAIL: could not locate addMembers function"
+  exit 1
+end
+
+# Extract the body of addMembers by brace matching
+brace_count = 0
+body = ''
+in_function = false
+lines[start_index..-1].each do |line|
+  if !in_function
+    if line.include?('{')
+      in_function = true
+      brace_count += line.count('{') - line.count('}')
+    end
+  else
+    brace_count += line.count('{') - line.count('}')
+    body << line
+    break if brace_count == 0
+  end
+end
+
+if body.empty?
+  puts "RESULT: FAIL: could not extract addMembers body"
+  exit 1
+end
+
+# Check whether the body clears the 'usernames' property
+# A correct implementation would contain something like: this.set('usernames', '')
+clears = body =~ /\.set\(['\"]usernames['\"]\s*,\s*(?:''|""|null|undefined|\[\])\s*\)/m
+
+if clears
+  puts "RESULT: PASS"
+else
+  puts "RESULT: FAIL: addMembers does not clear the usernames field after adding members; stale usernames remain and can be re-submitted"
+end
