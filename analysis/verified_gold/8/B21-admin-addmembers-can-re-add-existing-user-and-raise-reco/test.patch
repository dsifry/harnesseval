# spec/verify/groups_controller_verify.rb

module ActiveRecord
  class RecordNotUnique < StandardError; end
end

module I18n
  def self.t(key); key.to_s; end
end

module Admin
  class AdminController
    attr_accessor :params

    def render_serialized(*args); end
    def render_json_error(*args); end
    def render(*args); end
    def success_json; { success: true }; end
  end
end

class User
  attr_reader :username
  def initialize(username); @username = username; end

  def self.find_by_username(username)
    @users ||= {}
    @users[username] ||= new(username)
  end
end

class Group
  attr_accessor :automatic, :name, :members

  def initialize
    @members = []
    @automatic = false
  end

  def self.find(id)
    @group ||= new
  end

  def add(user)
    # Simulate a unique join-table constraint on (group_id, user_id)
    if @members.include?(user.username)
      raise ActiveRecord::RecordNotUnique, "duplicate key value violates unique constraint"
    end
    @members << user.username
  end

  def users
    @members
  end

  def save
    true
  end
end

class FakeParams
  def initialize(hash); @hash = hash; end
  def require(key); @hash.fetch(key); end
  def [](key); @hash[key]; end
end

# Load the real controller
require_relative '../../app/controllers/admin/groups_controller.rb'

# Pre-seed the group with alice as an existing member
group = Group.find(1)
group.members << "alice"

controller = Admin::GroupsController.new
controller.params = FakeParams.new({ group_id: "1", usernames: "bob,alice" })

result = nil
reason = nil

begin
  controller.add_members
  result = "PASS"
rescue ActiveRecord::RecordNotUnique => e
  result = "FAIL"
  reason = "re-adding existing member raised #{e.class} and left partial membership: #{group.members.inspect}"
rescue => e
  result = "FAIL"
  reason = "unexpected error #{e.class}: #{e.message}"
end

if result == "PASS"
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: #{reason}"
end
