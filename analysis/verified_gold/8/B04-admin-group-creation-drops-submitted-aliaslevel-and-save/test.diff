diff --git a/spec/verify/groups_controller_verify.rb b/spec/verify/groups_controller_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/groups_controller_verify.rb
@@ -0,0 +1,64 @@
+require 'json'
+
+# --- Minimal stubs so the real controller file can load ---
+module I18n
+  def self.t(key, **opts); key.to_s; end
+end
+
+class BasicGroupSerializer; end
+
+class Group
+  attr_accessor :name, :visible, :alias_level, :automatic
+
+  class << self
+    attr_accessor :instances, :find_result
+  end
+  self.instances = []
+
+  def initialize
+    @alias_level = 0 # model default
+    @automatic   = false
+    @name        = nil
+    @visible     = nil
+    self.class.instances << self
+  end
+
+  def save; true; end
+  def self.order(*args); []; end
+  def self.where(*args); self; end
+  def self.find(id); find_result; end
+end
+
+module Admin
+  class AdminController
+    attr_accessor :params, :rendered
+
+    def render(*args);        @rendered = args; end
+    def render_serialized(*args); @rendered = args; end
+    def render_json_error(*args); @rendered = args; end
+    def success_json; { success: true }; end
+  end
+end
+
+# --- Load the REAL file under test ---
+require_relative '../../app/controllers/admin/groups_controller.rb'
+
+Group.instances.clear
+
+controller = Admin::GroupsController.new
+controller.params = { name: 'qa-group', visible: 'true', alias_level: '5' }
+controller.create
+
+group = Group.instances.first
+
+if group.nil?
+  puts 'RESULT: FAIL: create did not instantiate a Group'
+elsif group.name != 'qa-group'
+  puts "RESULT: FAIL: name was not applied (got #{group.name.inspect})"
+elsif group.visible != true
+  puts "RESULT: FAIL: visible was not applied (got #{group.visible.inspect})"
+elsif group.alias_level.to_i == 5
+  puts 'RESULT: PASS'
+else
+  puts "RESULT: FAIL: submitted alias_level=5 was dropped; saved #{group.alias_level.inspect} (model default)"
+end
