diff --git a/spec/verify/topic_embed_verify.rb b/spec/verify/topic_embed_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/topic_embed_verify.rb
@@ -0,0 +1,112 @@
+# standalone verification for app/models/topic_embed.rb
+# claim: TopicEmbed stores a redundant topic_id that goes stale when an embedded
+# post is moved to another topic (Discourse supports moving posts).
+require 'digest'
+require 'uri'
+
+# --- minimal Rails / runtime shims ---------------------------------------
+module Kernel
+  def require_dependency(name)
+    require name
+  rescue LoadError
+    nil
+  end
+end
+
+begin
+  require 'nokogiri'
+rescue LoadError
+  module Nokogiri
+    module HTML
+      class Fragment
+        def initialize(html); @html = html; end
+        def css(_sel); []; end
+        def to_html; @html; end
+      end
+      def self.fragment(html); Fragment.new(html); end
+    end
+  end
+end
+
+module I18n
+  def self.t(key, opts = {}); opts[:default] || key.to_s; end
+end
+
+module FakeDB
+  def self.embeds; @embeds ||= []; end
+  def self.posts;  @posts  ||= []; end
+  def self.reset!; @embeds = []; @posts = []; end
+end
+
+class Post
+  attr_accessor :id, :topic_id, :raw
+  def self.cook_methods; { raw_html: 0 }; end
+  def present?; true; end
+end
+
+class PostRevisor
+  def initialize(post); @post = post; end
+  def revise!(_user, raw, _opts = {}); @post.raw = raw; true; end
+end
+
+module ActiveRecord
+  class Relation
+    def initialize(rows, conds); @rows = rows; @conds = conds; end
+    def all; @rows.select { |r| @conds.all? { |k, v| r.public_send(k) == v } }; end
+    def first; all.first; end
+    def pluck(col); all.map { |r| r.public_send(col) }; end
+  end
+
+  class Base
+    attr_accessor :id, :topic_id, :post_id, :embed_url, :content_sha1
+    def self.belongs_to(_name, *_args); end
+    def self.validates_presence_of(*_args); end
+    def self.where(conds); Relation.new(FakeDB.embeds, conds); end
+    def self.create!(attrs)
+      obj = new
+      attrs.each { |k, v| obj.public_send(\"#{k}=\", v) }
+      obj.id ||= (FakeDB.embeds.map(&:id).compact.max || 0) + 1
+      FakeDB.embeds << obj
+      obj
+    end
+    def update_column(name, value); public_send(\"#{name}=\", value); true; end
+    def post; FakeDB.posts.find { |p| p.id == post_id }; end
+    def blank?; false; end
+  end
+end
+
+require_relative '../../app/models/topic_embed'
+
+# --- exercise the real file ----------------------------------------------
+FakeDB.reset!
+
+post = Post.new
+post.id = 5
+post.topic_id = 100
+post.raw = 'old'
+FakeDB.posts << post
+
+url = 'http://example.com/article'
+TopicEmbed.create!(topic_id: 100, embed_url: url,
+                   content_sha1: Digest::SHA1.hexdigest('old'), post_id: 5)
+
+embed = TopicEmbed.where(embed_url: url).first
+raise 'setup failed' unless embed.topic_id == 100 && embed.post.topic_id == 100
+
+# Discourse-supported move: the embedded post is relocated to another topic.
+post.topic_id = 200
+
+# Drive the real model logic along the existing-embed (update) path.
+TopicEmbed.import(Object.new, url, 'Title', 'new contents')
+
+embed    = TopicEmbed.where(embed_url: url).first
+observed = TopicEmbed.topic_id_for_embed(url)
+expected = post.topic_id
+
+if observed == expected && embed.topic_id == expected
+  puts 'RESULT: PASS'
+else
+  msg = 'redundant TopicEmbed#topic_id went stale after the post was moved ' +
+        "(stored=#{embed.topic_id}, post.topic_id=#{post.topic_id}, topic_id_for_embed=#{observed})"
+  puts "RESULT: FAIL: #{msg}"
+end
