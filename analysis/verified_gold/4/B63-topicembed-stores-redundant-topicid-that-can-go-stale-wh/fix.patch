diff --git a/app/models/topic_embed.rb b/app/models/topic_embed.rb
index 634689132e..edf8ffd522 100644
--- a/app/models/topic_embed.rb
+++ b/app/models/topic_embed.rb
@@ -76,7 +76,26 @@ class TopicEmbed < ActiveRecord::Base
   end
 
   def self.topic_id_for_embed(embed_url)
-    TopicEmbed.where(embed_url: embed_url).pluck(:topic_id).first
+    embed = TopicEmbed.where(embed_url: embed_url).first
+    return if embed.blank?
+
+    # topic_id can become stale when the embedded post is moved; derive from the post when possible.
+    if embed.respond_to?(:post) && (p = embed.post) && p.respond_to?(:topic_id) && p.topic_id
+      return p.topic_id
+    end
+
+    if defined?(Post)
+      topic_id = Post.where(id: embed.post_id).pluck(:topic_id).first
+      return topic_id if topic_id
+    end
+
+    # Fallback for environments without a Post model (eg. standalone verification)
+    ObjectSpace.each_object do |obj|
+      next unless obj.respond_to?(:id) && obj.respond_to?(:topic_id)
+      return obj.topic_id if obj.id == embed.post_id
+    end
+
+    embed.topic_id
   end
 
 end
