def require_dependency(name); end

module Nokogiri
  module HTML
    def self.fragment(_contents); FakeFragment.new; end
  end
end
class FakeFragment
  def css(*); []; end
  def to_html; ''; end
end

module I18n
  def self.t(_key, _opts = {}); 'imported from'; end
end

class FakeRelation
  def initialize(embed); @embed = embed; end
  def first; @embed; end
  def pluck(col); [@embed ? @embed.send(col) : nil]; end
end

class FakeEmbed
  attr_accessor :content_sha1, :post, :topic_id
  def initialize(sha1, post); @content_sha1 = sha1; @post = post; @topic_id = 1; end
  def blank?; false; end
  def update_column(*); end
end

class ActiveRecord
  class Base
    def self.belongs_to(*); end
    def self.validates_presence_of(*); end
    def self.where(*); FakeRelation.new($test_embed); end
    def self.create!(*); end
    def self.pluck(*); []; end
  end
end

class Post
  def self.cook_methods; { raw_html: 1 }; end
end

class PostCreator
  def initialize(*); end
  def create; nil; end
end

class Topic
  def self.transaction; yield; end
end

class PostRevisor
  def initialize(post)
    raise NoMethodError, "undefined method `topic' for nil:NilClass" if post.nil?
    @post = post
  end
  def revise!(*); end
end

