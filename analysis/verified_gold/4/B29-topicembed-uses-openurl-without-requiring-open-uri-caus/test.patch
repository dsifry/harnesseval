require 'digest'

# Stub require so the in-method `require 'ruby-readability'` does not blow up.
module Kernel
  alias_method :__orig_require_for_verify, :require
  def require(name)
    return false if name == 'ruby-readability'
    __orig_require_for_verify(name)
  end
end

# Rails DSL stub used at class body top.
def require_dependency(_name); end

module Readability
  class Document
    def initialize(_html, _opts = {}); end
  end
end

module Nokogiri
  module HTML
    def self.fragment(_html); Fragment.new; end
    class Fragment
      def css(_selector); []; end
      def to_html; ''; end
    end
  end
end

class ActiveRecord
  class Base
    class << self
      def belongs_to(*); end
      def validates_presence_of(*); end
      def where(*); Relation.new; end
      def pluck(*); []; end
    end
    class Relation
      def first; nil; end
    end
  end
end

# Load the REAL file under test, never redefine the class.
require_relative '../../app/models/topic_embed'

begin
  # With open-uri loaded we would see a connection error (or another non-ENOENT).
  # With the defect (open-uri never required in topic_embed.rb) Kernel#open treats
  # the http URL as a literal filename and raises Errno::ENOENT.
  TopicEmbed.import_remote(:user, 'http://127.0.0.1:1/definitely-missing')
  puts 'RESULT: PASS'
rescue Errno::ENOENT
  puts 'RESULT: FAIL: TopicEmbed#import_remote called open(url) without topic_embed.rb requiring open-uri; the URL was treated as a local file path (Errno::ENOENT)'
rescue StandardError
  # Any other failure mode implies URL-aware open (open-uri) was actually in effect.
  puts 'RESULT: PASS'
end
