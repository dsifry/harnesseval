+  def self.normalize_url(url)
+    uri = URI.parse(url)
+    uri.fragment = nil
+    uri.query = nil
+    uri.host = uri.host.downcase if uri.host
+    uri.path = uri.path.sub(/\/+$/, '') unless uri.path.blank?
+    uri.to_s.sub(/:80(\/|$)/, '\\1')
+  rescue URI::InvalidURIError
+    url
+  end
