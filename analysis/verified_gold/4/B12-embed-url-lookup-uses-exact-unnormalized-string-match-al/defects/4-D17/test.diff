$next_topic_id = 0
class PostCreator
  def initialize(user, opts = {}); @opts = opts; end
  def create
    $next_topic_id += 1
    p = Post.new
    p.topic_id = $next_topic_id
    p.id = $next_topic_id
    p
  end
end

class PostRevisor
  def initialize(post); @post = post; end
  def revise!(*args); end
end

require_relative '../../app/models/topic_embed.rb'

user = Object.new
base_url = 'http://example.com/article'
post1 = TopicEmbed.import(user, base_url.dup, 'Title', 'body'.dup)

variants = {
  'query params'   => 'http://example.com/article?utm_source=news',
  'trailing slash' => 'http://example.com/article/',
  'fragment'       => 'http://example.com/article#section',
  'hostname case'  => 'http://EXAMPLE.com/article',
  'default port'   => 'http://example.com:80/article'
}

mismatches = variants.reject do |_, variant_url|
  TopicEmbed.topic_id_for_embed(variant_url) == post1.topic_id
end

if mismatches.empty?
  puts 'RESULT: PASS'
else
  details = mismatches.map { |label, url| "#{label} #{url.inspect}" }.join(', ')
  puts "RESULT: FAIL: embed URL lookup is an exact, unnormalized string match; equivalent URLs (#{details}) resolve to a different or missing topic instead of topic_id=#{post1.topic_id}"
end
