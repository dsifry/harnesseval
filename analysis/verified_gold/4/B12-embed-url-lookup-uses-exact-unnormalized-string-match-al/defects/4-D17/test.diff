module Nokogiri
  class FakeFragment
    def initialize(html); @html = html; end
    def css(selector); []; end
    def to_html; @html; end
  end
  module HTML
    def self.fragment(html)
      FakeFragment.new(html)
    end
  end
end

module ActiveRecord
  class Base
    %w[id topic_id embed_url content_sha1 post_id post].each do |a|
      attr_accessor a
    end

    def self.belongs_to(*args); end
    def self.validates_presence_of(*args); end
    def self.transaction; yield; end

    def self.rows
      @rows ||= []
    end

    def self.where(conditions)
      Relation.new(self, conditions)
    end

    def self.create!(attrs)
      obj = new
      attrs.each { |k, v| obj.send("#{k}=", v) }
      obj.id ||= (rows.map(&:id).compact.max || 0) + 1
      rows << obj
      obj
    end

    def update_column(column, value)
      send("#{column}=", value)
    end

    class Relation
      def initialize(klass, conditions)
        @klass = klass
        @conditions = conditions
      end

      def all
        @klass.rows.select do |row|
          @conditions.all? { |k, v| row.send(k) == v }
        end
      end

      def first
        all.first
      end

      def pluck(column)
        all.map { |row| row.send(column) }
      end
    end
  end
end

