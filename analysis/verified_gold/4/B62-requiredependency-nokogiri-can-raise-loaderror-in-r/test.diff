+# spec/verify/topic_embed_verify.rb
+
+# Simulate Rails development mode dependency loading.
+# In dev mode, ActiveSupport::Dependencies.mechanism is :load, and require_dependency
+# falls back to Kernel#load, which cannot resolve extension-less gem names like 'nokogiri'.
+module ActiveSupport
+  module Dependencies
+    def self.mechanism
+      :load
+    end
+  end
+end
+
+# Define require_dependency as it behaves in development mode.
+def require_dependency(file_name, message = "No such file to load -- %s")
+  if ActiveSupport::Dependencies.mechanism == :load
+    load file_name
+  else
+    require file_name
+  end
+end
+
+# Minimal stubs for the real file to load if the defect were absent.
+module ActiveRecord
+  class Base
+    def self.belongs_to(*args); end
+    def self.validates_presence_of(*args); end
+  end
+end
+
+module I18n
+  def self.t(*args); ''; end
+end
+
+module Digest
+  class SHA1
+    def self.hexdigest(*args); ''; end
+  end
+end
+
+# Attempt to load the real file under test.
+begin
+  require_relative '../../app/models/topic_embed'
+  puts "RESULT: PASS"
+rescue LoadError => e
+  if e.message.include?('nokogiri')
+    puts "RESULT: FAIL: require_dependency 'nokogiri' raised LoadError: #{e.message}"
+  else
+    puts "RESULT: FAIL: unexpected LoadError: #{e.message}"
+  end
+end
