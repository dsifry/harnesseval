diff --git a/spec/verify/embed.html_verify.rb b/spec/verify/embed.html_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/embed.html_verify.rb
@@ -0,0 +1,48 @@
+require 'erb'
+require 'ostruct'
+
+# Minimal stubs for the view context used by the ERB template.
+class EmbedViewContext
+  def stylesheet_link_tag(name)
+    "<link rel='stylesheet' href='#{name}.css'>"
+  end
+
+  def request
+    @request ||= OpenStruct.new(referer: 'http://host.example/page')
+  end
+end
+
+begin
+  # Load the real ERB file with a relative path from the repo root.
+  template_path = File.expand_path('../../app/views/layouts/embed.html.erb', __FILE__)
+  template = File.read(template_path)
+
+  mod = Module.new
+  ERB.new(template).def_method(mod, :render, template_path)
+
+  view = EmbedViewContext.new
+  html = mod.instance_method(:render).bind(view).call { 'VIEW YIELD CONTENT' }
+
+  script = html[/<script>(.*?)<\/script>/m, 1]
+  raise 'No <script> block found in rendered output' unless script
+
+  # The defect: the iframe height is posted only once on load, with no
+  # handling for subsequent layout changes (resize, text wrap, dynamic content).
+  # A correct implementation would re-post the height on resize or via an observer.
+  has_resize_handler = !!(
+    script =~ /addEventListener\s*\(\s*['"]resize['"]/ ||
+    script =~ /window\.onresize\s*=/ ||
+    script =~ /onresize\s*[:=]/ ||
+    script =~ /ResizeObserver/ ||
+    script =~ /setInterval/ ||
+    script =~ /requestAnimationFrame/
+  )
+
+  if has_resize_handler
+    puts 'RESULT: PASS'
+  else
+    puts 'RESULT: FAIL: iframe height is posted only once on window.onload; no resize, observer, or polling handler found, so content can be clipped after resize/wrap'
+  end
+rescue => e
+  puts "RESULT: FAIL: #{e.class}: #{e.message}"
+end
