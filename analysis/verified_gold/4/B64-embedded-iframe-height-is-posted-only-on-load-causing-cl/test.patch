require 'erb'
require 'ostruct'

# Stubs for the ERB template
context = Object.new
context.define_singleton_method(:stylesheet_link_tag) { |name| "/assets/#{name}.css" }
context.define_singleton_method(:request) { OpenStruct.new(referer: 'http://example.com') }
context.define_singleton_method(:yield) { '<!-- content -->' }

# Load and render the REAL file
path = File.expand_path('app/views/layouts/embed.html.erb', Dir.pwd)
erb = ERB.new(File.read(path))
html = erb.result(context.instance_eval { binding })

# Extract the inline script content
script = html[%r{<script>(.*?)</script>}m, 1] || ''

# Check for any resize handling: addEventListener('resize'), onresize, ResizeObserver, or setInterval (polling)
has_resize_handler = script.match?(/addEventListener\s*\(\s*['"]resize['"]|onresize\s*=|ResizeObserver|setInterval/i)

if has_resize_handler
  puts 'RESULT: PASS'
else
  puts 'RESULT: FAIL: iframe height is only posted on load; no resize handler to re-post height after the host page is resized/wrapped'
end
