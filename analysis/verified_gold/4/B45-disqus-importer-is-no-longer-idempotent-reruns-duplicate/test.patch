# ---------- fake domain objects ----------
class FakePost
  attr_reader :topic, :post_number
  def initialize(topic, number); @topic = topic; @post_number = number; end
  def topic_id; @topic.id; end
end

class FakeTopic
  ALL = []
  attr_reader :id, :posts
  def initialize(id); @id = id; @posts = []; @next_number = 1; ALL << self; end
  def self.find(id); ALL.find { |t| t.id == id }; end
  def add_post
    p = FakePost.new(self, @next_number)
    @next_number += 1
    @posts << p
    p
  end
end

class User
  attr_reader :email, :username
  def initialize(email, username); @email = email; @username = username; end
  def self.registry; @registry ||= {}; end
  def self.where(cond)
    if cond.key?(:username_lower)
      [registry.values.find { |u| u.username.downcase == cond[:username_lower] }].compact
    elsif cond.key?(:email)
      [registry[cond[:email]]].compact
    else
      []
    end
  end
  def self.create!(email:, username:)
    u = new(email, username); registry[email] = u; u
  end
end

module UserNameSuggester; def self.suggest(email); email.split('@').first; end; end
module Email; def self.downcase(s); s.downcase; end; end
class SiteSetting
