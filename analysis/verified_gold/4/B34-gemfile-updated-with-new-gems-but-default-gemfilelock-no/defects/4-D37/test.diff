require 'pathname'

ROOT    = File.expand_path(File.join(File.dirname(__FILE__), '..', '..'))
GEMFILE = File.join(ROOT, 'Gemfile')

# --- minimal stubs so the real Gemfile can be evaluated standalone ---
module Bundler
  module SharedHelpers
    extend self
    def default_gemfile
      Pathname.new(GEMFILE)
    end
  end

  class Dsl
    def to_definition(*); end
  end
end

$declared_gems = []

def source(*); end

def gem(name, *args)
  $declared_gems << name.to_s
  nil
end

def group(*args, &blk)
  blk.call if blk
  nil
end

# --- load the REAL file under test (no redefinition of its logic) ---
begin
  require GEMFILE
rescue LoadError
  load GEMFILE
end

# --- observable consistency check ---
lock_path = File.join(ROOT, 'Gemfile.lock')

unless File.exist?(lock_path)
  STDOUT.puts "RESULT: FAIL: Gemfile.lock (default rails3 track) is missing"
  exit 1
end

lock_contents = File.read(lock_path)

claimed = %w[ruby-readability simple-rss]
declared = claimed.select { |g| $declared_gems.include?(g) }

if declared.empty?
  STDOUT.puts "RESULT: PASS: claimed gems are not declared in Gemfile"
  exit 0
end

missing = declared.reject { |g| lock_contents.include?(g) }

if missing.any?
  STDOUT.puts "RESULT: FAIL: #{missing.join(', ')} declared in Gemfile but absent from Gemfile.lock (default rails3 lock path is out of sync)"
  exit 1
else
  STDOUT.puts "RESULT: PASS"
  exit 0
end
