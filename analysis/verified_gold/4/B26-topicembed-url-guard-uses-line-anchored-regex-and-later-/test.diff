+require 'uri'
+require 'digest'
+begin
+  require 'nokogiri'
+rescue LoadError
+end
+
+# ---- minimal Rails-ish stubs (nothing here is the code under test) ------
+def require_dependency(_name); end
+
+module I18n
+  def self.t(*_args, **_opts); 'imported from'; end
+end
+
+class Object
+  def blank?
+    respond_to?(:empty?) ? !!empty? : !self
+  end
+  def present?
+    !blank?
+  end
+end
+
+module ActiveRecord
+  class Base
+    class Relation
+      def first; nil; end
+      def pluck(*_a); []; end
+    end
+
+    def self.belongs_to(*_a, **_o); end
+    def self.validates_presence_of(*_a, **_o); end
+    def self.where(*_a, **_o); Relation.new; end
+    def self.create!(*_a, **_o); nil; end
+    def self.update_column(*_a, **_o); end
+    def update_column(*_a, **_o); end
+    def self.transaction; yield; end
+  end
+end
+
+class Topic
+  def self.transaction; yield; end
+end
+
+class Post
+  def self.cook_methods; { raw_html: 1 }; end
+end
+
+class FakePost
+  def topic_id; 1; end
+  def id; 1; end
+  def present?; true; end
+end
+
+class PostCreator
+  def initialize(*_a, **_o); end
+  def create; FakePost.new; end
+end
+
+# ---- load the REAL file -------------------------------------------------
+require './app/models/topic_embed.rb'
+
+failures = []
+
+# Probe 1: multi-line value whose 2nd line starts with http://.
+# A correct \A-anchored guard rejects it and import returns nil.
+begin
+  r = TopicEmbed.import(nil, "javascript:alert(1)//\nhttp://x/", "t", "body")
+  unless r.nil?
+    failures << "multi-line URL passed the scheme guard (import returned #{r.inspect})"
+  end
+rescue => e
+  failures << "multi-line URL passed the guard and reached URI(): #{e.class}: #{e.message}"
+end
+
+# Probe 2: malformed URL that passes the prefix-only guard but is not a valid URI.
+begin
+  TopicEmbed.absolutize_urls("http://foo bar/", "<p>hi</p>")
+rescue => e
+  failures << "absolutize_urls raised on a malformed http URL: #{e.class}: #{e.message}"
+end
+
+if failures.empty?
+  puts 'RESULT: PASS'
+else
+  puts "RESULT: FAIL: #{failures.join(' | ')}"
+end
