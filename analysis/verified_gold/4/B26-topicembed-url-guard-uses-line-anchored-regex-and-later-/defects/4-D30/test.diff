class Object
  def present?
    return false if nil?
    respond_to?(:empty?) ? !empty? : true
  end
  def blank?; !present?; end
end

class FakeRelation
  def initialize(recs); @recs = recs; end
  def where(*); self; end
  def first; @recs.first; end
  def pluck(*); []; end
end

module ActiveRecord
  class Base
    def self.belongs_to(*); end
    def self.validates_presence_of(*); end
    def self.where(*); FakeRelation.new([]); end
    def self.create!(*); new; end
  end
end

