# ---- Load the REAL file under test ----
require_relative '../../app/models/topic_embed'

# The guard `return unless url =~ /^https?\:\/\//` runs before anything else.
# If it does NOT return, the very next statement mutates `contents` by
# interpolating the raw url into an unescaped <a href='...'>. That mutation is
# the observable side effect we assert on, so downstream DB/Nokogiri calls are
# irrelevant and any exception they raise is ignored.
def run_import(url)
  contents = +""
  begin
    TopicEmbed.import(nil, url, "title", contents)
  rescue StandardError
    # ignore downstream work (DB model / Nokogiri / URI)
  end
  contents
end

failures = []

# Positive control: a legitimate single-line https URL must pass the guard.
ctl = run_import("http://example.com/a")
failures << "control: legit URL was blocked" unless ctl.include?("http://example.com/a")

# Negative control: a scheme-less single line must be rejected by the guard.
neg = run_import("javascript:alert(1)")
failures << "neg control: javascript: URL passed guard" unless neg.empty?

# The claimed defect: a multiline value whose 2nd line starts with http://
# satisfies Ruby's line-anchored ^ anchor and bypasses the scheme check.
bypass = run_import("javascript:alert(1)\nhttp://evil.example/x")
if bypass.include?("javascript:alert(1)")
  failures << "multiline URL bypassed ^-anchored scheme check; raw value interpolated unescaped: #{bypass.inspect}"
end

if failures.empty?
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: #{failures.join('; ')}"
end
