@@ -54,7 +54,14 @@ class TopicEmbed < ActiveRecord::Base
 
   # Convert any relative URLs to absolute. RSS is annoying for this.
   def self.absolutize_urls(url, contents)
-    uri = URI(url)
+    uri = begin
+      URI(url)
+    rescue ArgumentError
+      # Invalid byte sequences raise ArgumentError, but callers (e.g. the
+      # EmbedController pattern) only rescue URI::InvalidURIError. Normalize
+      # so an invalid referer becomes the expected 4xx, not an unhandled 500.
+      raise URI::InvalidURIError, "invalid url: #{url.inspect}"
+    end
     prefix = "#{uri.scheme}://#{uri.host}"
     prefix << ":#{uri.port}" if uri.port != 80 && uri.port != 443
 
