# --- load the real file under test ---
require_relative '../../app/models/topic_embed.rb'

failures = []

# Exercise TopicEmbed.import with a degenerate but regex-accepted URL.
contents = "original body".dup
raised = nil
begin
  TopicEmbed.import(:user, "http://", "Title", contents)
rescue => e
  raised = e
end

# CLAIM part 1: the URL regex accepts 'http://' so import proceeds, then
# URI() raises URI::InvalidURIError inside absolutize_urls.
unless raised.is_a?(URI::InvalidURIError)
  failures << "expected URI::InvalidURIError for 'http://', got #{raised.inspect}"
end

# CLAIM part 2: contents is mutated in place (appended to) rather than left alone.
unless contents.include?("imported from")
  failures << "caller's contents string was not mutated in place"
end

if failures.empty?
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: #{failures.join('; ')}"
end
