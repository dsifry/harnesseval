diff --git a/spec/verify/topic_retriever_verify.rb b/spec/verify/topic_retriever_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/topic_retriever_verify.rb
@@ -0,0 +1,59 @@
+require 'uri'
+
+# --- minimal stubs so lib/topic_retriever.rb can run standalone ---
+class SiteSetting
+  SETTINGS = {}
+  def self.embeddable_host; SETTINGS[:embeddable_host]; end
+  def self.embeddable_host=(v); SETTINGS[:embeddable_host] = v; end
+  def self.feed_polling_enabled?; false; end
+  def self.embed_by_username; "admin"; end
+end
+
+$redis = Object.new
+def $redis.setnx(_k); true; end
+def $redis.expire(_k, _t); true; end
+
+class TopicEmbed
+  def self.where(*); self; end
+  def self.exists?; raise "PERFORM_REACHED"; end
+  def self.import_remote(*); raise "SHOULD_NOT_GET_HERE"; end
+end
+
+class User
+  def self.where(*); self; end
+  def self.first; nil; end
+end
+
+# --- load the REAL file under test ---
+require_relative '../../lib/topic_retriever'
+
+# Returns true when the defect (strict string equality) is present.
+def host_gate_rejects?
+  begin
+    TopicRetriever.new(@url).retrieve
+    # No exception => perform_retrieve was skipped => invalid_host? returned true
+    true
+  rescue => e
+    return false if e.message == "PERFORM_REACHED"
+    raise
+  end
+end
+
+# Case-difference scenario: configured host 'example.com', URL host 'EXAMPLE.com'
+SiteSetting.embeddable_host = "example.com"
+@url = "http://EXAMPLE.com/post"
+host_case_rejected = host_gate_rejects?
+
+# Scheme-in-config scenario: configured 'http://example.com', URL host 'example.com'
+SiteSetting.embeddable_host = "http://example.com"
+@url = "http://example.com/post"
+scheme_rejected = host_gate_rejects?
+
+if host_case_rejected || scheme_rejected
+  reasons = []
+  reasons << "case-sensitive host comparison rejects URL with different hostname casing" if host_case_rejected
+  reasons << "embeddable_host containing a scheme causes every embed to be rejected" if scheme_rejected
+  puts "RESULT: FAIL: #{reasons.join('; ')}"
+else
+  puts "RESULT: PASS"
+end
