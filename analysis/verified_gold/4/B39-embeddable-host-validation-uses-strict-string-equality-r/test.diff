diff --git a/spec/verify/topic_retriever_verify.rb b/spec/verify/topic_retriever_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/topic_retriever_verify.rb
@@ -0,0 +1,43 @@
+require 'uri'
+require_relative '../../lib/topic_retriever'
+
+module SiteSetting
+  def self.embeddable_host; @embeddable_host; end
+  def self.embeddable_host=(v); @embeddable_host = v; end
+end
+
+def invalid_host?(setting, url)
+  SiteSetting.embeddable_host = setting
+  TopicRetriever.new(url).send(:invalid_host?)
+end
+
+failures = []
+
+# Sanity: exact match should be accepted
+failures << "exact match rejected" if invalid_host?("example.com", "http://example.com/post")
+
+# Claimed defect: uppercase hostname casing is rejected
+if invalid_host?("example.com", "http://EXAMPLE.COM/post")
+  failures << "uppercase hostname rejected (case-sensitive comparison)"
+end
+
+# Claimed defect: configured host casing difference is rejected
+if invalid_host?("Example.COM", "http://example.com/post")
+  failures << "configured host casing mismatch rejected"
+end
+
+# Claimed defect: scheme included in embeddable_host rejects valid embeds
+if invalid_host?("http://example.com", "http://example.com/post")
+  failures << "scheme in embeddable_host rejected"
+end
+
+# Claimed defect: scheme included and case mismatch combined
+if invalid_host?("https://EXAMPLE.com", "http://example.com/post")
+  failures << "scheme + casing combined rejection"
+end
+
+if failures.empty?
+  puts "RESULT: PASS"
+else
+  puts "RESULT: FAIL: #{failures.join('; ')}"
+end
