require 'uri'
require_relative '../../lib/topic_retriever.rb'

# --- minimal stubs -------------------------------------------------------
class SiteSetting
  def self.embeddable_host; @embeddable_host; end
  def self.embeddable_host=(v); @embeddable_host = v; end
  def self.feed_polling_enabled?; false; end
  def self.embed_by_username; 'system'; end
end

class FakeRedis
  def initialize; @h = {}; end
  def setnx(k, v); return false if @h[k]; @h[k] = v; true; end
  def expire(_k, _t); true; end
end
$redis = FakeRedis.new

class User
  def self.where(*); self; end
  def self.first; @u ||= new; end
  def blank?; false; end
end

class TopicEmbed
  IMPORT_CALLS = []
  def self.where(*); self; end
  def self.exists?; false; end
  def self.import_remote(*); IMPORT_CALLS << true; end
end

# --- exercise the real code under test ----------------------------------
results = []

# Case A: configured host lower-case, embed URL host upper-case.
SiteSetting.embeddable_host = 'example.com'
TopicEmbed::IMPORT_CALLS.clear
TopicRetriever.new('http://EXAMPLE.com/post/1').retrieve
results << ['EXAMPLE.com url vs example.com config', TopicEmbed::IMPORT_CALLS.any?]

# Case B: configured host upper-case, embed URL host lower-case.
SiteSetting.embeddable_host = 'EXAMPLE.COM'
TopicEmbed::IMPORT_CALLS.clear
TopicRetriever.new('http://example.com/post/2').retrieve
results << ['example.com url vs EXAMPLE.COM config', TopicEmbed::IMPORT_CALLS.any?]

# Sanity: exact match must still succeed.
SiteSetting.embeddable_host = 'example.com'
TopicEmbed::IMPORT_CALLS.clear
TopicRetriever.new('http://example.com/post/3').retrieve
results << ['exact-match sanity check', TopicEmbed::IMPORT_CALLS.any?]

failures = results.reject { |_, ok| ok }

if failures.empty?
  puts 'RESULT: PASS'
else
  details = failures.map { |name, _| name }.join('; ')
  puts "RESULT: FAIL: case-sensitive hostname comparison rejected valid embed urls (#{details})"
end
