require_relative '../../lib/topic_retriever'

module SiteSetting
  class << self
    attr_accessor :embeddable_host
    def feed_polling_enabled?; false; end
    def embed_by_username; 'system'; end
  end
end

$redis = Object.new
def $redis.setnx(*); true; end
def $redis.expire(*); true; end

module User
  class NullUser; def first; nil; end; end
  def self.where(*); NullUser.new; end
end

class Rel; def exists?; false; end; end

$topic_embed_query_made = false

module TopicEmbed
  def self.where(*); $topic_embed_query_made = true; Rel.new; end
  def self.import_remote(*); end
end

module Jobs
  class PollFeed
    def execute(*); end
  end
end

# Admin has configured embeddable_host WITH a scheme (a common misconfiguration).
# The embed URL is for the exact same host.
SiteSetting.embeddable_host = 'https://example.com'
retriever = TopicRetriever.new('https://example.com/some/article', no_throttle: true)
retriever.retrieve

if $topic_embed_query_made
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: configured embeddable_host with scheme ('https://example.com') makes invalid_host? reject a matching embed URL ('https://example.com/some/article'), so retrieve() short-circuits and never queries TopicEmbed"
end
