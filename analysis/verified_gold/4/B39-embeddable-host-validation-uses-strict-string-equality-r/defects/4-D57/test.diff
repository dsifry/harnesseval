require_relative '../../lib/topic_retriever'

# Minimal stub for the only constant referenced by the method under test.
class SiteSetting
  def self.embeddable_host
    'example.com'
  end
end

retriever = TopicRetriever.new('http://EXAMPLE.com/discourse-embed')

# DNS hostnames are case-insensitive; a host differing only in case is still valid,
# so invalid_host? must return false for this URL.
invalid = retriever.send(:invalid_host?)

if invalid == false
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: invalid_host? returned #{invalid.inspect} for host 'EXAMPLE.com' against configured 'example.com' - case-sensitive comparison rejects a valid embed host"
end
