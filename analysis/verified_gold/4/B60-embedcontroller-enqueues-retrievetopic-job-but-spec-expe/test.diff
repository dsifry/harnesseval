diff --git a/spec/verify/embed_controller_verify.rb b/spec/verify/embed_controller_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/embed_controller_verify.rb
@@ -0,0 +1,80 @@
+# frozen_string_literal: true
+require 'json'
+
+# ---- Minimal stubs so the REAL controller file can load and run ----
+class Integer
+  def minute; self; end
+end
+
+class NilClass
+  def try(*); nil; end
+end
+
+class ApplicationController
+  def self.skip_before_filter(*); end
+  def self.before_filter(*); end
+  def self.layout(*); end
+  def current_user; nil; end
+end
+
+module Jobs
+  class << self
+    def calls; @calls ||= []; end
+    def reset!; @calls = []; end
+    def enqueue(name, *args, **kw)
+      calls << [name, args, kw]
+    end
+  end
+end
+
+module TopicEmbed
+  def self.topic_id_for_embed(_url); nil; end
+end
+
+class TopicView
+  def initialize(*); end
+end
+
+module SiteSetting
+  def self.embeddable_host; nil; end
+end
+
+module Discourse
+  class InvalidAccess < StandardError; end
+end
+
+# Class the spec (allegedly) expects the controller to use synchronously.
+class TopicRetriever
+  class << self
+    attr_accessor :instantiated
+  end
+  self.instantiated = false
+  def initialize(*); self.class.instantiated = true; end
+end
+
+# ---- Load the REAL file under test (do NOT redefine EmbedController) ----
+require_relative '../../app/controllers/embed_controller'
+
+class ParamsStub
+  def initialize(url); @url = url; end
+  def require(_key); @url; end
+end
+
+controller = EmbedController.new
+controller.define_singleton_method(:params) { ParamsStub.new('http://example.test/embed') }
+controller.define_singleton_method(:render) { |*| nil }
+controller.define_singleton_method(:discourse_expires_in) { |*| nil }
+
+Jobs.reset!
+TopicRetriever.instantiated = false
+
+controller.best
+
+enqueued = Jobs.calls.any? { |name, _a, _k| name == :retrieve_topic }
+sync_called = TopicRetriever.instantiated
+
+if enqueued && !sync_called
+  puts "RESULT: FAIL: EmbedController#best enqueues Jobs.enqueue(:retrieve_topic) instead of calling TopicRetriever synchronously; spec expects synchronous TopicRetriever.new"
+else
+  puts "RESULT: PASS"
+end
