require 'digest'
require 'uri'

def require_dependency(_name); end

module I18n
  class << self
    attr_accessor :footer_text
    def t(_key, _opts = {}); footer_text; end
  end
end

module Nokogiri
  module HTML
    class Frag
      def initialize(h); @h = h; end
      def css(_sel); []; end
      def to_html; @h; end
    end
    def self.fragment(h); Frag.new(h); end
  end
end

module ActiveRecord
  class Base
    def self.belongs_to(*); end
    def self.validates_presence_of(*); end
  end
end

class Topic
  def self.transaction; yield; end
end

class Post
  attr_accessor :id, :topic_id
  def self.cook_methods; { raw_html: 3 }; end
  def present?; true; end
end

class PostCreator
  def initialize(_user, _opts = {}); end
  def create
    p = Post.new
    p.id = 1
    p.topic_id = 1
    p
  end
end

REVISIONS = []
class PostRevisor
  def initialize(post); @post = post; end
  def revise!(_user, contents, _opts = {})
    REVISIONS << contents
  end
end

class Object
  def blank?; false; end
end
class NilClass
  def blank?; true; end
end

require_relative '../../app/models/topic_embed'

class EmbedRecord
  attr_accessor :topic_id, :embed_url, :content_sha1, :post_id
  def initialize(attrs)
    attrs.each { |k, v| send("#{k}=", v) }
  end
  def post
    @post ||= begin
      p = Post.new
      p.id = post_id
      p.topic_id = topic_id
      p
    end
  end
  def update_column(name, value); send("#{name}=", value); end
end

class TopicEmbed
  def self.records; @records ||= {}; end
  class Rel
    def initialize(u); @u = u; end
    def first; TopicEmbed.records[@u]; end
  end
  def self.where(embed_url:); Rel.new(embed_url); end
  def self.create!(**attrs)
    rec = EmbedRecord.new(attrs)
    records[attrs[:embed_url]] = rec
    rec
  end
end

I18n.footer_text = "Imported from (en)"
url = "http://example.com/article"
TopicEmbed.import(nil, url, "Title", "<p>Body text</p>")

I18n.footer_text = "Imported from (fr)"
REVISIONS.clear
TopicEmbed.import(nil, url, "Title", "<p>Body text</p>")

if REVISIONS.empty?
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: identical article content with changed locale footer triggered #{REVISIONS.size} spurious revision(s)"
end
