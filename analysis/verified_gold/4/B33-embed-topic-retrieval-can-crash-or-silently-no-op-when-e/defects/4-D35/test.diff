# Minimal stubs to exercise the real lib/topic_retriever.rb without Rails
class FakeRelation
  def initialize(rows); @rows = rows; end
  def where(*); self; end
  def exists?; !@rows.empty?; end
  def first; @rows.first; end
end

module SiteSetting
  class << self
    attr_accessor :embed_by_username
    def feed_polling_enabled?; false; end
  end
end

class User
  class << self
    def rows; @rows ||= []; end
    def where(*); FakeRelation.new(rows); end
  end
end

class TopicEmbed
  class << self
    def rows; @rows ||= []; end
    def where(*); FakeRelation.new(rows); end
    def import_remote(user, url); :imported; end
  end
end

class NilClass
  def blank?; true; end
end

require_relative '../../lib/topic_retriever.rb'

# The claim: with embed_by_username nil, fetch_http should not blow up.
SiteSetting.embed_by_username = nil

retriever = TopicRetriever.new("http://example.com/t/1")

begin
  outcome = retriever.send(:fetch_http)
  # Any non-exception outcome means the nil downcase defect is absent.
  puts "RESULT: PASS"
rescue NoMethodError => e
  puts "RESULT: FAIL: NoMethodError raised: #{e.message}"
rescue => e
  puts "RESULT: FAIL: unexpected #{e.class}: #{e.message}"
end
