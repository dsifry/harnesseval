--- /dev/null
+++ b/spec/verify/topic_retriever_verify.rb
@@ -0,0 +1,78 @@
+require 'uri'
+
+# --- Minimum stubs to load and run the real TopicRetriever without Rails ---
+
+class Object
+  def blank?; false; end
+end
+
+class NilClass
+  def blank?; true; end
+end
+
+module SiteSetting
+  class << self
+    attr_writer :embeddable_host, :embed_by_username, :feed_polling
+    def embeddable_host; @embeddable_host; end
+    def embed_by_username; @embed_by_username; end
+    def feed_polling_enabled?; !!@feed_polling; end
+  end
+end
+
+class TopicEmbed
+  class << self
+    def where(_conditions); self; end
+    def exists?; false; end
+    def import_remote(_user, _url); :imported; end
+  end
+end
+
+class FakeRelation
+  def initialize(records); @records = records; end
+  def first; @records.first; end
+end
+
+class User
+  class << self
+    def where(_conditions); FakeRelation.new([]); end
+  end
+end
+
+class FakeRedis
+  def setnx(_key, _value); true; end
+  def expire(_key, _ttl); true; end
+end
+$redis = FakeRedis.new
+
+# --- Load the REAL file under test (never redefine the class) ---
+require File.expand_path('../../lib/topic_retriever', __dir__)
+
+# --- Exercise the claimed defect ---
+
+SiteSetting.embeddable_host = 'example.com'
+SiteSetting.feed_polling = false
+
+failures = []
+
+# Case 1: embed_by_username is nil -> should not crash on .downcase
+SiteSetting.embed_by_username = nil
+begin
+  TopicRetriever.new('http://example.com/t/nil-user').retrieve
+rescue NoMethodError => e
+  failures << "blank embed_by_username raised NoMethodError (#{e.message.split("\n").first})"
+rescue => e
+  failures << "blank embed_by_username raised #{e.class}"
+end
+
+# Case 2: embed_by_username is '' and no matching user -> should not silently no-op
+SiteSetting.embed_by_username = ''
+result = TopicRetriever.new('http://example.com/t/empty-user').retrieve
+if result.nil?
+  failures << 'empty embed_by_username silently returned nil (no user, no error logged)'
+end
+
+if failures.empty?
+  puts 'RESULT: PASS'
+else
+  puts "RESULT: FAIL: #{failures.join('; ')}"
+end
