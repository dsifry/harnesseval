diff --git a/spec/verify/topic_embed_verify.rb b/spec/verify/topic_embed_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/topic_embed_verify.rb
@@ -0,0 +1,99 @@
+require 'nokogiri'
+require 'digest'
+
+# --- minimal stubs so the real file can load without Rails ---
+class Object
+  def present?; !nil? && !(respond_to?(:empty?) && empty?); end
+  def blank?; !present?; end
+end
+
+module Kernel
+  def require_dependency(p); require p; end
+end
+
+module ActiveRecord
+  class Base
+    def self.belongs_to(*a); end
+    def self.validates_presence_of(*a); end
+  end
+end
+
+module I18n
+  def self.t(*a); "" ; end
+end
+
+require File.expand_path('../../app/models/topic_embed', __dir__)
+
+# --- helpers ---
+def attr_of(html, tag, attr)
+  node = Nokogiri::HTML.fragment(html).css(tag).first
+  node && node[attr]
+end
+
+failures = []
+
+def expect_eq(failures, name, actual, expected)
+  return if actual == expected
+  failures << "#{name}: expected #{expected.inspect}, got #{actual.inspect}"
+end
+
+begin
+  html = TopicEmbed.absolutize_urls(
+    "http://example.com/article",
+    '<a href="//cdn.example.com/page">x</a>'
+  )
+  expect_eq(failures, "protocol-relative anchor",
+            attr_of(html, 'a', 'href'), "http://cdn.example.com/page")
+rescue => e
+  failures << "protocol-relative anchor raised #{e.class}: #{e.message}"
+end
+
+begin
+  html = TopicEmbed.absolutize_urls(
+    "http://example.com/article",
+    '<img src="//cdn.example.com/img.png">'
+  )
+  expect_eq(failures, "protocol-relative img",
+            attr_of(html, 'img', 'src'), "http://cdn.example.com/img.png")
+rescue => e
+  failures << "protocol-relative img raised #{e.class}: #{e.message}"
+end
+
+begin
+  html = TopicEmbed.absolutize_urls(
+    "https://example.com:80/article",
+    '<a href="/page">x</a>'
+  )
+  expect_eq(failures, "https on port 80",
+            attr_of(html, 'a', 'href'), "https://example.com:80/page")
+rescue => e
+  failures << "https on port 80 raised #{e.class}: #{e.message}"
+end
+
+begin
+  html = TopicEmbed.absolutize_urls(
+    "http://example.com:443/article",
+    '<a href="/page">x</a>'
+  )
+  expect_eq(failures, "http on port 443",
+            attr_of(html, 'a', 'href'), "http://example.com:443/page")
+rescue => e
+  failures << "http on port 443 raised #{e.class}: #{e.message}"
+end
+
+begin
+  html = TopicEmbed.absolutize_urls(
+    "http://example.com:8080/article",
+    '<a href="/page">x</a>'
+  )
+  expect_eq(failures, "http on non-default port 8080",
+            attr_of(html, 'a', 'href'), "http://example.com:8080/page")
+rescue => e
+  failures << "http on port 8080 raised #{e.class}: #{e.message}"
+end
+
+if failures.empty?
+  puts "RESULT: PASS"
+else
+  puts "RESULT: FAIL: #{failures.join('; ')}"
+end
