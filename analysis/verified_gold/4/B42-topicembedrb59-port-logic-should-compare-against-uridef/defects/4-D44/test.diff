module Kernel
  def require_dependency(_name); end
end
$LOADED_FEATURES << 'nokogiri.rb'

module Nokogiri
  module HTML
    class Element
      def initialize(attrs); @attrs = attrs; end
      def [](k); @attrs[k]; end
      def []=(k, v); @attrs[k] = v; end
      def to_s
        @attrs.map { |k, v| "#{k}=\"#{v}\"" }.join(' ')
      end
    end

    class Fragment
      def initialize(html)
        @nodes = []
        html.scan(/<(a|img)\b([^>]*)>/i) do |tag, attrs|
          h = {}
          attrs.scan(/([\w-]+)\s*=\s*["']([^"']*)["']/) { |k, v| h[k] = v }
          @nodes << [tag.downcase, Element.new(h)]
        end
      end

      def css(sel)
        @nodes.select { |t, _| t == sel }.map { |_, e| e }
      end

      def to_html
        @nodes.map { |t, e| "<#{t} #{e}></#{t}>" }.join
      end
    end

    def self.fragment(html); Fragment.new(html); end
  end
end

class String
  def present?; !empty?; end
end

class NilClass
  def present?; false; end
end

module ActiveRecord
  class Base
    def self.belongs_to(*); end
    def self.validates_presence_of(*); end
  end
end

# --- load the REAL file under test ---
require_relative '../../app/models/topic_embed.rb'

base = 'https://news.example.com/story'

# Control: a genuine root-relative path should still be absolutized.
root_rel = TopicEmbed.absolutize_urls(base, '<img src="/images/logo.png">')
unless root_rel.include?('src="https://news.example.com/images/logo.png"')
  puts "RESULT: FAIL: control case broken -> #{root_rel}"
  exit
end

# Claimed defect: protocol-relative URLs must NOT be treated as root-relative.
proto = TopicEmbed.absolutize_urls(base, '<img src="//cdn.example.com/image.png">')
if proto.include?('src="//cdn.example.com/image.png"')
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: protocol-relative URL was rewritten as root-relative -> #{proto}"
end
