# frozen_string_literal: true
# Standalone regression probe for db/migrate/20131219203905_add_cook_method_to_posts.rb
# No Rails app, no DB. We stub ActiveRecord::Migration to record add_column calls,
# then load the REAL migration file and run its `change` method.

CALLS = []

module ActiveRecord
  class Migration
    def add_column(*args)
      opts = args.last.is_a?(Hash) ? args.pop.dup : {}
      CALLS << { table: args[0], column: args[1], type: args[2], opts: opts }
    end

    def method_missing(*); end
    def respond_to_missing?(*); true; end
  end
end

# Load the real file under test (relative path from spec/verify/).
require_relative '../../db/migrate/20131219203905_add_cook_method_to_posts.rb'

AddCookMethodToPosts.new.change

defect = false
reason = nil

if CALLS.empty?
  reason = 'no add_column call was recorded by the migration'
elsif CALLS.size != 1
  reason = "expected exactly 1 add_column call, got #{CALLS.size}"
else
  c = CALLS.first
  if c[:table].to_s != 'posts' || c[:column].to_s != 'cook_method'
    reason = "unexpected add_column target: #{c.inspect}"
  else
    has_default  = c[:opts].key?(:default)
    is_not_null  = c[:opts][:null] == false
    if has_default && is_not_null
      defect = true
      reason = "add_column :posts, :cook_method, :integer, default: #{c[:opts][:default].inspect}, null: false " \
               'adds a NOT NULL column with a DEFAULT value in a single DDL statement, ' \
               'which forces a full table rewrite under ACCESS EXCLUSIVE lock on PostgreSQL < 11'
    end
  end
end

if defect
  puts "RESULT: FAIL: #{reason}"
else
  puts 'RESULT: PASS'
end
