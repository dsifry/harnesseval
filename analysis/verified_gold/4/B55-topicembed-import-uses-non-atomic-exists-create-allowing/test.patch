require_relative '../../app/models/topic_embed'

user = nil
url = 'http://example.com/article'
title = 'Article'
contents = '<p>body</p>'

begin
  TopicEmbed.import(user, url, title, contents)
rescue => e
  puts "RESULT: FAIL: first import raised #{e.class}: #{e.message}"
  exit
end

begin
  TopicEmbed.import(user, url, title, contents)
  puts 'RESULT: PASS'
rescue ActiveRecord::RecordNotUnique
  puts 'RESULT: FAIL: concurrent import of same URL raised unhandled ActiveRecord::RecordNotUnique'
rescue => e
  puts "RESULT: FAIL: unexpected #{e.class}: #{e.message}"
end
