module Nokogiri
  module HTML
    def self.fragment(html); Fragment.new(html); end
    class Fragment
      def initialize(html); @html = html; end
      def css(selector); []; end
      def to_html; @html; end
    end
  end
end

class NilClass
  def blank?; true; end
end

module ActiveRecord
  class RecordNotUnique < StandardError; end

  class Base
    def self.belongs_to(*args, **kwargs); end
    def self.validates_presence_of(*args, **kwargs); end
    def self.where(*args, **kwargs); FakeRelation.new; end

    @@create_count = 0
    def self.create!(*args, **kwargs)
      @@create_count += 1
      raise RecordNotUnique if @@create_count > 1
      new
    end
  end

  class FakeRelation
    def first; nil; end
  end
end

