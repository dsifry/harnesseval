# Load the REAL file under test with a relative path.
require_relative '../../app/models/topic_embed'

user = Object.new
url = 'http://example.com/article'
title = 'The Article'

# --- Check 1: mutation of caller-owned string ---
original = 'Hello world'
caller_contents = original.dup
begin
  TopicEmbed.import(user, url, title, caller_contents)
rescue => e
  # ignore — we only care about mutation
end
mutation = (caller_contents != original)

# --- Check 2: FrozenError on frozen input ---
frozen_input = 'Hello world'.freeze
frozen_raised = false
frozen_error = nil
begin
  TopicEmbed.import(user, url, title, frozen_input)
rescue RuntimeError => e
  frozen_raised = true
  frozen_error = e
end

if mutation || frozen_raised
  reasons = []
  reasons << "import mutated caller-owned string in place (added #{caller_contents.length - original.length} chars: #{caller_contents.inspect})" if mutation
  reasons << "raised #{frozen_error.class} on frozen input" if frozen_raised
  puts "RESULT: FAIL: #{reasons.join('; ')}"
else
  puts 'RESULT: PASS'
end
