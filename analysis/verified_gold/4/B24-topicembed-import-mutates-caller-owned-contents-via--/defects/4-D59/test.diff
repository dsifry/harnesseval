require 'digest'

def require_dependency(name); end

module I18n
  def self.t(key, opts={})
    "imported from #{opts[:link]}"
  end
end

module ActiveRecord
  class Base
    def self.belongs_to(*); end
    def self.validates_presence_of(*); end
  end
end

require_relative '../../app/models/topic_embed'

url = "http://example.com/article"
original = "Some article content"
footer = "\n<hr>\n<small>imported from <a href='#{url}'>#{url}</a></small>\n"
mutated = original + footer
sha = Digest::SHA1.hexdigest(mutated)

class FakeEmbed
  attr_accessor :content_sha1, :post
  def initialize(sha, post); @content_sha1 = sha; @post = post; end
  def blank?; false; end
end

relation = Object.new
def relation.first; @embed; end
def relation.embed=(e); @embed = e; end

embed = FakeEmbed.new(sha, nil)
relation.embed = embed

TopicEmbed.define_singleton_method(:where) { |*args| relation }

# Test 1: mutable string is mutated in place
contents = original.dup
TopicEmbed.import(nil, url, "title", contents)
mutated_in_place = (contents != original)

# Test 2: frozen string raises an error
frozen_raised = false
begin
  TopicEmbed.import(nil, url, "title", original.dup.freeze)
rescue => e
  frozen_raised = true
end

if mutated_in_place || frozen_raised
  puts "RESULT: FAIL: contents is mutated in place (caller's string corrupted) and/or FrozenError raised on frozen input"
else
  puts "RESULT: PASS"
end
