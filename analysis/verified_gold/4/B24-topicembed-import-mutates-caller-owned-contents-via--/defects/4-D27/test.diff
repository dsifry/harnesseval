def require_dependency(name); end

module I18n
  def self.t(key, opts = {})
    "imported from #{opts[:link]}"
  end
end

require 'digest'

module ActiveRecord
  class Base
    def self.belongs_to(*); end
    def self.validates_presence_of(*); end
    def blank?; true; end
  end
end

require_relative '../../app/models/topic_embed.rb'

defects = []

# Test 1: a plain (non-frozen) caller string should not be modified.
s = "Article body text about widgets"
orig = s.dup
begin
  TopicEmbed.import(nil, "http://example.com/post/1", "Some Title", s)
rescue Exception
  # other stubs missing (Topic/PostCreator); we only care about mutation
end
if s != orig
  appended = s[orig.length..-1]
  defects << "non-frozen input mutated to #{s.inspect} (appended #{appended.inspect}); " \
             "content_sha1 is computed over content + I18n footer"
end

# Test 2: mutating a frozen input should not raise if the code were pure.
f = "Frozen article body".freeze
f_raised = nil
begin
  TopicEmbed.import(nil, "http://example.com/post/2", "T", f)
rescue Exception => e
  f_raised = e
end
if f_raised && (f_raised.is_a?(FrozenError) || f_raised.message =~ /frozen/i)
  defects << "frozen input raised #{f_raised.class}: #{f_raised.message}"
end

# Sanity: confirm I18n.t is actually consulted by the code path (locale dependence).
require 'stringio'
class << I18n
  alias_method :__orig_t, :t
  def t(key, opts = {})
    $LAST_T = [key, opts]
    __orig_t(key, opts)
  end
end
begin
  TopicEmbed.import(nil, "http://example.com/post/3", "T", "x".dup)
rescue Exception
end
if $LAST_T.nil? || $LAST_T[0] != 'embed.imported_from'
  defects << "I18n.t('embed.imported_from') not invoked; expected hash to depend on footer"
end

if defects.empty?
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: " + defects.join("; ")
end
