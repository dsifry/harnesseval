diff --git a/spec/verify/best.html_verify.rb b/spec/verify/best.html_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/best.html_verify.rb
@@ -0,0 +1,81 @@
+require 'erb'
+
+path = File.expand_path('../../app/views/embed/best.html.erb', __dir__)
+path = 'app/views/embed/best.html.erb' unless File.exist?(path)
+unless File.exist?(path)
+  puts "RESULT: FAIL: template not found at #{path}"
+  exit 0
+end
+src = File.read(path)
+
+unless [].respond_to?(:present?)
+  class Array
+    def present?; !empty?; end
+  end
+end
+
+module I18n
+  def self.t(key); key.to_s; end
+end unless defined?(I18n)
+
+class SiteSetting
+  def self.logo_url; 'http://example.com/logo.png'; end
+end unless defined?(SiteSetting)
+
+class Discourse
+  def self.base_url; 'http://example.com'; end
+end unless defined?(Discourse)
+
+FakeUser = Class.new do
+  def small_avatar_url; 'http://example.com/a.png'; end
+  def username; 'alice'; end
+end
+
+FakePost = Class.new do
+  def created_at; Time.utc(2015, 1, 1); end
+  def url; 'http://example.com/p/1'; end
+  def user; FakeUser.new; end
+  def cooked; '<p>hello</p>'; end
+end
+
+FakeTopic = Class.new do
+  def url; 'http://example.com/t/1'; end
+end
+
+FakeTopicView = Class.new do
+  def initialize(posts); @posts = posts; end
+  def posts; @posts; end
+  def topic; FakeTopic.new; end
+end
+
+view = Object.new
+view.instance_variable_set(:@topic_view, FakeTopicView.new([FakePost.new]))
+class << view
+  def link_to(text, url, **opts); "<a href='#{url}'>#{text}</a>"; end
+  def image_tag(image_src, **opts); "<img src='#{image_src}'>"; end
+  def raw(html); html; end
+end
+tpl_binding = view.instance_eval { binding }
+
+def render_erb(source, b)
+  ERB.new(source, trim_mode: '-').result(b)
+end
+
+# Control: identical template with `end if` -> `end` must render cleanly,
+# proving the stubs are sufficient and isolating the defect.
+fixed = src.gsub(/end if(\s*)%>/, 'end\1%>')
+begin
+  render_erb(fixed, tpl_binding)
+rescue StandardError, SyntaxError => e
+  puts "RESULT: FAIL: stubs insufficient, control render failed: #{e.class}: #{e.message.lines.first.to_s.strip}"
+  exit 0
+end
+
+begin
+  render_erb(src, tpl_binding)
+  puts 'RESULT: PASS'
+rescue SyntaxError => e
+  puts "RESULT: FAIL: ERB syntax error rendering app/views/embed/best.html.erb: #{e.message.lines.first.to_s.strip}"
+rescue StandardError => e
+  puts "RESULT: FAIL: unexpected #{e.class} rendering template: #{e.message.lines.first.to_s.strip}"
+end
