diff --git a/lib/topic_retriever.rb b/lib/topic_retriever.rb
index dc63d310fc..f6c9b21f38 100644
--- a/lib/topic_retriever.rb
+++ b/lib/topic_retriever.rb
@@ -12,12 +12,34 @@ class TopicRetriever
   private
 
     def invalid_host?
-      SiteSetting.embeddable_host != URI(@embed_url).host
+      uri = URI(@embed_url)
+      return true if SiteSetting.embeddable_host != uri.host
+      redirects_to_invalid_host?(uri)
     rescue URI::InvalidURIError
       # An invalid URI is an invalid host
       true
     end
 
+    def redirects_to_invalid_host?(uri, limit = 5)
+      return true if limit <= 0
+      return true unless uri.is_a?(URI::HTTP)
+
+      response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == 'https') do |http|
+        http.head(uri.request_uri)
+      end
+
+      if response.is_a?(Net::HTTPRedirection) && response['location']
+        target = URI.join(uri, response['location'])
+        return true if SiteSetting.embeddable_host != target.host
+        redirects_to_invalid_host?(target, limit - 1)
+      else
+        false
+      end
+    rescue StandardError
+      # If the redirect chain cannot be validated, reject it
+      true
+    end
+
     def retrieved_recently?
       # We can disable the throttle for some users, such as staff
       return false if @opts[:no_throttle]
