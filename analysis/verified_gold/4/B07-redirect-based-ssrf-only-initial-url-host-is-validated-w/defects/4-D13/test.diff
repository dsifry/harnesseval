require 'uri'

# ---- Minimal stubs so the REAL lib/topic_retriever.rb can load and run ----
module SiteSetting
  class << self
    attr_accessor :embeddable_host, :feed_polling_enabled, :embed_by_username
    def feed_polling_enabled?; @feed_polling_enabled; end
  end
end
SiteSetting.embeddable_host        = "embeddable.example.com"
SiteSetting.feed_polling_enabled   = false
SiteSetting.embed_by_username      = "system"

class FakeRedis
  def setnx(*); true; end
  def expire(*); true; end
end
$redis = FakeRedis.new

class User
  class FakeUser
    def blank?; false; end
  end
  def self.where(*); [FakeUser.new]; end
end

class TopicEmbed
  @import_remote_calls = []
  class << self
    attr_accessor :import_remote_calls
    def where(*); Struct.new(:exists?).new(false); end
    def import_remote(_user, url); import_remote_calls << url; end
  end
end

# ---- Load the REAL file under test (no filesystem search) ----
require_relative '../../lib/topic_retriever.rb'

# A URL whose host matches embeddable_host but whose scheme is NOT http(s).
# If the code validated the scheme, this would be rejected before any fetch.
ftp_url = "ftp://embeddable.example.com/payload"

TopicRetriever.new(ftp_url).retrieve

if TopicEmbed.import_remote_calls.empty?
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: TopicEmbed.import_remote was invoked for non-http(s) URL " \
       "#{TopicEmbed.import_remote_calls.inspect}; scheme was not validated before the fetch"
end
