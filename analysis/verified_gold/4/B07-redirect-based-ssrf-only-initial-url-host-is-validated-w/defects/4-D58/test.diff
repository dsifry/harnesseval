# Capture every URL handed to Kernel#open
class OpenIntercept < StandardError
  attr_reader :url
  def initialize(url); @url = url; end
end

$opened_urls = []
module Kernel
  alias_method :__real_open, :open
  def open(url, *args)
    $opened_urls << url
    raise OpenIntercept.new(url)
  end
end

# Load the REAL file under test
require_relative '../../app/models/topic_embed.rb'

# ---- Exercise import_remote with a URL whose scheme is not http/https ----
begin
  TopicEmbed.import_remote(nil, 'file:///etc/passwd')
rescue OpenIntercept
  # expected: we intercepted the open() call
rescue => e
  puts "RESULT: FAIL: unexpected error #{e.class}: #{e.message}"
  exit
end

dangerous = $opened_urls.reject { |u| u =~ %r{\Ahttps?://}i }
if dangerous.empty?
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: import_remote passed unvalidated URL(s) to open(): #{dangerous.inspect}"
end
