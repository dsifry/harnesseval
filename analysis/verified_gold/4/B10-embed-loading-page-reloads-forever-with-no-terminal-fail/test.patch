#!/usr/bin/env ruby
require 'erb'

# Stubs ------------------------------------------------------------------
class ViewContext
  def t(key); key.to_s; end
  def link_to(body, url); %Q(<a href="#{url}">#{body}</a>); end
  def image_tag(src, opts = {}); %Q(<img src="#{src}" class="#{opts[:class]}"/>); end
end

module SiteSetting
  def self.logo_url; 'http://example.com/logo.png'; end
end

module Discourse
  def self.base_url; 'http://example.com'; end
end

# Load and render the real template -------------------------------------
template_path = File.expand_path('../../app/views/embed/loading.html.erb', __dir__)
source = File.read(template_path)
rendered = ERB.new(source).result(ViewContext.new.instance_eval { binding })

# Evidence of the claimed defect ----------------------------------------
reload_loop = rendered.include?('setTimeout') &&
              rendered.include?('30000') &&
              rendered.include?('document.location.reload()')

terminal_patterns = /clearTimeout|attempt|counter|retri|max_|limit|error|fail/i
terminal_state = rendered =~ terminal_patterns

if reload_loop && !terminal_state
  puts "Rendered output contains an unconditional 30s reload loop with no terminal failure path:"
  puts rendered
  puts "RESULT: FAIL: permanent retrieval failures reload forever; no attempt limit or error state"
else
  puts "RESULT: PASS"
end
