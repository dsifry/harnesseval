diff --git a/spec/verify/topic_retriever_verify.rb b/spec/verify/topic_retriever_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/topic_retriever_verify.rb
@@ -0,0 +1,70 @@
+require 'uri'
+
+# --- Minimal stubs so the real file loads and runs standalone ---
+
+module SiteSetting
+  def self.embeddable_host; 'example.com'; end
+  def self.feed_polling_enabled?; true; end
+  def self.embed_by_username; 'system'; end
+end
+
+class NilClass
+  def blank?; true; end
+end
+
+class Object
+  def blank?; false; end
+end
+
+class FakeRedis
+  def setnx(_k); true; end
+  def expire(_k, _t); true; end
+end
+$redis = FakeRedis.new
+
+# Record whether the feed-polling job runs inline on the calling thread
+$poll_invocations = []
+$poll_thread = nil
+
+module Jobs
+  class PollFeed
+    def initialize; end
+    def execute(_opts)
+      $poll_invocations << _opts
+      $poll_thread = Thread.current
+    end
+  end
+end
+
+class TopicEmbed
+  def self.where(_h); NullScope.new; end
+  def self.import_remote(_u, _url); end
+end
+
+class NullScope
+  def exists?; false; end
+end
+
+class User
+  def self.where(_h); NullUserScope.new; end
+end
+
+class NullUserScope
+  def first; nil; end
+end
+
+# --- Load the real class under test ---
+require_relative '../../lib/topic_retriever'
+
+# --- Exercise the cache-miss path ---
+retriever = TopicRetriever.new('http://example.com/some-article', no_throttle: true)
+retriever.retrieve
+
+invoked = !$poll_invocations.empty?
+synchronous = !$poll_thread.nil? && $poll_thread == Thread.current
+
+if invoked && synchronous
+  puts 'RESULT: FAIL: perform_retrieve synchronously runs Jobs::PollFeed.new.execute({}) inline on cache miss (full feed poll on request thread)'
+else
+  puts 'RESULT: PASS'
+end
