+# --- Minimal stubs so the REAL class can load and run ---
+class FakeRedis
+  def initialize; @h = {}; end
+  def setnx(k, v)
+    return false if @h[k]
+    @h[k] = v
+    true
+  end
+  def expire(k, t); true; end
+end
+$redis = FakeRedis.new
+
+module SiteSetting
+  def self.embeddable_host; 'example.com'; end
+  def self.embed_by_username; nil; end
+  def self.feed_polling_enabled?; false; end
+end
+
+class TopicEmbed
+  def self.where(*args); FakeRelation.new; end
+  class FakeRelation; def exists?; false; end; end
+  def self.import_remote(*); raise 'should not be reached'; end
+end
+
+class User
+  def self.where(*args); raise 'User.where should not be reached when embed_by_username is nil'; end
+end
+
+begin
+  TopicRetriever.new('http://example.com/foo').retrieve
+  puts 'RESULT: PASS'
+rescue NoMethodError => e
+  if e.message =~ /downcase/
+    puts 'RESULT: FAIL: NoMethodError raised calling downcase on nil SiteSetting.embed_by_username'
+  else
+    puts "RESULT: FAIL: unexpected NoMethodError: #{e.message}"
+  end
+rescue => e
+  puts "RESULT: FAIL: unexpected #{e.class}: #{e.message}"
+end
