@@ -0,0 +1,75 @@
+# frozen_string_literal: true
+require 'digest/sha1'
+require 'cgi'
+require 'stringio'
+require 'open-uri'
+
+# --- Minimal Rails/ActiveSupport stubs so the real file can load ---
+module Kernel
+  def require_dependency(_name); end
+end
+
+$LOADED_FEATURES << 'simple-rss.rb' unless $LOADED_FEATURES.any? { |f| f.to_s.include?('simple-rss') }
+
+class Object
+  def blank?; respond_to?(:empty?) ? !!empty? : false; end
+  def present?; !blank?; end
+end
+class String
+  def blank?; strip.empty?; end
+end
+class NilClass
+  def blank?; true; end
+end
+
+module SimpleRSS
+  Item   = Struct.new(:link, :id, :title, :content)
+  Parsed = Struct.new(:items)
+  ITEM_COUNT = 5_000
+  def self.parse(_io)
+    Parsed.new(Array.new(ITEM_COUNT) { |n|
+      Item.new("http://example.com/item-#{n}", nil, "Title #{n}", "body #{n}")
+    })
+  end
+end
+
+class SiteSetting
+  def self.feed_polling_enabled?; true; end
+  def self.feed_polling_url; 'http://example.com/feed.xml'; end
+  def self.embed_by_username; 'admin'; end
+end
+
+class User
+  def self.where(*); self; end
+  def self.first; new; end
+end
+
+class TopicEmbed
+  IMPORTS = []
+  def self.import(_user, url, _title, _content); IMPORTS << url; end
+end
+
+module Jobs
+  class Scheduled
+    def self.recurrence(&_b); end
+    def self.sidekiq_options(*); end
+  end
+end
+
+# Never hit the network: feed the fake SimpleRSS a fake IO
+def open(_url); StringIO.new('fake feed body'); end
+
+# --- Load the REAL class under test ---
+require File.expand_path('../../app/jobs/scheduled/poll_feed.rb', __dir__)
+
+job = Jobs::PollFeed.new
+job.poll_feed
+
+count = TopicEmbed::IMPORTS.size
+cap   = 100
+
+if count > cap
+  puts "RESULT: FAIL: poll_feed iterated/imported #{count} feed items in a single run with no count cap (cap=#{cap})"
+else
+  puts 'RESULT: PASS'
+end
