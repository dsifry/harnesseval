@@ -0,0 +1,72 @@
+require 'erb'
+require 'cgi'
+
+# --- Minimal shims to run the real Rails view standalone ---
+class EscapableString
+  attr_reader :html
+  def initialize(html); @html = html.to_s; end
+  def to_s; CGI.escapeHTML(@html); end
+end
+
+class SafeString
+  attr_reader :html
+  def initialize(html); @html = html.to_s; end
+  def to_s; @html; end
+end
+
+def raw(x)
+  SafeString.new(x.is_a?(EscapableString) ? x.html : x.to_s)
+end
+
+module I18n
+  def self.t(key); key.to_s; end
+end
+
+module SiteSetting
+  def self.logo_url; 'http://example.com/logo.png'; end
+end
+
+module Discourse
+  def self.base_url; 'http://example.com'; end
+end
+
+def link_to(name, url, opts = {}); "<a href='#{url}'>#{name}</a>"; end
+def image_tag(src, opts = {}); "<img src='#{src}' />"; end
+
+class Array
+  def present?; !empty?; end
+end
+
+UserStub = Struct.new(:small_avatar_url, :username)
+PostStub = Struct.new(:created_at, :url, :user, :cooked)
+TopicStub = Struct.new(:url)
+TopicViewStub = Struct.new(:posts, :topic)
+
+MALICIOUS_HTML = '<script>alert("xss")</script>'
+
+post = PostStub.new(
+  Time.now,
+  'http://example.com/t/1/1',
+  UserStub.new('http://example.com/avatar.png', 'attacker'),
+  EscapableString.new(MALICIOUS_HTML)
+)
+
+@topic_view = TopicViewStub.new([post], TopicStub.new('http://example.com/t/1'))
+
+# --- Load the real view file ---
+view_path = File.join(Dir.pwd, 'app/views/embed/best.html.erb')
+source = File.read(view_path)
+
+# Erubis/Rails ERB trim markers -> plain ERB; normalize a transcription artifact
+source = source.gsub('<%-', '<%')
+source = source.gsub(/<%\s*end\s+if\s*%>/, '<% end %>')
+
+erb = ERB.new(source)
+output = erb.result(binding)
+
+# --- Assertion ---
+if output.include?(MALICIOUS_HTML)
+  puts "RESULT: FAIL: raw post.cooked rendered imported HTML unescaped (XSS)"
+else
+  puts "RESULT: PASS"
+end
