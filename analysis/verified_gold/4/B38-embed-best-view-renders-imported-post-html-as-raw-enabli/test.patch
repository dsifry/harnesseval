require 'erb'

TEMPLATE_PATH = 'app/views/embed/best.html.erb'
PAYLOAD = '<script>alert("xss")</script>'

# --- Minimum stubs so the real template can be evaluated standalone ---
module I18n
  def self.t(key, **_opts); key.to_s; end
end

module SiteSetting
  def self.logo_url; 'https://cdn.example.test/logo.png'; end
end

module Discourse
  def self.base_url; 'https://example.test'; end
end

class FakeUser
  def initialize(name); @name = name; end
  def username; @name; end
  def small_avatar_url; 'https://cdn.example.test/a.png'; end
end

class FakePost
  def initialize(cooked, username); @cooked = cooked; @username = username; end
  def cooked; @cooked; end
  def created_at; Time.at(0); end
  def url; 'https://example.test/p/1'; end
  def user; FakeUser.new(@username); end
end

class Posts
  include Enumerable
  def initialize(list); @list = list; end
  def each(&blk); @list.each(&blk); end
  def present?; !@list.empty?; end
end

class FakeTopic
  def url; 'https://example.test/t/1'; end
end

# Acts as the view context: records any call to raw() and provides the
# helper methods the template invokes.
class RenderContext
  attr_reader :raw_calls
  def initialize(topic_view); @topic_view = topic_view; @raw_calls = []; end
  def raw(value); @raw_calls << value; value.to_s; end
  def link_to(*args, **_opts); "<a>#{args[0]}</a>"; end
  def image_tag(src, **_opts); "<img src='#{src}'>"; end
  def get_binding; binding; end
end

source = File.read(TEMPLATE_PATH)

post = FakePost.new(PAYLOAD, 'alice')
topic_view = FakeTopicView = nil
class FakeTopicView
  attr_reader :posts, :topic
  def initialize(posts, topic); @posts = posts; @topic = topic; end
end

topic_view = FakeTopicView.new(Posts.new([post]), FakeTopic.new)
ctx = RenderContext.new(topic_view)

rendered =
  begin
    ERB.new(source, nil, '-').result(ctx.get_binding)
  rescue SyntaxError
    nil
  end

reason = nil

if rendered
  if ctx.raw_calls.include?(PAYLOAD)
    reason = 'view calls raw() on post.cooked: imported HTML is emitted unescaped'
  elsif rendered.include?(PAYLOAD)
    reason = 'rendered output contains unescaped imported HTML payload'
  end
else
  if source.match?(/raw\s+post\.cooked/)
    reason = 'view source emits raw post.cooked (template did not compile for rendering)'
  end
end

if reason
  puts "RESULT: FAIL: #{reason}"
else
  puts 'RESULT: PASS'
end
