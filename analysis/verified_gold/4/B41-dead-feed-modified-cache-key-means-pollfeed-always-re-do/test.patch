# frozen_string_literal: true
require 'ostruct'
require 'cgi'
require 'digest/sha1'

# --- minimal stubs so the real file loads and runs without Rails -------
def require_dependency(_path); end

class String
  def present?; !empty?; end
  def blank?; empty?; end
end

module Jobs
  class Scheduled
    def self.recurrence(&_blk); end
    def self.sidekiq_options(**_opts); end
  end
end

module SiteSetting
  def self.feed_polling_enabled?; true; end
  def self.feed_polling_url; 'http://example.com/feed.xml'; end
  def self.embed_by_username; 'system'; end
end

class User
  def self.where(_cond); self; end
  def self.first; @u ||= new; end
  def blank?; false; end
end

module SimpleRSS
  def self.parse(_io)
    OpenStruct.new(items: [OpenStruct.new(
      link: 'http://example.com/1',
      id: 'http://example.com/1',
      content: '<p>hello</p>',
      title: 't'
    )])
  end
