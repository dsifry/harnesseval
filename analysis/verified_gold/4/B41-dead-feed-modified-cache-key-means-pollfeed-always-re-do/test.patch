module TopicEmbed
  def self.import(*_args); $imports += 1; end
end

$imports = 0
$opened  = []
# pretend the simple-rss gem is already loaded
$LOADED_FEATURES << 'simple-rss.rb'

# --- load the REAL file under test -------------------------------------
require_relative '../../app/jobs/scheduled/poll_feed.rb'

# intercept Kernel#open so we can observe every download attempt
module Kernel
  alias_method :orig_open_for_poll, :open
  def open(*args)
    $opened << args
    OpenStruct.new(read: '')
  end
  private :open
end

# observe whether the (supposedly dead) feed_key method is ever invoked
$feed_key_calls = 0
module FeedKeyTracker
  def feed_key(*a, &b)
    $feed_key_calls += 1
    super
  end
end
Jobs::PollFeed.prepend(FeedKeyTracker)

# --- exercise the job twice (simulate two hourly runs) -----------------
job = Jobs::PollFeed.new
2.times { job.poll_feed }

defect = $feed_key_calls.zero? && $opened.length == 2 && $imports == 2

if defect
  puts "RESULT: FAIL: feed_key is dead code; poll_feed re-downloaded the feed #{$opened.length} times " \
       "(#{$imports} re-imports, 0 feed_key calls, no conditional GET)"
else
  puts 'RESULT: PASS'
end
