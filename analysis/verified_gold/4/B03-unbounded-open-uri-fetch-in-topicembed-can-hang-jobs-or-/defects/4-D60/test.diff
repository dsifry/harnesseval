# Intercept open() so we can observe the options actually passed by the code.
$open_calls = []
module Kernel
  private
  def open(*args, **kwargs, &_blk)
    $open_calls << [args, kwargs]
    StringIO.new('<rss/>')
  end
  public
end

# Load the REAL file under test with a relative path.
require_relative '../../app/jobs/scheduled/poll_feed.rb'

# Exercise the code path that performs the fetch.
Jobs::PollFeed.new.execute({})

if $open_calls.empty?
  puts 'RESULT: FAIL: poll_feed never invoked open()'
  exit 1
end

timeout_present = $open_calls.any? do |args, kwargs|
  opts = kwargs.dup
  args.each { |a| opts = opts.merge(a) if a.is_a?(Hash) }
  opts.key?(:read_timeout) || opts.key?(:open_timeout) || opts.key?(:timeout)
end

if timeout_present
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: poll_feed calls open() without any timeout/size-cap option: #{$open_calls.inspect}"
end
