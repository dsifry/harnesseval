# ActiveSupport-ish string helpers
class String
  def present?; !empty?; end
  def blank?; empty?; end
end

# require_dependency is provided by ActiveSupport in Rails; no-op here.
def require_dependency(*); end

# Avoid loading the real simple-rss gem; the code under test only needs the constant.
module Kernel
  alias_method :__orig_require, :require unless method_defined?(:__orig_require)
  def require(name)
    return true if name.to_s == 'simple-rss'
    __orig_require(name)
  end
end

