require 'digest'

module ActiveRecord
  class Base
    def self.belongs_to(*); end
    def self.validates_presence_of(*); end
  end
end

module I18n
  def self.t(*); 'translated'; end
end

module Kernel
  def require_dependency(*); end
end

require_relative '../../app/models/topic_embed'

$captured_open = nil

module Kernel
  alias_method :__real_require, :require
  def require(name)
    return true if name == 'ruby-readability'
    __real_require(name)
  end

  alias_method :__real_open, :open
  def open(*args, **kwargs)
    $captured_open = { args: args, kwargs: kwargs }
    raise "STOP_AFTER_OPEN"
  end
end

module Readability
  class Document
    def initialize(*); end
    def title; 't'; end
    def content; 'c'; end
  end
end

begin
  TopicEmbed.send(:import_remote, nil, 'http://slow.example.com/big')
rescue RuntimeError => e
  raise unless e.message == "STOP_AFTER_OPEN"
end

if $captured_open.nil?
  puts "RESULT: FAIL: open() was never invoked; could not observe fetch"
  exit 1
end

args   = $captured_open[:args]
kwargs = $captured_open[:kwargs]
pos_opts = args.last.is_a?(Hash) ? args.last : {}
opts = pos_opts.merge(kwargs)

has_timeout = opts.key?(:read_timeout) || opts.key?(:open_timeout) || opts.key?(:timeout)
has_size_cap = opts.key?(:content_length_proc) || opts.key?(:size_limit) ||
               opts.key?(:limit) || opts.key?(:max_size) || opts.key?(:max_length)

if has_timeout || has_size_cap
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: open-uri fetch has no timeout or size cap (args=#{args.inspect}, opts=#{opts.inspect})"
end
