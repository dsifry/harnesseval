require 'ostruct'

module Discourse
  class InvalidAccess < StandardError; end
end

class SiteSetting
  def self.embeddable_host
    'example.com'
  end
end

class Jobs
  @enqueued = []
  class << self
    attr_accessor :enqueued
    def enqueue(*args)
      @enqueued << args
    end
    def reset!
      @enqueued = []
    end
  end
end

class TopicEmbed
  def self.topic_id_for_embed(embed_url)
    raise TypeError, "no implicit conversion of #{embed_url.class} into String" unless embed_url.is_a?(String)
    nil
  end
end

class TopicView
  def initialize(*); end
end

class ApplicationController
  def self.skip_before_filter(*); end
  def self.before_filter(*); end
  def self.layout(*); end

  def params
    @params
  end

  def params=(p)
    @params = p
  end

  def response
    @response ||= OpenStruct.new(headers: {})
  end

  def current_user
    nil
  end

  def discourse_expires_in(*); end

  def render(*); end

  def request
    @request ||= OpenStruct.new(referer: 'http://example.com')
  end
end

class Integer
  def minute
    self
  end
end

class NilClass
  def try(*); nil; end
end

class FakeParams
  def initialize(h)
    @h = h
  end

  def require(key)
    @h[key]
  end
end

require_relative '../../app/controllers/embed_controller'

controller = EmbedController.new
controller.params = FakeParams.new({ embed_url: ['http://example.com/t/1'] })

begin
  controller.best
rescue TypeError => e
  puts "RESULT: FAIL: non-String embed_url caused unrescued TypeError: #{e.message}"
  exit
rescue => e
  puts "RESULT: FAIL: unexpected error: #{e.class}: #{e.message}"
  exit
end

if Jobs.enqueued.any?
  embed_url = Jobs.enqueued.last[1][:embed_url]
  if embed_url.is_a?(String)
    puts "RESULT: PASS"
  else
    puts "RESULT: FAIL: enqueued job with non-String embed_url: #{embed_url.inspect} (#{embed_url.class})"
  end
else
  puts "RESULT: PASS"
end
