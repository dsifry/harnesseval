module Discourse
  def self.anonymous_filters; ["latest"]; end
  def self.filters; ["latest", "hot"]; end

  class Application
    def self.routes
      @routes ||= ActionDispatch::Routing::RouteSet.new
    end
  end
end

require_relative "../../config/routes"

route_set  = Discourse::Application.routes
all_routes = route_set.routes.to_a

def spec_of(route)
  p = route.path
  p.respond_to?(:spec) ? p.spec.to_s : p.to_s
end

embed = all_routes.find { |r| spec_of(r).start_with?("/embed/best") }

defects = []

if embed.nil?
  defects << "route /embed/best not found"
else
  name = embed.name
  defects << "unnamed route (no URL helper)" if name.nil? || name.to_s.empty?

  begin
    recognized = route_set.recognize_path("/embed/best.json", method: "GET")
    if recognized.is_a?(Hash) && recognized[:format].to_s == "json"
      defects << "/embed/best.json matches (unconstrained format)"
    end
  rescue StandardError
  end
end

unless route_set.url_helpers.respond_to?(:embed_best_path)
  defects << "no embed_best_path URL helper"
end

if defects.empty?
  puts "RESULT: PASS"
else
  puts "RESULT: FAIL: #{defects.uniq.join('; ')}"
end
