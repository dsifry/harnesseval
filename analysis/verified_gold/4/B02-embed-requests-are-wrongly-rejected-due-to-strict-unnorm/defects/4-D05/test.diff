class SiteSetting
  class << self
    attr_accessor :embeddable_host
  end
end

# --- Load the REAL file under test (the only real logic exercised) ---
require_relative '../../app/controllers/embed_controller.rb'

# --- Exercise the private access-control gate ---
SiteSetting.embeddable_host = 'example.com'

def gate_result(referer)
  controller = EmbedController.new
  controller.request.referer = referer
  controller.send(:ensure_embeddable)
  :allowed
rescue Discourse::InvalidAccess
  :denied
end

legit         = gate_result('http://example.com/article')
port_bypass   = gate_result('http://example.com:9999/article')
scheme_bypass = gate_result('https://example.com/article')

unless legit == :allowed
  puts "RESULT: FAIL: legitimate embeddable host referer was rejected"
  exit 0
end

if port_bypass == :allowed
  puts "RESULT: FAIL: host-only comparison accepted http://example.com:9999 as a valid embeddable origin"
elsif scheme_bypass == :allowed
  puts "RESULT: FAIL: host-only comparison ignored scheme (accepted https instead of http)"
else
  puts "RESULT: PASS"
end
