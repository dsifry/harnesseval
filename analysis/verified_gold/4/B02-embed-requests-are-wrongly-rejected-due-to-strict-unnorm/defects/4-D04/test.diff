module Jobs
  @enqueued = []
  def self.enqueue(*args)
    @enqueued << args
  end
  def self.enqueued; @enqueued; end
  def self.clear; @enqueued = []; end
end

class FakeParams
  def initialize(h); @h = h; end
  def require(key)
    @h.fetch(key) { raise "missing key #{key}" }
  end
end

# Load the real file under test
require_relative '../../app/controllers/embed_controller'

# --- Test ---
begin
  controller = EmbedController.new
  controller.params = FakeParams.new(embed_url: 'http://evil.com/secret')
  controller.request = Struct.new(:referer).new('http://example.com/page')

  # Simulate the before_filter :ensure_embeddable
  controller.send(:ensure_embeddable)

  Jobs.clear

  # Call the action twice with the same uncached embed_url
  controller.best
  controller.best

  enqueued = Jobs.enqueued.select { |args| args.first == :retrieve_topic }
  if enqueued.size == 2
    puts "RESULT: FAIL: retrieval job enqueued on every request without throttle/dedupe"
  else
    puts "RESULT: PASS"
  end
rescue => e
  puts "RESULT: FAIL: #{e.message}"
end
