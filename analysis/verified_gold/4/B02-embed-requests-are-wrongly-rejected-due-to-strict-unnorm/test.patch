require 'uri'

# --- minimal stubs so the REAL controller can be loaded without Rails ---
class Object
  def blank?
    respond_to?(:empty?) ? !!empty? : !self
  end
end

module Discourse
  class InvalidAccess < StandardError; end
end

class ApplicationController
  def self.skip_before_filter(*); end
  def self.before_filter(*); end
  def self.layout(*); end
  attr_accessor :request, :response
end

class FakeRequest
  attr_accessor :referer
  def initialize(referer); @referer = referer; end
end

class FakeResponse
  attr_reader :headers
  def initialize; @headers = {}; end
end

module SiteSetting
  class << self; attr_accessor :embeddable_host; end
end
SiteSetting.embeddable_host = 'example.com'

module Jobs
  def self.enqueue(*); end
end

class TopicEmbed
  def self.topic_id_for_embed(*); end
end

class TopicView
  def initialize(*); end
end

# --- load the code under test (the only real logic exercised) ---
require_relative '../../app/controllers/embed_controller'

def attempt(referer)
  c = EmbedController.new
  c.request  = FakeRequest.new(referer)
  c.response = FakeResponse.new
  c.send(:ensure_embeddable)
  :accepted
rescue Discourse::InvalidAccess => e
  [:rejected, e.message]
end

SiteSetting.embeddable_host = 'example.com'

missing = attempt(nil)
valid   = attempt('https://example.com/t/hello')

puts "Referer=nil                  -> #{missing.inspect}"
puts "Referer=example.com/t/hello  -> #{valid.inspect}"

if missing.is_a?(Array) && missing.first == :rejected
  puts "RESULT: FAIL: embed request without a Referer header is wrongly rejected (#{missing.last}); " \
       "ensure_embeddable requires a Referer and does a strict URI.host == embeddable_host check."
else
  puts "RESULT: PASS"
end
