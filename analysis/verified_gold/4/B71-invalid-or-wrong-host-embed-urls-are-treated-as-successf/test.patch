# Load the real class under test.
require_relative '../../lib/topic_retriever'

# Exercise the claimed defect path.
reasons = []
defect = false

[
  ['malformed', 'ht!tp://not a url'],
  ['wrong-host', 'http://evil.example.com/embed/123']
].each do |label, url|
  retriever = TopicRetriever.new(url)
  error = nil
  begin
    result = retriever.retrieve
  rescue => e
    error = e
  end

  if error.nil?
    defect = true
    reasons << "#{label} (#{url.inspect}) returned #{result.inspect} without raising"
  end
end

if defect
  puts "RESULT: FAIL: #{reasons.join('; ')} -- invalid input is treated as successful retrieval, so the controller reloads the loading page instead of returning 4xx"
else
  puts 'RESULT: PASS'
end
