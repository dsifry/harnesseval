# frozen_string_literal: true

# Standalone regression test for:
#   db/migrate/20131219203905_add_cook_method_to_posts.rb
#
# Claim: the migration adds posts.cook_method with `default: 1` (the rawhtml
# enum value), causing existing and ordinary new posts to bypass cooking and
# sanitization and render user-supplied raw content directly.

RECORDED_CALLS = []

module ActiveRecord
  class Migration
    def add_column(table_name, column_name, type, options = {})
      RECORDED_CALLS << {
        table: table_name,
        column: column_name,
        type: type,
        options: options
      }
    end
  end
end

# Load the REAL migration file. Do NOT redefine the class under test here.
require_relative '../../db/migrate/20131219203905_add_cook_method_to_posts.rb'

def fail_with(reason)
  puts "RESULT: FAIL: #{reason}"
  exit 0
end

unless defined?(AddCookMethodToPosts) && AddCookMethodToPosts.is_a?(Class)
  fail_with('AddCookMethodToPosts was not defined by the real migration file')
end

AddCookMethodToPosts.new.change

unless RECORDED_CALLS.length == 1
  fail_with("expected exactly one add_column call, got #{RECORDED_CALLS.length}")
end

call = RECORDED_CALLS.first
opts = call[:options] || {}

# The rawhtml cook method in this migration has enum value 1. If the migration
# sets that as the default, every existing and new post bypasses cooking.
if opts[:default] == 1
  fail_with(
    'migration defaults posts.cook_method to 1 (rawhtml), causing all ' \
    'existing/new posts to bypass cooking/sanitization'
  )
end

puts 'RESULT: PASS'
