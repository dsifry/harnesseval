require 'erb'

module SiteSetting
  def self.logo_url; 'logo.png'; end
end

module Discourse
  def self.base_url; 'http://example.com'; end
end

class FakeView
  def t(key); key.to_s; end
  def link_to(body, url); "<a href='#{url}'>#{body}</a>"; end
  def image_tag(src, options = {}); "<img src='#{src}' class='#{options[:class]}' />"; end
end

real_path = File.expand_path('../../app/views/embed/loading.html.erb', __dir__)
template = File.read(real_path)

view = FakeView.new
html = ERB.new(template).result(view.instance_eval { binding })

if html =~ /setTimeout\s*\(\s*function\s*\(\s*\)\s*\{\s*document\.location\.reload\(\);\s*\}\s*,\s*30000\s*\)/
  puts "RESULT: FAIL: loading page auto-reloads every 30s, amplifying unauthenticated request/job flooding risk"
else
  puts "RESULT: PASS"
end
