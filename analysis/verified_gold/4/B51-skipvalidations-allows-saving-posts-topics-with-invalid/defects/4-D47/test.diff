# A fake post that records the validate: flag passed to #save and, when
# validate: true, rejects nil/blank raw content (simulating AR validations).
class FakePost
  attr_accessor :raw, :word_count, :last_editor_id, :acting_user, :edit_reason,
                :hidden, :hidden_reason_id, :topic, :topic_id, :post_number,
                :last_version_at, :version, :invalidate_oneboxes
  attr_reader :cooked, :saved, :last_validate_flag

  def initialize
    @raw = "initial raw"
    @cooked = "<p>hi</p>"
    @post_number = 2
    @topic_id = 99
    @last_editor_id = 1
    @last_version_at = Time.now
    @version = 1
    @hidden = false
    @hidden_reason_id = nil
    @saved = nil
    @last_validate_flag = :never
  end

  def advance_draft_sequence; end
  def extract_quoted_post_numbers; end
  def save_reply_relationships; end
  def trigger_post_process; end

  def save(validate: true)
    @last_validate_flag = validate
    @saved = if validate
               !(@raw.nil? || @raw.strip.empty?)
             else
               true
             end
  end
end

user = Struct.new(:id).new(1)

# Case 1: attacker-triggered import passes skip_validations: true and a blank raw.
post_with_skip = FakePost.new
PostRevisor.new(post_with_skip).revise!(user, "", skip_validations: true)

# Case 2: control - no skip_validations option, validations must run.
post_no_skip = FakePost.new
PostRevisor.new(post_no_skip).revise!(user, "")

bypass_observed  = post_with_skip.saved == true && post_with_skip.last_validate_flag == false
validation_works = post_no_skip.saved == false && post_no_skip.last_validate_flag == true

if bypass_observed && validation_works
  puts "RESULT: FAIL: skip_validations: true persisted blank raw content " \
       "(save called with validate: false), bypassing all AR validations"
else
  puts "RESULT: PASS"
end
