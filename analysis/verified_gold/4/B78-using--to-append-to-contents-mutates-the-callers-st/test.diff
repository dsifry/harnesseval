--- /dev/null
+++ b/spec/verify/topic_embed_verify.rb
@@ -0,0 +1,94 @@
+require 'digest'
+require 'uri'
+
+def require_dependency(name); end
+
+module I18n
+  def self.t(key, opts = {}); "imported from"; end
+end
+
+class NilClass
+  def blank?; true; end
+end
+
+class Object
+  def present?; true; end
+end
+
+class FakeRelation
+  def first; nil; end
+end
+
+module ActiveRecord
+  class Base
+    def self.belongs_to(*); end
+    def self.validates_presence_of(*); end
+    def self.where(*); FakeRelation.new; end
+    def self.create!(*); true; end
+    def self.update_column(*); true; end
+  end
+end
+
+class Topic
+  def self.transaction; yield; end
+end
+
+class Post
+  def self.cook_methods; { raw_html: 1 }; end
+end
+
+class PostCreator
+  def initialize(user, *args, **opts); end
+  def create
+    p = Post.new
+    def p.topic_id; 1; end
+    def p.id; 1; end
+    p
+  end
+end
+
+class PostRevisor
+  def initialize(post); end
+  def revise!(*); true; end
+end
+
+module Nokogiri
+  module HTML
+    class Fragment
+      def css(sel); []; end
+      def to_html; ""; end
+    end
+    def self.fragment(html); Fragment.new; end
+  end
+end
+
+require File.expand_path('../../app/models/topic_embed', __dir__)
+
+frozen = "hello world".freeze
+raised = nil
+begin
+  TopicEmbed.import(nil, "http://example.com/a", "Title", frozen)
+rescue => e
+  raised = e
+end
+
+if raised
+  puts "RESULT: FAIL: `contents << ...` raised #{raised.class}: #{raised.message} when passed a frozen String"
+else
+  caller_str = +"hello world"
+  caller_before = caller_str.dup
+  imp_err = nil
+  begin
+    TopicEmbed.import(nil, "http://example.com/a", "Title", caller_str)
+  rescue => e
+    imp_err = e
+  end
+
+  if imp_err
+    puts "RESULT: FAIL: unexpected error on non-frozen input: #{imp_err.class}: #{imp_err.message}"
+  elsif caller_str != caller_before
+    puts "RESULT: FAIL: caller's String was mutated by `contents <<` (now: #{caller_str.inspect})"
+  else
+    puts "RESULT: PASS"
+  end
+end
