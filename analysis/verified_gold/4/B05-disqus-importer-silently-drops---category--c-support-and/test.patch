# frozen_string_literal: true
# Standalone regression test for lib/tasks/disqus.thor --category/-c option.

# Stub nokogiri so the .thor file can be loaded without the gem.
module Kernel
  alias_method :__orig_require, :require unless method_defined?(:__orig_require)
  def require(name)
    return false if name == 'nokogiri'
    __orig_require(name)
  end
end

module Nokogiri
  module XML
    module SAX
      class Document; end
      class Parser; end
    end
  end
end

# Minimal Thor stub capturing declared method_options.
class Thor
  def self.desc(*); end
  def self.method_option(name, opts = {})
    @captured_options ||= {}
    @captured_options[name.to_sym] = opts
  end
  def self.captured_options
    @captured_options ||= {}
  end
end

begin
  require File.expand_path('lib/tasks/disqus.thor', Dir.pwd)
rescue LoadError => e
  puts "RESULT: FAIL: could not load lib/tasks/disqus.thor: #{e.message}"
  exit 0
end

opts = Disqus.captured_options

if opts.key?(:category)
  aliases = Array(opts[:category][:aliases]).join(' ')
  if aliases.split(/[ ,]+/).include?('-c')
    puts "RESULT: PASS"
  else
    puts "RESULT: FAIL: --category option declared but -c alias missing"
  end
else
  puts "RESULT: FAIL: import task no longer declares the --category/-c option (silent regression)"
end
