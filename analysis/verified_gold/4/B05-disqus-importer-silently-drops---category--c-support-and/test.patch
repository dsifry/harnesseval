$LOADED_FEATURES << 'nokogiri.rb'
module Kernel
  alias_method :__orig_require, :require unless method_defined?(:__orig_require)
  def require(name)
    return true if name == 'nokogiri'
    __orig_require(name)
  end
end

module Nokogiri
  module XML
    module SAX
      class Document; end
      class Parser
        def initialize(doc); @doc = doc; end
        def parse_file(path); end
      end
    end
  end
end

class Thor
  def self.method_option_store
    @method_option_store ||= {}
  end
  def self.method_options
    method_option_store
  end
  def self.desc(*); end
  def self.method_option(name, opts = {})
    method_option_store[name] = opts
  end
end

begin
  require_relative '../../lib/tasks/disqus.thor'
rescue LoadError => e
  puts "RESULT: FAIL: could not load lib/tasks/disqus.thor: #{e.message}"
  exit
end

opts = Disqus.method_options
cat = opts[:category]
alias_ok = cat && Array(cat[:aliases]).any? { |a| a.to_s == '-c' }

# Defect proof at the observable API surface: Thor exposes declared options as
# class-level metadata, so an existing automation script invoking
# `thor disqus:import -c 5` would be rejected if :category is not declared.
if cat.nil?
  puts "RESULT: FAIL: --category/-c option was removed from the Disqus import task; imported topics cannot be assigned to a requested category"
elsif !alias_ok
  puts "RESULT: FAIL: --category option is declared but the -c alias is missing"
else
  puts "RESULT: PASS"
end
