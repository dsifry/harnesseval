begin
  rel = ['../../lib/tasks/disqus.thor',
         '../../lib/tasks/disqus.rake',
         '../../script/disqus.thor'].find { |r| File.exist?(File.expand_path(r, __dir__)) }
  raise LoadError, 'real disqus task file not found' unless rel
  require_relative rel

  MALICIOUS = 'file:///etc/passwd'
  File.define_singleton_method(:exist?) { |_p| true }
  Disqus.new(file: 'x.xml', post_as: 'admin', dry_run: nil, strip: nil).import

  if TopicEmbed.received_url == MALICIOUS
    puts "RESULT: FAIL: import_remote received unvalidated link #{TopicEmbed.received_url.inspect}"
  else
    puts 'RESULT: PASS'
  end
rescue Exception => e
  puts "RESULT: FAIL: #{e.class}: #{e.message}"
end
