require 'date'

# ---- stubs so lib/tasks/disqus.thor loads without Rails ----
module Kernel
  alias_method :__orig_require, :require
  def require(name)
    n = name.to_s
    return false if n == './config/environment' || n == 'nokogiri'
    __orig_require(name)
  end
end

module Nokogiri
  module XML
    module SAX
      class Document; end
      class Parser
        def initialize(doc); @doc = doc; end
        def parse_file(_path)
          # thread definition so @threads['t1'] exists
          @doc.start_element('thread', [['dsq:id', 't1']])
          @doc.start_element('link', [])
          @doc.characters('file:///etc/passwd')
          @doc.end_element('link')
          @doc.start_element('title', [])
          @doc.characters('Evil Thread')
          @doc.end_element('title')
          @doc.end_element('thread')

          # post that references the thread; start_element('thread') appends it
          @doc.start_element('post', [['dsq:id', 'p1']])
          @doc.start_element('createdAt', [])
          @doc.characters('2015-01-01T00:00:00')
          @doc.end_element('createdAt')
          @doc.start_element('message', [])
          @doc.cdata_block('hello world')
          @doc.end_element('message')
          @doc.start_element('thread', [['dsq:id', 't1']])
          @doc.end_element('thread')
          @doc.end_element('post')
        end
      end
    end
  end
end

class Thor
  def self.desc(*); end
  def self.method_option(*); end
  def initialize(opts = {}); @options = opts; end
  attr_reader :options
end

class Object
  def blank?
    respond_to?(:empty?) ? !!empty? : !self
  end
  def present?
    !blank?
  end
end

class FakePost
  attr_reader :topic_id, :topic, :post_number
  def initialize(topic_id, topic, post_number)
    @topic_id, @topic, @post_number = topic_id, topic, post_number
  end
  def present?; true; end
end

class TopicEmbed
  def self.received_url; @received_url; end
  def self.import_remote(_user, url, _opts = {})
    @received_url = url
    FakePost.new(1, Object.new, 1)
  end
end

class PostCreator
