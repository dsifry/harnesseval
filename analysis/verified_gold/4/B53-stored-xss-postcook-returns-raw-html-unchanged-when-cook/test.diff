+module Trashable; end
+class PostAnalyzer; def initialize(*a); end; def cook(*a); end; end
+module Validators; class PostValidator; end; end
+module Plugin
+  module Filter
+    def self.apply(*a); a.last; end
+  end
+end
+module Archetype; end
+
+class Enum
+  def self.new(*args)
+    h = {}
+    args.each_with_index { |a, i| h[a] = i }
+    h
+  end
+end
+
+module ActiveRecord
+  class Base
+    def self.belongs_to(*a); end
+    def self.has_many(*a); end
+    def self.has_one(*a); end
+    def self.scope(*a, &b); end
+    def self.validates_with(*a); end
