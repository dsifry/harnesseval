require 'erb'

path = File.expand_path('../../app/views/layouts/embed.html.erb', __FILE__)
abort "File not found: #{path}" unless File.exist?(path)

class FakeRequest
  attr_reader :referer
  def initialize(referer)
    @referer = referer
  end
end

def render_template(path, referer)
  template = ERB.new(File.read(path))
  mod = Module.new
  template.def_method(mod, :render)
  context = Object.new
  context.extend(mod)
  context.instance_variable_set(:@request, FakeRequest.new(referer))
  def context.stylesheet_link_tag(*); ""; end
  def context.request; @request; end
  context.render { "" }
end

referer = "http://example.com/\\"
rendered = render_template(path, referer)

if rendered.include?("'#{referer}'")
  puts "RESULT: FAIL: referer interpolated raw into JS string literal; backslash escapes closing quote and breaks postMessage targetOrigin"
else
  puts "RESULT: PASS"
end
