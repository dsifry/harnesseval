diff --git a/spec/verify/embed.html_verify.rb b/spec/verify/embed.html_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/embed.html_verify.rb
@@ -0,0 +1,43 @@
+require 'erb'
+
+class HtmlEscapedReferer
+  def initialize(raw)
+    @raw = raw
+  end
+  def to_s
+    ERB::Util.html_escape(@raw)
+  end
+end
+
+class StubView
+  def initialize(referer)
+    @referer = referer
+  end
+  def stylesheet_link_tag(name)
+    "<!-- #{name} -->"
+  end
+  def request
+    @request ||= Struct.new(:referer).new(HtmlEscapedReferer.new(@referer))
+  end
+end
+
+template_path = File.expand_path('../../app/views/layouts/embed.html.erb', __dir__)
+source = File.read(template_path)
+source = source.sub(/<%= yield %>/, '<%= "stubbed body" %>')
+
+referer = "https://example.com/foo\\"
+view = StubView.new(referer)
+erb = ERB.new(source)
+html = erb.result(view.instance_eval { binding })
+
+if html =~ /parent\.postMessage\(\{[^}]*\},\s*'([^']*)'\);/m
+  literal = $1
+  trailing_backslashes = literal[/\\+\z/]&.length || 0
+  if trailing_backslashes.odd?
+    puts "RESULT: FAIL: request.referer ends with an unescaped backslash that escapes the closing quote of the JS string literal, making the postMessage call syntactically invalid and silently breaking iframe auto-resize."
+  else
+    puts "RESULT: PASS"
+  end
+else
+  puts "RESULT: FAIL: could not locate postMessage targetOrigin in rendered template"
+end
