require 'uri'
require 'digest'
require 'nokogiri'

def require_dependency(name); require name; end

module ActiveRecord
  class Base
    def self.belongs_to(*a); end
    def self.validates_presence_of(*a); end
    def self.where(*a); self; end
    def self.pluck(*a); []; end
    def self.first; nil; end
    def self.create!(*a); end
    def self.transaction; yield; end
  end
end

module I18n
  def self.t(*a); ''; end
end

class Object
  def present?; !blank?; end
  def blank?; respond_to?(:empty?) ? !!empty? : !self; end
end
class NilClass; def blank?; true; end; end

require_relative '../../app/models/topic_embed.rb'

checks = []

out = TopicEmbed.absolutize_urls('http://host:443/a/b', '<a href="/foo">x</a>')
checks << ['http://host:443 must keep port 443', out.include?('http://host:443/foo')]

out2 = TopicEmbed.absolutize_urls('https://host:80/a', '<a href="/bar">x</a>')
checks << ['https://host:80 must keep port 80', out2.include?('https://host:80/bar')]

out3 = TopicEmbed.absolutize_urls('http://host:443/a', '<img src="/pic.png">')
checks << ['img http:443 must keep port 443', out3.include?('http://host:443/pic.png')]

out4 = TopicEmbed.absolutize_urls('https://host:80/a', '<img src="/pic2.png">')
checks << ['img https:80 must keep port 80', out4.include?('https://host:80/pic2.png')]

failures = checks.reject { |_, ok| ok }.map { |n, _| n }
if failures.empty?
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: #{failures.join('; ')}"
end
