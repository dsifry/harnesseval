diff --git a/spec/verify/topic_embed_verify.rb b/spec/verify/topic_embed_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/topic_embed_verify.rb
@@ -0,0 +1,52 @@
+require 'digest'
+require 'uri'
+require 'nokogiri'
+
+module I18n
+  def self.t(*args); args.first; end
+end
+
+module ActiveRecord
+  class Base
+    def self.belongs_to(*); end
+    def self.validates_presence_of(*); end
+    def self.where(*); end
+  end
+end
+
+class String
+  def present?; !empty?; end
+end
+class NilClass
+  def present?; false; end
+end
+
+def require_dependency(name)
+  require name
+end
+
+require File.expand_path('../../app/models/topic_embed', __dir__)
+
+begin
+  article_url = "http://example.com/article"
+  html = '<a href="//cdn.example.com/img.png">link</a><img src="//cdn.example.com/photo.jpg">'
+
+  result = TopicEmbed.absolutize_urls(article_url, html)
+  frag = Nokogiri::HTML.fragment(result)
+  a_href = frag.css('a').first['href']
+  img_src = frag.css('img').first['src']
+
+  accepted_a = ["//cdn.example.com/img.png", "http://cdn.example.com/img.png", "https://cdn.example.com/img.png"]
+  accepted_img = ["//cdn.example.com/photo.jpg", "http://cdn.example.com/photo.jpg", "https://cdn.example.com/photo.jpg"]
+
+  if accepted_a.include?(a_href) && accepted_img.include?(img_src)
+    puts "RESULT: PASS"
+  else
+    msgs = []
+    msgs << "a[href] was #{a_href.inspect}" unless accepted_a.include?(a_href)
+    msgs << "img[src] was #{img_src.inspect}" unless accepted_img.include?(img_src)
+    puts "RESULT: FAIL: protocol-relative URLs were rewritten to the article host: #{msgs.join('; ')}"
+  end
+rescue => e
+  puts "RESULT: FAIL: #{e.class}: #{e.message}"
+end
