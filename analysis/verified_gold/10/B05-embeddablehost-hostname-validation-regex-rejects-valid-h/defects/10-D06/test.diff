require 'uri'

class Object
  def present?
    !nil? && (respond_to?(:empty?) ? !empty? : true)
  end
end

module ActiveRecord
  class Base
    def self.validates_format_of(*args); end
    def self.belongs_to(*args); end

    def self.before_validation(&block)
      (@before_validation_blocks ||= []) << block
    end

    def self.before_validation_blocks
      @before_validation_blocks || []
    end

    def self.all_records
      @all_records ||= []
    end

    def self.create(attrs = {})
      record = new(attrs)
      record.run_before_validation
      all_records << record
      record
    end

    def self.where(condition, value)
      matching = all_records.select { |r| r.host.to_s.downcase == value.to_s.downcase }
      WhereProxy.new(matching)
    end

    def initialize(attrs = {})
      attrs.each { |k, v| instance_variable_set("@#{k}", v) }
    end

    def run_before_validation
      self.class.before_validation_blocks.each { |b| instance_eval(&b) }
    end

    def host
      @host
    end

    def host=(v)
      @host = v
    end

    class WhereProxy
      def initialize(records)
        @records = records
      end

      def first
        @records.first
      end
    end
  end
end

require_relative '../../app/models/embeddable_host.rb'

EmbeddableHost.all_records.clear

EmbeddableHost.create(host: 'http://example.com:8080/some/path')

stored = EmbeddableHost.all_records.first
unless stored && stored.host == 'example.com:8080'
  puts "RESULT: FAIL: setup failed, stored host is #{stored&.host.inspect}"
  exit 0
end

result = EmbeddableHost.record_for_host('http://example.com:8080/some/path')

if result.nil?
  puts "RESULT: FAIL: stored port-qualified host (example.com:8080) never matches; record_for_host drops port via uri.host"
else
  puts "RESULT: PASS"
end