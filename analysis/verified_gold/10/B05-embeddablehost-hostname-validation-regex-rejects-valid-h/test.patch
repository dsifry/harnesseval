# spec/verify/embeddable_host_verify.rb
require 'uri'

# Minimal stub for ActiveRecord::Base so the real model can load without Rails.
module ActiveRecord
  class Base
    attr_accessor :host

    class << self
      def validations
        @validations ||= []
      end

      def validates_format_of(attr, options)
        validations << [attr, options.fetch(:with)]
      end

      def belongs_to(*); end

      def before_validation(&block)
        (@before_validation_callbacks ||= []) << block
      end

      def before_validation_callbacks
        @before_validation_callbacks ||= []
      end
    end

    def valid?
      self.class.before_validation_callbacks.each { |cb| instance_eval(&cb) }
      self.class.validations.all? do |attr, regex|
        value = send(attr)
        value.is_a?(String) && value =~ regex
      end
    end
  end
end

# Load the real file under test.
require_relative '../../app/models/embeddable_host'

# Sanity: a conventional hostname must still pass the stubbed validations.
sanity = EmbeddableHost.new
sanity.host = 'example.com'
raise 'Harness error: example.com should be valid' unless sanity.valid?

# The claimed defect: a hostname with a gTLD longer than 5 characters.
subject = EmbeddableHost.new
subject.host = 'example.photography'

if subject.valid?
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: EmbeddableHost rejects 'example.photography' because its TLD is longer than 5 characters"
end
