diff --git a/spec/verify/routes_verify.rb b/spec/verify/routes_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/routes_verify.rb
@@ -0,0 +1,62 @@
+require 'pathname'
+
+root            = Pathname.new(Dir.pwd)
+routes_path     = root.join('config/routes.rb')
+controller_candidates = [
+  root.join('app/controllers/admin/embeddable_hosts_controller.rb'),
+  root.join('app/controllers/admin/embeddablehosts_controller.rb')
+]
+
+abort 'config/routes.rb not found' unless routes_path.file?
+src = routes_path.read
+
+# --- locate the REST declaration(s) for embeddable_hosts -------------------
+decl_lines = []
+src.each_line.with_index(1) do |line, no|
+  decl_lines << [no, line] if line =~ /\bresources\s+:embeddable_hosts\b/
+end
+
+if decl_lines.empty?
+  puts 'RESULT: PASS'
+  exit
+end
+
+REST = %i[index show new edit create update destroy]
+
+# --- compute which actions the declaration actually routes -----------------
+routed = decl_lines.flat_map do |_no, line|
+  only   = line[/only:\s*\[([^\]]*)\]/m, 1]
+  except = line[/except:\s*\[([^\]]*)\]/m, 1]
+  if only
+    only.scan(/:(\w+)/).flatten.map(&:to_sym)
+  elsif except
+    REST - except.scan(/:(\w+)/).flatten.map(&:to_sym)
+  else
+    REST
+  end
+end.uniq
+
+# --- discover what the controller actually implements ----------------------
+controller_path = controller_candidates.find(&:file?)
+implemented = []
+if controller_path
+  implemented = controller_path.read.scan(/^\s*def\s+([a-zA-Z_]\w*[!?]?)/)
+                 .flatten.map(&:to_sym)
+end
+
+# --- the claimed defect: read-only HTML actions routed but not implemented --
+missing = routed.select { |a| %i[index show new edit].include?(a) } - implemented
+
+if missing.any?
+  puts "route declaration(s) at line(s): #{decl_lines.map { |n, _| n }.join(', ')}"
+  puts "routed actions:     #{routed.inspect}"
+  puts "controller:         #{controller_path || '<admin/embeddable_hosts_controller.rb missing>'}"
+  puts "implemented:        #{implemented.inspect}"
+  puts "RESULT: FAIL: resources :embeddable_hosts routes #{missing.inspect} " \
+       'but Admin::EmbeddableHostsController does not implement them ' \
+       '(ActionNotFound / 500 on direct GET)'
+else
+  puts "routed actions: #{routed.inspect}"
+  puts "implemented:    #{implemented.inspect}"
+  puts 'RESULT: PASS'
+end
