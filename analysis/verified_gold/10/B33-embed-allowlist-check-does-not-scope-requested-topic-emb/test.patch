require 'uri'

module Discourse
  class InvalidAccess < StandardError; end
end unless defined?(Discourse::InvalidAccess)

class FakeEnv
  def development?; false; end
end

module Rails
  def self.env
    @env ||= FakeEnv.new
  end
end unless defined?(Rails)

class ApplicationController
  def self.skip_before_filter(*); end
  def self.before_filter(*); end
  def self.layout(*); end
  def current_user; nil; end
end

class TopicEmbed
  def self.topic_id_for_embed(_u); nil; end
end

class TopicView
  def initialize(*); end
end

module Jobs
  def self.enqueue(*); end
end

class SiteSetting
  def self.embed_post_limit; 3; end
end

class EmbeddableHost
  ALLOWED_HOSTS = { 'a.com' => 1 }.freeze
  HOSTS_BY_TOPIC = { 123 => 'b.com' }.freeze

  def self.host_allowed?(referer)
    return false unless referer
    uri = URI.parse(referer) rescue nil
    uri ? ALLOWED_HOSTS.key?(uri.host) : false
  end

  def self.topic_scope_ok?(topic_id, referer)
    return true if topic_id.nil?
    uri = URI.parse(referer) rescue nil
    return false unless uri
    HOSTS_BY_TOPIC[topic_id] == uri.host
  end
end

require_relative '../../app/controllers/embed_controller'

class FakeRequest
  attr_reader :referer
  def initialize(referer); @referer = referer; end
end

class FakeResponse
  attr_reader :headers
  def initialize; @headers = {}; end
end

controller = EmbedController.new
params = { topic_id: '123', embed_url: nil }
req = FakeRequest.new('http://a.com/foo')
res = FakeResponse.new

controller.define_singleton_method(:params) { params }
controller.define_singleton_method(:request) { req }
controller.define_singleton_method(:response) { res }

defect = false
begin
  controller.send(:ensure_embeddable)
  unless EmbeddableHost.topic_scope_ok?(123, 'http://a.com/foo')
    defect = true
  end
rescue Discourse::InvalidAccess
  defect = false
end

if defect
  puts "RESULT: FAIL: ensure_embeddable only verifies referer host; topic 123 (host b.com) accepted with referer http://a.com"
else
  puts "RESULT: PASS"
end
