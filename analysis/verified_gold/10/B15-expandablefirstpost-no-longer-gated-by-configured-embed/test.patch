# ---- Load the real file ----

begin
  require_relative '../../app/models/topic'
rescue => e
  puts "RESULT: FAIL: could not load topic.rb: #{e.class}: #{e.message}"
  exit 1
end

# ---- Exercise the claimed behaviour ----

begin
  topic = Topic.new

  # Stub the method that detects an embed in the first post.
  # The claim is that expandable_first_post? should be gated by configured
  # embeddable hosts; we simulate the "all hosts removed" state.
  topic.define_singleton_method(:has_topic_embed?) { true }

  result = topic.send(:expandable_first_post?)

  if result == false
    puts "RESULT: PASS"
  else
    puts "RESULT: FAIL: expandable_first_post? returned #{result.inspect} " \
         "even though no embeddable hosts are configured"
  end
rescue NameError => e
  puts "RESULT: FAIL: method not found: #{e.message}"
rescue => e
  puts "RESULT: FAIL: #{e.class}: #{e.message}"
end
