# --- exercise the claimed code path: feed-polled import, URL host with no EmbeddableHost row ---
begin
  user = Object.new
  TopicEmbed.import(user, 'http://unknown-host.example.com/article', 'Title', '<p>body</p>')

  if $recorded_category == SiteSetting.embed_category
    puts 'RESULT: PASS'
  else
    puts "RESULT: FAIL: feed-polled import lost category: got #{$recorded_category.inspect}, " \
         "expected fallback #{SiteSetting.embed_category.inspect} (EmbeddableHost row missing, no global fallback)"
  end
rescue => e
  puts "RESULT: FAIL: #{e.class}: #{e.message}"
end
