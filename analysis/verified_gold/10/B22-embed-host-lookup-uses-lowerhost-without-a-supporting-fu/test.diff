diff --git a/spec/verify/embeddable_host_verify.rb b/spec/verify/embeddable_host_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/embeddable_host_verify.rb
@@ -0,0 +1,51 @@
+require 'uri'
+
+# --- minimal stubs so the real model file can load without Rails ---
+class Object
+  def present?; !nil?; end
+end
+
+class NilClass
+  def present?; false; end
+end
+
+module ActiveRecord
+  class Base
+    class << self
+      def validates_format_of(*); end
+      def belongs_to(*); end
+      def before_validation(*, &b); end
+      def where(*args)
+        $captured_where = args
+        Rel.new
+      end
+    end
+    class Rel
+      def first; nil; end
+    end
+  end
+end
+
+begin
+  require './app/models/embeddable_host.rb'
+rescue LoadError => e
+  puts "RESULT: FAIL: could not load app/models/embeddable_host.rb (#{e.message})"
+  exit 0
+end
+
+# Exercise the real lookup path.
+EmbeddableHost.record_for_host('http://example.com/foo')
+predicate = $captured_where.to_a.first.to_s
+uses_lower = !!(predicate =~ /lower\s*\(\s*host\s*\)/i)
+
+# A plain index on host cannot satisfy lower(host) = ?; a functional index is required.
+functional_index = Dir.glob('db/migrate/**/*.rb').any? do |f|
+  content = (File.read(f) rescue '')
+  content =~ /lower\s*\(\s*host\s*\)/i && content =~ /add_index|index/i
+end
+
+if uses_lower && !functional_index
+  puts "RESULT: FAIL: record_for_host issues lower(host) = ? with no supporting functional index in migrations (sequential scan on embed requests)"
+else
+  puts "RESULT: PASS"
+end
