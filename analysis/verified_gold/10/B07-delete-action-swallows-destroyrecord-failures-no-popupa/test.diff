diff --git a/spec/verify/embeddable-host.js_verify.rb b/spec/verify/embeddable-host.js_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/embeddable-host.js_verify.rb
@@ -0,0 +1,57 @@
+# Standalone verification script for a claimed defect in
+# app/assets/javascripts/admin/components/embeddable-host.js.es6
+#
+# The target file is an ES6 asset (not Ruby), so it cannot be `require`d as
+# Ruby code. Instead we load the REAL file from disk and exercise a
+# source-level assertion that mirrors the claim's observable behaviour: the
+# delete action's destroyRecord() promise chain must terminate with
+# .catch(popupAjaxError), otherwise a rejected deletion is swallowed with no
+# user feedback (and the row stays in the UI).
+
+ROOT = File.expand_path('../..', __dir__)
+SRC  = File.expand_path('app/assets/javascripts/admin/components/embeddable-host.js.es6', ROOT)
+
+fail_with = lambda do |reason|
+  puts "RESULT: FAIL: #{reason}"
+  exit 0
+end
+
+pass = lambda do
+  puts 'RESULT: PASS'
+  exit 0
+end
+
+unless File.file?(SRC)
+  fail_with.call("source file not found at #{SRC}")
+end
+
+source = File.read(SRC)
+
+# 1) The file under test must actually define the delete() action.
+delete_match = source.match(/\bdelete\(\)\s*\{(.*?)\n\s*cancel\(\)\s*\{/m)
+unless delete_match
+  fail_with.call('could not locate the delete() action in embeddable-host.js.es6')
+end
+
+delete_body = delete_match[1]
+
+# 2) The claim is specifically about destroyRecord() inside the delete action.
+unless delete_body =~ /destroyRecord\(\)/
+  fail_with.call('delete action does not invoke destroyRecord()')
+end
+
+# 3) Behavioural assertion: everything after destroyRecord() up to the end of
+#    the delete action is its promise chain. The chain must contain a
+#    .catch(popupAjaxError) so that a rejected destroyRecord() surfaces an
+#    error popup instead of being silently swallowed.
+chain = delete_body[/destroyRecord\(\)(.*)\z/m, 1] || ''
+
+if chain.include?('.catch(popupAjaxError)')
+  # Failure path is handled; the claimed defect is absent.
+  pass.call
+else
+  fail_with.call(
+    "delete action's destroyRecord() promise chain lacks .catch(popupAjaxError); " \
+    'a rejected deletion is swallowed and the row remains with no user feedback'
+  )
+end
