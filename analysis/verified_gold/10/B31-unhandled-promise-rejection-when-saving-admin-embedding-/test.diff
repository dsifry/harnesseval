diff --git a/spec/verify/admin-embedding.js_verify.rb b/spec/verify/admin-embedding.js_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/admin-embedding.js_verify.rb
@@ -0,0 +1,58 @@
+require 'fileutils'
+
+# Claim: app/assets/javascripts/admin/controllers/admin-embedding.js.es6
+# The saveChanges action calls this.get('embedding').update({}) and neither
+# chains (.then/.catch/.finally) nor otherwise handles the returned promise,
+# so a rejected save becomes an unhandled promise rejection with no error popup.
+
+SRC = File.expand_path('app/assets/javascripts/admin/controllers/admin-embedding.js.es6', Dir.pwd)
+
+unless File.file?(SRC)
+  puts "RESULT: FAIL: real source file not found at #{SRC}"
+  exit(1)
+end
+
+src = File.read(SRC)
+
+m = src.match(/saveChanges\s*\([^)]*\)\s*\{/)
+unless m
+  # Action absent: nothing claims the defect on this method.
+  puts "RESULT: PASS"
+  exit(0)
+end
+
+# Extract the saveChanges body by brace matching.
+start = src.index('{', m.begin(0))
+depth = 0
+i = start
+body_end = nil
+while i < src.length
+  case src[i]
+  when '{' then depth += 1
+  when '}' then depth -= 1
+  end
+  if depth.zero?
+    body_end = i
+    break
+  end
+  i += 1
+end
+
+body = src[(start + 1)...body_end].to_s
+
+# The claim targets the update(...) invocation.
+unless body =~ /\.update\s*\(/
+  puts "RESULT: PASS"
+  exit(0)
+end
+
+# Observable handling: the promise returned by .update(...) is chained with
+# .then / .catch / .finally within the action body.
+chained = body =~ /\.update\s*\([^)]*\)\s*\.\s*(?:then|catch|finally)\b/ ||
+          body =~ /\.update\s*\([^)]*\)\s*;?\s*\n\s*\.\s*(?:then|catch|finally)\b/
+
+if chained
+  puts "RESULT: PASS"
+else
+  puts "RESULT: FAIL: saveChanges calls this.get('embedding').update({}) without chaining .then/.catch/.finally; a rejected save becomes an unhandled promise rejection with no error popup"
+end
