require 'uri'

module ActiveRecord
  class Base
    class << self
      attr_accessor :_validations, :_callbacks
      def validates_format_of(attr, opts)
        (@_validations ||= []) << [attr, opts[:with]]
      end
      def belongs_to(*); end
      def before_validation(&blk)
        (@_callbacks ||= []) << blk
      end
    end

    def initialize(attrs = {})
      attrs.each { |k, v| instance_variable_set("@#{k}", v) }
    end

    attr_accessor :host

    def valid?
      (self.class._callbacks || []).each { |b| instance_eval(&b) }
      (self.class._validations || []).all? do |attr, re|
        v = send(attr)
        !!(v && v =~ re)
      end
    end
  end
end

require_relative '../../app/models/embeddable_host'

cases = [
  ['lowercase http://example.com',            'http://example.com',        'example.com'],
  ['uppercase HTTP://example.com',            'HTTP://example.com',        'example.com'],
  ['mixed case Http://example.com',           'Http://example.com',        'example.com'],
  ['protocol-relative //example.com',         '//example.com',             'example.com'],
  ['uppercase with path HTTP://example.com/x','HTTP://example.com/x',      'example.com'],
  ['lowercase with path http://a.io/foo',     'http://a.io/foo',           'a.io'],
]

failures = []
cases.each do |desc, input, expected|
  r = EmbeddableHost.new(host: input.dup)
  r.valid?
  failures << "#{desc}: host=#{r.host.inspect} (expected #{expected.inspect})" if r.host != expected
end

if failures.empty?
  puts 'RESULT: PASS'
else
  puts "RESULT: FAIL: #{failures.join(' | ')}"
end
