class Object
  def blank?
    respond_to?(:empty?) ? !!empty? : !self
  end
end

module Admin
  class AdminController
    attr_accessor :params, :rendered, :error
    def self.before_filter(*); end
    def ensure_logged_in; end
    def ensure_staff; end
    def render_serialized(*args); @rendered = args; end
    def render_json_error(obj); @error = obj; end
    def success_json; { success: true }; end
  end
end

class EmbeddableHostSerializer; end

class FakeRelation
  def initialize(records); @records = records; end
  def first; @records.first; end
end

class EmbeddableHost
  attr_accessor :id, :host, :category_id
  def self.all; @all ||= []; end
  def save; self.class.all << self; true; end
  def self.where(cond)
    FakeRelation.new(all.select { |r| cond.all? { |k, v| r.send(k) == v } })
  end
end

