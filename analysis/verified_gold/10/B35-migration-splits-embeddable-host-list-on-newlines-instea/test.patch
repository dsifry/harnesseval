  exit
end

inserts = $queries.select { |q| q.include?('INSERT INTO embeddable_hosts') }
hosts = inserts.map { |q| q[/VALUES \(([^']*)'/, 1] }.compact

if hosts.any? { |h| h.include?('|') }
