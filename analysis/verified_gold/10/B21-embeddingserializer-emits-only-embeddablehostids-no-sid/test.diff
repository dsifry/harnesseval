diff --git a/spec/verify/embedding_serializer_verify.rb b/spec/verify/embedding_serializer_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/embedding_serializer_verify.rb
@@ -0,0 +1,42 @@
+require 'digest'
+
+# --- minimal stubs so the real serializer can load without Rails ---
+class EmbeddableHostSerializer; end
+
+class ApplicationSerializer
+  class << self
+    def attributes(*args); end
+    def has_many(name, options = {})
+      (@associations ||= []) << [name, options]
+    end
+    def associations; @associations || []; end
+  end
+end
+
+# --- load the real file under test ---
+require_relative '../../app/serializers/embedding_serializer'
+
+# --- inspect what the serializer declares ---
+assoc = EmbeddingSerializer.associations.find { |name, _| name == :embeddable_hosts }
+
+fail_reason = nil
+
+if assoc.nil?
+  fail_reason = "no has_many :embeddable_hosts association declared"
+else
+  name, options = assoc
+  if options[:embed] == :ids && options[:include] != true
+    fail_reason = "has_many :embeddable_hosts declared with embed: :ids but without include: true - " +
+                  "payload will emit only embeddable_host_ids and no sideloaded collection, " +
+                  "so client-side hydration via lookupsubtype finds no root embeddable_hosts"
+  end
+  if options[:serializer] != EmbeddableHostSerializer
+    fail_reason ||= "has_many :embeddable_hosts missing serializer: EmbeddableHostSerializer"
+  end
+end
+
+if fail_reason
+  puts "RESULT: FAIL: #{fail_reason}"
+else
+  puts "RESULT: PASS"
+end
