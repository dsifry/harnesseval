# ActiveSupport-ish #present?/#blank? on Object (needed by the code under test)
class Object
  def present?; !nil? && !(respond_to?(:empty?) && empty?); end
  def blank?; !present?; end
end

module Rails
  Env = Struct.new(:name) do
    def development?; name == 'development'; end
  end
  def self.env; Env.new('test'); end
end

class ApplicationController
