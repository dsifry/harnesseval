# --- Load the REAL file under test (no redefinition) ---
require_relative '../../app/controllers/embed_controller'

# --- Simulate an anonymous, non-browser HTTP client forging the Referer header ---
# curl/requests/postman can set any Referer they want. There is no session,
# no cookie, and no CSRF (verify_authenticity_token is skipped) -- the only
# input the authorization gate consults is this client-authored header.
forged_referer = 'http://allowed.example/forged-by-curl'

anonymous_request = OpenStruct.new(
  referer: forged_referer,
  headers: { 'User-Agent' => 'curl/7.68.0' }
)

controller = EmbedController.new
controller.request = anonymous_request
controller.params  = { topic_id: 1 } # arbitrary attacker-known topic id

access_granted = begin
  controller.send(:ensure_embeddable) # the entire authorization gate
  true
rescue Discourse::InvalidAccess
  false
end

# Sanity check: a Referer for a non-allowed host must still be rejected.
controller_bad = EmbedController.new
controller_bad.request = OpenStruct.new(referer: 'http://evil.example/', headers: {})
bad_referer_granted = begin
  controller_bad.send(:ensure_embeddable)
  true
rescue Discourse::InvalidAccess
  false
end

if access_granted && !bad_referer_granted
  puts "RESULT: FAIL: EmbedController#ensure_embeddable authorizes an anonymous non-browser client solely on the client-supplied Referer header (forged '#{forged_referer}'); the host allowlist is bypassable and topic comments are readable off-site."
else
  puts "RESULT: PASS"
end
