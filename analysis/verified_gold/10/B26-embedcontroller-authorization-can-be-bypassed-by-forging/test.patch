  def self.before_filter(*); end
  def self.layout(*); end

  attr_accessor :params, :request

  def current_user; nil; end
  def response; @response ||= OpenStruct.new(headers: {}); end
  def render(*); end
  def discourse_expires_in(*); end
end

# Simulates a server-side allowlist of embeddable hosts (the real EmbeddableHost).
class EmbeddableHost
  ALLOWED_HOSTS = ['allowed.example'].freeze
  def self.host_allowed?(referer)
    return false if referer.nil? || referer.empty?
    URI.parse(referer).host.to_s.then { |h| ALLOWED_HOSTS.include?(h) }
  rescue URI::InvalidURIError
    false
  end
end

