diff --git a/spec/verify/embeddable_host_verify.rb b/spec/verify/embeddable_host_verify.rb
new file mode 100644
--- /dev/null
+++ b/spec/verify/embeddable_host_verify.rb
@@ -0,0 +1,42 @@
+require 'uri'
+
+module ActiveRecord
+  class Base
+    class << self
+      def validates_format_of(_attr, opts)
+        @validated_regex = opts[:with]
+      end
+      def belongs_to(*); end
+      def before_validation(&block)
+        (@before_validation_callbacks ||= []) << block
+      end
+      def validated_regex; @validated_regex; end
+      def before_validation_callbacks; @before_validation_callbacks ||= []; end
+      def where(*); []; end
+      def first; nil; end
+    end
+    attr_accessor :host
+  end
+end
+
+require 'app/models/embeddable_host'
+
+inst = EmbeddableHost.new
+inst.host = "example.com\n"
+
+EmbeddableHost.before_validation_callbacks.each do |cb|
+  inst.instance_exec(&cb)
+end
+
+regex = EmbeddableHost.validated_regex
+
+if regex.nil?
+  puts "RESULT: FAIL: no validation regex was registered via validates_format_of"
+  exit
+end
+
+if regex.match(inst.host)
+  puts "RESULT: FAIL: host #{inst.host.inspect} passed format validation despite trailing newline (\Z allows pre-newline match); this silently breaks allowlist lookups"
+else
+  puts "RESULT: PASS: host with trailing newline was rejected by format validation"
+end
