diff --git a/./.env.verified.test.ts b/./.env.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/./.env.verified.test.ts
@@ -0,0 +1,57 @@
+import { describe, it, expect } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+function extractNearbyBlock(lines: string[], varName: string, lookback = 8) {
+  const idx = lines.findIndex((l) => l.startsWith(`${varName}=`));
+  if (idx === -1) throw new Error(`Expected to find ${varName}= in .env.example`);
+  const start = Math.max(0, idx - lookback);
+  const block = lines.slice(start, idx + 1);
+  return { idx, block };
+}
+
+function extractOpenSSLBase64ByteCounts(block: string[]) {
+  const counts: number[] = [];
+  const re = /openssl\s+rand\s+-base64\s+(\d+)/g;
+  for (const line of block) {
+    let m: RegExpExecArray | null;
+    while ((m = re.exec(line))) counts.push(Number(m[1]));
+  }
+  return counts;
+}
+
+describe(".env.example AES-256 key generation guidance", () => {
+  it("recommends generating 32 random bytes (not 24) for AES-256 encryption keys", () => {
+    const here = dirname(fileURLToPath(import.meta.url));
+    const envExamplePath = resolve(here, ".env.example");
+    const content = readFileSync(envExamplePath, "utf8");
+    const lines = content.split(/\r?\n/);
+
+    const vars = ["CALENDSO_ENCRYPTION_KEY", "CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY"];
+
+    for (const varName of vars) {
+      const { block } = extractNearbyBlock(lines, varName, 10);
+      const blockText = block.join("\n");
+      expect(
+        blockText,
+        `Expected ${varName} block to mention the AES-256 requirement (32 bytes)`
+      ).toMatch(/must be 32 bytes/i);
+
+      const counts = extractOpenSSLBase64ByteCounts(block);
+      expect(
+        counts.length,
+        `Expected ${varName} block to include an openssl rand -base64 <N> example command`
+      ).toBeGreaterThan(0);
+
+      expect(
+        counts,
+        `Expected AES-256 key generation command for ${varName} to use 32 bytes (openssl rand -base64 32), not 24`
+      ).toContain(32);
+      expect(
+        counts,
+        `Expected AES-256 key generation command for ${varName} to not recommend 24 bytes (openssl rand -base64 24)`
+      ).not.toContain(24);
+    }
+  });
+});
