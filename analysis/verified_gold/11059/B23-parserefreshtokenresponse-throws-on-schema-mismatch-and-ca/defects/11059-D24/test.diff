import { afterEach, expect, test, vi } from "vitest";
import { z } from "zod";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: false,
}));

afterEach(() => {
  vi.resetModules();
  vi.unstubAllEnvs();
});

test("Salesforce refresh-token responses without scope are accepted", async () => {
  // Ensure the credential-sharing path is not taken so the provided schema is used.
  delete process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT;

  const { default: parseRefreshTokenResponse } = await import("./parseRefreshTokenResponse");

  // Mirrors the salesforce refresh-token schema, which currently requires `scope`
  // even though salesforce refresh responses omit it.
  const salesforceRefreshTokenSchema = z.object({
    access_token: z.string(),
    refresh_token: z.string(),
    instance_url: z.string(),
    id: z.string(),
    token_type: z.string(),
    issued_at: z.string(),
    scope: z.string(),
  });

  const realWorldSalesforceResponse = {
    access_token: "00Dxx0000001gEU!AQEAQ...",
    refresh_token: "5Aep861...",
    instance_url: "https://cal.my.salesforce.com",
    id: "https://login.salesforce.com/id/00Dxx0000001gEU/005xx000001Svwp",
    token_type: "Bearer",
    issued_at: "1626260000000",
    signature: "abc123",
  };

  expect(() =>
    parseRefreshTokenResponse(realWorldSalesforceResponse, salesforceRefreshTokenSchema)
  ).not.toThrow("Salesforce refresh-token responses omit `scope` and must not be rejected");
});
