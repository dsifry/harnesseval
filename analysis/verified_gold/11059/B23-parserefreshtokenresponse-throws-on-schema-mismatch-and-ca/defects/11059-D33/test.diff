import prismaMock from "../../../../tests/libs/__mocks__/prisma";

import { afterEach, expect, test, vi } from "vitest";

afterEach(() => {
  vi.resetAllMocks();
});

vi.mock("@calcom/features/flags/server/utils", () => ({
  getFeatureFlagMap: vi.fn().mockResolvedValue({
    "calendar-cache": true,
  }),
}));

vi.mock("./getGoogleAppKeys", () => ({
  getGoogleAppKeys: vi.fn().mockResolvedValue({
    client_id: "xxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com",
    client_secret: "xxxxxxxxxxxxxxxxxx",
    redirect_uris: ["http://localhost:3000/api/integrations/googlecalendar/callback"],
  }),
}));

test("refresh accepts a token response that omits `scope` (Salesforce refresh responses have no scope)", async () => {
  expect(prismaMock).toBeDefined();

  // Module under test: the real Google Calendar service whose refresh flow
  // delegates response validation to parseRefreshTokenResponse.
  const { default: CalendarService } = await import("./CalendarService");
  expect(CalendarService).toBeDefined();

  // The exact parser the service under test imports for its refresh responses.
  const { default: parseRefreshTokenResponse } = await import(
    "../../_utils/oauth/parseRefreshTokenResponse"
  );

  // A real Salesforce token refresh response: note there is no `scope` field.
  const salesforceRefreshResponse = {
    access_token: "00Dxx0000001gPz!AQ8AQ...",
    refresh_token: "5Aep861...",
    token_type: "Bearer",
    expires_in: 3600,
    issued_at: "1700000000000",
    instance_url: "https://eu28.salesforce.com",
    id: "https://login.salesforce.com/id/00Dxx0000001gPz/005xx000001Svzq",
    signature: "c2lnbmF0dXJl",
  };

  // Sanity check: the payload intentionally carries no `scope` property.
  expect(Object.prototype.hasOwnProperty.call(salesforceRefreshResponse, "scope")).toBe(false);

  // Observable behavior: a valid refresh response without `scope` must be accepted.
  // On the current code the schema marks `scope` as required, so this throws a ZodError.
  let parsed: any;
  expect(() => {
    parsed = parseRefreshTokenResponse(salesforceRefreshResponse);
  }).not.toThrow();

  expect(parsed?.access_token).toBe(salesforceRefreshResponse.access_token);
  expect(parsed?.refresh_token).toBe(salesforceRefreshResponse.refresh_token);
});
