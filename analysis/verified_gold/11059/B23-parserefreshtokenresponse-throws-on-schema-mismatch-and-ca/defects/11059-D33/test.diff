/* eslint-disable @typescript-eslint/no-explicit-any */
import { expect, vi, test, afterEach } from "vitest";

vi.mock("jsforce", () => ({
  default: {
    Connection: class MockConnection {
      constructor(_config: any) {}
    },
  },
}));

vi.mock("../../_utils/getAppKeysFromSlug", () => ({
  default: vi.fn(async () => ({
    consumer_key: "test-consumer-key",
    consumer_secret: "test-consumer-secret",
  })),
}));

(globalThis as any).prisma = {
  credential: {
    update: vi.fn(async () => ({})),
  },
};

afterEach(() => {
  vi.resetAllMocks();
  (globalThis as any).prisma = {
    credential: {
      update: vi.fn(async () => ({})),
    },
  };
});

test("salesforce refresh response without `scope` should be accepted (not rejected by the token schema)", async () => {
  const refreshResponseWithoutScope = {
    id: "https://login.salesforce.com/id/00D.../005...",
    issued_at: "1700000000000",
    instance_url: "https://example.my.salesforce.com",
    signature: "some-signature",
    access_token: "new-access-token",
    token_type: "Bearer",
  };

  vi.stubGlobal(
    "fetch",
    vi.fn(async () => ({
      status: 200,
      statusText: "OK",
      json: async () => refreshResponseWithoutScope,
    }))
  );

  const credential = {
    id: 1,
    key: {
      refresh_token: "refresh-token",
      access_token: "old-access-token",
      instance_url: "https://example.my.salesforce.com",
    },
  };

  const { default: SalesforceCalendarService } = await import("./CalendarService");

  const service = new SalesforceCalendarService(credential as any);

  let connectionError: Error | undefined;
  try {
    await (service as any).conn;
  } catch (e) {
    connectionError = e as Error;
  }

  expect(
    connectionError,
    `salesforce refresh response without "scope" should be accepted, but it was rejected with: ${
      connectionError?.message ?? "no error"
    }`
  ).toBeUndefined();

  expect((globalThis as any).prisma.credential.update).toHaveBeenCalled();
});