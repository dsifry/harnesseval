/* eslint-disable @typescript-eslint/no-explicit-any */
import { expect, test, vi } from "vitest";
import { z } from "zod";

// Feature flag is a true external; force the non-shared code path so the
// caller-supplied schema is used when validating the token response.
vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: false,
}));

test("invalid refresh-token responses return a failed parse result instead of throwing (so the !success branch in salesforce/lib/calendarservice.ts is not dead)", async () => {
  // Ensure shared-credential mode is off before the module is loaded.
  delete process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT;

  const { default: parseRefreshTokenResponse } = await import("./parseRefreshTokenResponse");

  const refreshSchema = z.object({
    access_token: z.string(),
    refresh_token: z.string().optional(),
  });

  // A real Salesforce sandbox can reject the refresh with an OAuth error body
  // (e.g. {"error":"invalid_grant"}). Callers branch on
  // `if (!accessTokenParsed.success)` to surface a friendly error; that branch
  // is unreachable if this util throws instead of returning a failed result.
  let result: ReturnType<typeof parseRefreshTokenResponse> | undefined;
  expect(() => {
    result = parseRefreshTokenResponse(
      { error: "invalid_grant", error_description: "authentication failure" },
      refreshSchema
    );
  }).not.toThrow();

  expect(result).toBeDefined();
  expect(result?.success).toBe(false);
});
