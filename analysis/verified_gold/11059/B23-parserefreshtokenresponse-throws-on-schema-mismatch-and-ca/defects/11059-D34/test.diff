/* eslint-disable @typescript-eslint/no-explicit-any */
import { afterEach, beforeEach, expect, test, vi } from "vitest";

const updateMock = vi.fn();
(globalThis as any).prisma = { credential: { update: updateMock } };

vi.mock("../../_utils/getAppKeysFromSlug", () => ({
  default: vi.fn(async () => ({ consumer_key: "ck", consumer_secret: "cs" })),
}));

vi.mock("jsforce", () => ({
  default: {
    Connection: class {
      constructor(_opts: any) {
        /* mock */
      }
    },
  },
}));

let capturedUrl = "";

beforeEach(() => {
  capturedUrl = "";
  vi.stubGlobal(
    "fetch",
    vi.fn(async (url: string) => {
      capturedUrl = url;
      return {
        statusText: "OK",
        json: async () => ({}),
      } as unknown as Response;
    })
  );
});

afterEach(() => {
  vi.unstubAllGlobals();
  vi.clearAllMocks();
});

test("refresh token uses the sandbox login host derived from instance_url", async () => {
  const { default: SalesforceCalendarService } = await import("./CalendarService");

  const credential = {
    id: 1,
    key: {
      // A sandbox org's instance_url contains the `--sandbox` marker.
      // Salesforce sandbox OAuth token exchanges MUST go to test.salesforce.com, not login.salesforce.com.
      instance_url: "https://calcom--uat.my.salesforce.com",
      refresh_token: "rt",
      access_token: "at",
      id: "https://login.salesforce.com/id/x/y",
      issued_at: "1",
      signature: "sig",
      scope: "full",
      token_type: "Bearer",
    },
  };

  const service = new SalesforceCalendarService(credential as any);
  try {
    await (service as any).conn;
  } catch {
    // The fake token response likely fails schema parsing; we only care that fetch happened.
  }

  expect(
    capturedUrl,
    "Salesforce token refresh must target the sandbox login host (test.salesforce.com) when the credential's instance_url is a sandbox URL, instead of the hardcoded login.salesforce.com"
  ).toContain("test.salesforce.com");
});
