/* eslint-disable @typescript-eslint/no-explicit-any */
import { expect, test, vi, afterEach } from "vitest";

// APP_CREDENTIAL_SHARING_ENABLED is read at import time; stub the flag so the
// sync branch (minimumTokenResponseSchema.safeParse path) is the one exercised.
vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

afterEach(() => {
  vi.resetModules();
  vi.unstubAllEnvs();
});

test("invalid refreshed tokens reject with an HttpError-consistent error, not a bare Error", async () => {
  // Endpoint must be present for the sync branch described in the claim.
  vi.stubEnv("CALCOM_CREDENTIAL_SYNC_ENDPOINT", "https://example.com/credential-sync");

  const { default: parseRefreshTokenResponse } = await import("./parseRefreshTokenResponse");

  // Force the parse to fail so we observe the failure path.
  const schema = {
    safeParse: () => ({ success: false, error: new Error("invalid payload") }),
  } as any;

  let thrown: any;
  try {
    parseRefreshTokenResponse({ not: "a token response" }, schema);
    thrown = undefined;
  } catch (e) {
    thrown = e;
  }

  // The claim states the sync branch failure is "inconsistent with httperror
  // usage": the fix is expected to surface an HTTP-style error (carrying a
  // status) rather than a plain Error. The current post-PR code throws
  // `new Error("Invalid refreshed tokens were returned")` with no status, so
  // this assertion fails.
  expect(thrown).toBeTruthy();
  expect(typeof thrown.statusCode === "number" || typeof thrown.status === "number").toBe(true);
  const status = thrown.statusCode ?? thrown.status;
  expect(status).toBeGreaterThanOrEqual(400);
});
