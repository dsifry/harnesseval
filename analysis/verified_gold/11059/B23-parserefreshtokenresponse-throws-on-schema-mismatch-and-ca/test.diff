--- /dev/null
+++ b/packages/app-store/_utils/oauth/parseRefreshTokenResponse.verified.test.ts
@@ -0,0 +1,47 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { z } from "zod";
+
+// Feature-flag mock (allowed): force the code path that uses the passed-in schema
+vi.mock("@calcom/lib/constants", () => ({
+  APP_CREDENTIAL_SHARING_ENABLED: false,
+}));
+
+describe("parseRefreshTokenResponse (verified)", () => {
+  beforeEach(() => {
+    // Ensure the schema-based branch is used
+    delete process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT;
+    vi.resetModules();
+  });
+
+  it("does not throw on schema mismatch (e.g., Salesforce refresh response missing `scope`); it should return success:false so callers can handle it", async () => {
+    const { default: parseRefreshTokenResponse } = await import("./parseRefreshTokenResponse");
+
+    // Simulate a provider schema that (incorrectly) requires `scope`
+    const overlyStrictSchema = z.object({
+      access_token: z.string(),
+      scope: z.string(),
+      expires_in: z.number(),
+    });
+
+    // Valid refresh response from providers that omit `scope`
+    const responseWithoutScope = {
+      access_token: "access-token",
+      expires_in: 3600,
+    };
+
+    let thrown: unknown;
+    let result: any;
+    try {
+      result = parseRefreshTokenResponse(responseWithoutScope, overlyStrictSchema);
+    } catch (e) {
+      thrown = e;
+    }
+
+    expect(
+      thrown,
+      "parseRefreshTokenResponse should not throw on schema mismatch; it should return { success: false } so callers can branch instead of crashing"
+    ).toBeUndefined();
+
+    expect(result?.success).toBe(false);
+  });
+});
