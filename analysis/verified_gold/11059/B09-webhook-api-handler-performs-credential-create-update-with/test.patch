import { beforeEach, expect, it, vi } from "vitest";

const mockUserFindUnique = vi.fn();
const mockAppFindUnique = vi.fn();
const mockCredentialFindFirst = vi.fn();
const mockCredentialCreate = vi.fn();
const mockCredentialUpdate = vi.fn();

vi.mock("@calcom/prisma", () => ({
  default: {
    user: { findUnique: mockUserFindUnique },
    app: { findUnique: mockAppFindUnique },
    credential: {
      findFirst: mockCredentialFindFirst,
      create: mockCredentialCreate,
      update: mockCredentialUpdate,
    },
  },
}));

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn(() => JSON.stringify({ apiKey: "decrypted" })),
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {
    test: {
      slug: "test",
      type: "test",
    },
  },
}));

function createRes() {
  const res: any = {};
  res.status = vi.fn().mockReturnValue(res);
  res.json = vi.fn().mockReturnValue(res);
  return res;
}

beforeEach(() => {
  vi.clearAllMocks();
  mockUserFindUnique.mockResolvedValue({ id: 1 });
  mockAppFindUnique.mockResolvedValue({ slug: "test" });
  mockCredentialFindFirst.mockResolvedValue(null);
  mockCredentialCreate.mockResolvedValue({});
  mockCredentialUpdate.mockResolvedValue({});
});

it("rejects non-POST requests with 405 Method Not Allowed", async () => {
  process.env.CALCOM_WEBHOOK_SECRET = "test-secret";
  process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
  process.env.CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY = "test-encryption-key";

  const { default: handler } = await import("./app-credential");

  const req: any = {
    method: "GET",
    headers: {
      "calcom-webhook-secret": "test-secret",
    },
    body: {
      userId: 1,
      appSlug: "test",
      keys: "encrypted",
    },
  };
  const res = createRes();

  await handler(req, res);

  expect(res.status).toHaveBeenCalledWith(405);
});
