import { beforeEach, describe, expect, it, vi } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/prisma", () => ({
  default: {
    user: { findUnique: vi.fn() },
    app: { findUnique: vi.fn() },
    credential: { findFirst: vi.fn(), update: vi.fn(), create: vi.fn() },
  },
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {},
}));

describe("app-credential webhook", () => {
  let handler: (req: any, res: any) => Promise<unknown>;

  beforeEach(async () => {
    process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
    process.env.CALCOM_WEBHOOK_SECRET = "test-secret";
    process.env.CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY = "a".repeat(32);

    const mod = await import("./app-credential");
    handler = mod.default;
  });

  it("responds with 405 for a GET request instead of throwing an unhandled schema error", async () => {
    const req = {
      method: "GET",
      headers: { "calcom-webhook-secret": "test-secret" },
      body: undefined,
    } as any;
    const res = {
      status: vi.fn().mockReturnThis(),
      json: vi.fn().mockReturnThis(),
    } as any;

    await expect(handler(req, res)).resolves.toBeUndefined();
    expect(res.status).toHaveBeenCalledWith(405);
  });

  it("responds with 400 for a malformed body instead of throwing an unhandled ZodError", async () => {
    const req = {
      method: "POST",
      headers: { "calcom-webhook-secret": "test-secret" },
      body: { userId: "not-a-number" },
    } as any;
    const res = {
      status: vi.fn().mockReturnThis(),
      json: vi.fn().mockReturnThis(),
    } as any;

    await expect(handler(req, res)).resolves.toBeUndefined();
    expect(res.status).toHaveBeenCalledWith(400);
  });
});
