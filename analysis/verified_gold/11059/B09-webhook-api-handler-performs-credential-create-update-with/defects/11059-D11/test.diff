import { beforeEach, describe, expect, it, vi } from "vitest";
import type { NextApiRequest, NextApiResponse } from "next";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

const mockPrisma = {
  user: { findUnique: vi.fn() },
  app: { findUnique: vi.fn() },
  credential: { findFirst: vi.fn(), update: vi.fn(), create: vi.fn() },
};

vi.mock("@calcom/prisma", () => ({
  default: mockPrisma,
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {
    "test-app": { slug: "test-app", type: "test-type" },
  },
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn().mockReturnValue(JSON.stringify({ key: "value" })),
}));

process.env.CALCOM_WEBHOOK_SECRET = "test-secret";
process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
process.env.CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY = "test-encryption-key";

function createMocks(reqOverrides: Partial<NextApiRequest> = {}) {
  const status = vi.fn().mockReturnThis();
  const json = vi.fn().mockReturnThis();
  const res = { status, json } as unknown as NextApiResponse;
  const req = {
    method: "GET",
    headers: { "calcom-webhook-secret": "test-secret" },
    body: undefined,
    ...reqOverrides,
  } as unknown as NextApiRequest;
  return { req, res, status, json };
}

describe("app-credential webhook", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("rejects non-POST requests with 405 Method Not Allowed", async () => {
    const { req, res, status } = createMocks({ method: "GET" });

    const { default: handler } = await import("./app-credential");

    let thrown: unknown;
    try {
      await handler(req, res);
    } catch (e) {
      thrown = e;
    }

    expect(status, "handler should reject non-POST requests with 405").toHaveBeenCalledWith(405);
  });
});
