+import { describe, expect, it, vi, beforeEach } from "vitest";
+import { z } from "zod";
+
+// Feature flag is an external; mock to exercise the non-sync (strict schema) path.
+vi.mock("@calcom/lib/constants", () => ({
+  APP_CREDENTIAL_SHARING_ENABLED: false,
+}));
+
+describe("parseRefreshTokenResponse regression evidence", () => {
+  beforeEach(() => {
+    vi.resetModules();
+    delete process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT;
+  });
+
+  it(
+    "does not throw on Zod safeParse failure; returns the safeParse result so callers can degrade gracefully",
+    async () => {
+      const { default: parseRefreshTokenResponse } = await import("./parseRefreshTokenResponse");
+
+      const strictSchema = z
+        .object({
+          access_token: z.string(),
+          refresh_token: z.string(),
+        })
+        .strict();
+
+      const malformedProviderResponse = {
+        // missing access_token; previously this would be a safeParse failure that callers handled
+        refresh_token: "rt_123",
+      };
+
+      const result = expect(
+        () => parseRefreshTokenResponse(malformedProviderResponse, strictSchema),
+        "parseRefreshTokenResponse should degrade gracefully (return safeParse failure) instead of throwing on schema mismatch"
+      ).not.toThrow();
+
+      // Ensure observable behavior: function returns the Zod safeParse object with success=false
+      const parsed = parseRefreshTokenResponse(malformedProviderResponse, strictSchema);
+      expect(parsed.success).toBe(false);
+      if (!parsed.success) {
+        expect(parsed.error).toBeInstanceOf(z.ZodError);
+      }
+
+      // keep lint happy about the unused `result` (it holds the assertion)
+      expect(result).toBeDefined();
+    }
+  );
+
+  it("still injects a placeholder refresh_token when parsing succeeds but response omits it", async () => {
+    const { default: parseRefreshTokenResponse } = await import("./parseRefreshTokenResponse");
+
+    const schemaWithoutRefreshToken = z.object({
+      access_token: z.string(),
+      expires_in: z.number(),
+    });
+
+    const response = {
+      access_token: "at_123",
+      expires_in: 3600,
+    };
+
+    const parsed = parseRefreshTokenResponse(response, schemaWithoutRefreshToken);
+    expect(parsed.success).toBe(true);
+    if (parsed.success) {
+      expect(parsed.data.refresh_token).toBe("refresh_token");
+    }
+  });
+});
