diff --git a/apps/web/pages/api/webhook/app-credential.verified.test.ts b/apps/web/pages/api/webhook/app-credential.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/pages/api/webhook/app-credential.verified.test.ts
@@ -0,0 +1,52 @@
+import { expect, it, vi } from "vitest";
+
+vi.mock("@calcom/prisma", () => ({
+  default: {
+    user: { findUnique: vi.fn() },
+    app: { findUnique: vi.fn() },
+    credential: { findFirst: vi.fn(), create: vi.fn(), update: vi.fn() },
+  },
+}));
+
+vi.mock("@calcom/lib/constants", () => ({
+  APP_CREDENTIAL_SHARING_ENABLED: true,
+}));
+
+vi.mock("@calcom/lib/crypto", () => ({
+  symmetricDecrypt: vi.fn(() => JSON.stringify({ accessToken: "token" })),
+}));
+
+vi.mock("@calcom/app-store/appStoreMetaData", () => ({
+  appStoreMetadata: {
+    "test-app": { slug: "test-app", type: "test_type" },
+  },
+}));
+
+it("does not create duplicate credentials when two webhook requests race", async () => {
+  process.env.CALCOM_WEBHOOK_SECRET = "secret";
+  process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
+  process.env.CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY = "key";
+
+  const { default: handler } = await import("./app-credential");
+  const prisma = (await import("@calcom/prisma")).default;
+
+  prisma.user.findUnique.mockResolvedValue({ id: 1 });
+  prisma.app.findUnique.mockResolvedValue({ slug: "test-app" });
+  prisma.credential.findFirst.mockResolvedValue(null);
+  prisma.credential.create.mockResolvedValue({ id: 1 });
+
+  const req = {
+    headers: { "calcom-webhook-secret": "secret" },
+    body: { userId: 1, appSlug: "test-app", keys: "encrypted" },
+  } as any;
+
+  const res = {
+    status: vi.fn().mockReturnThis(),
+    json: vi.fn().mockReturnThis(),
+  } as any;
+
+  await Promise.all([handler(req, res), handler(req, res)]);
+
+  // On current code both requests miss findFirst and call create -> 2 creates
+  expect(prisma.credential.create).toHaveBeenCalledTimes(1);
+});
