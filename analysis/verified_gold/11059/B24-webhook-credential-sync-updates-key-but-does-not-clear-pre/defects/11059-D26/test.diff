import { describe, it, expect, vi, beforeEach } from "vitest";

// Set env vars before importing the module under test (and any modules it imports)
process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
process.env.CALCOM_WEBHOOK_SECRET = "supersecret";
process.env.CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY = "testkey";

const prismaMock = {
  user: {
    findUnique: vi.fn(),
  },
  app: {
    findUnique: vi.fn(),
  },
  credential: {
    findFirst: vi.fn(),
    update: vi.fn(),
    create: vi.fn(),
  },
};

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn(() => JSON.stringify({ apiKey: "new-valid-key" })),
}));

vi.mock("@calcom/prisma", () => ({
  default: prismaMock,
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {
    "google-calendar": {
      slug: "google-calendar",
      type: "google_calendar",
    },
  },
}));

function makeRes() {
  const res: any = {
    statusCode: undefined as number | undefined,
    body: undefined as any,
    status(code: number) {
      res.statusCode = code;
      return res;
    },
    json(payload: any) {
      res.body = payload;
      return res;
    },
  };
  return res;
}

describe("apps/web/pages/api/webhook/app-credential.ts", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("Webhook credential sync updates key but does not clear previously set invalid flag", async () => {
    prismaMock.user.findUnique.mockResolvedValue({ id: 123 });
    prismaMock.app.findUnique.mockResolvedValue({ slug: "google-calendar" });
    prismaMock.credential.findFirst.mockResolvedValue({ id: 999 });
    prismaMock.credential.update.mockResolvedValue({ id: 999 });

    const req: any = {
      headers: {
        "calcom-webhook-secret": "supersecret",
      },
      body: {
        userId: 123,
        appSlug: "google-calendar",
        keys: "encrypted-payload",
      },
    };
    const res = makeRes();

    const mod = await import("./app-credential");
    await mod.default(req, res as any);

    expect(prismaMock.credential.update).toHaveBeenCalledTimes(1);

    // Claimed behavior: when updating an existing credential, the handler must clear any previously-set invalid flag.
    expect(prismaMock.credential.update).toHaveBeenCalledWith(
      expect.objectContaining({
        where: { id: 999 },
        data: {
          key: { apiKey: "new-valid-key" },
          invalid: false,
        },
      })
    );
  });
});
