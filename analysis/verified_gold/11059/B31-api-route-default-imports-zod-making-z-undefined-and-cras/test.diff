diff --git a/apps/web/pages/api/webhook/app-credential.verified.test.ts b/apps/web/pages/api/webhook/app-credential.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/pages/api/webhook/app-credential.verified.test.ts
@@ -0,0 +1,56 @@
+import { describe, it, expect, vi } from "vitest";
+
+// Simulate the real-world failure mode: zod provides no usable default export.
+// The route must therefore use `import { z } from "zod"`.
+vi.mock("zod", () => {
+  const z = {
+    object: (_shape: unknown) => ({
+      parse: (v: unknown) => v,
+    }),
+    number: () => ({
+      int: () => ({}),
+    }),
+    string: () => ({}),
+  };
+
+  return {
+    __esModule: true,
+    // Critical: default export is missing/undefined, matching the claim.
+    default: undefined,
+    z,
+  };
+});
+
+// Mock true externals that the API route imports at module-load time.
+vi.mock("@calcom/app-store/appStoreMetaData", () => ({
+  appStoreMetadata: {},
+}));
+
+vi.mock("@calcom/lib/constants", () => ({
+  APP_CREDENTIAL_SHARING_ENABLED: false,
+}));
+
+vi.mock("@calcom/lib/crypto", () => ({
+  symmetricDecrypt: (s: string) => s,
+}));
+
+vi.mock("@calcom/prisma", () => ({
+  default: {
+    user: { findUnique: vi.fn() },
+    app: { findUnique: vi.fn() },
+    credential: { findFirst: vi.fn(), update: vi.fn(), create: vi.fn() },
+  },
+}));
+
+describe("/api/webhook/app-credential module load", () => {
+  it("API route should not crash on module load when zod has no default export (must import { z })", async () => {
+    process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
+    process.env.CALCOM_WEBHOOK_SECRET = "secret";
+    process.env.CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY = "key";
+
+    await expect(
+      import("./app-credential"),
+      "API route should not crash on module load when zod has no default export (must import { z })"
+    ).resolves.toHaveProperty("default");
+  });
+});
