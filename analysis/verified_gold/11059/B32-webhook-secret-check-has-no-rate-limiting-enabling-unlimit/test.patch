import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";

function createRes() {
  const res: any = {
    statusCode: undefined as number | undefined,
    body: undefined as any,
    status(code: number) {
      this.statusCode = code;
      return this;
    },
    json(payload: any) {
      this.body = payload;
      return this;
    },
  };
  return res;
}

describe("/api/webhook/app-credential rate limiting", () => {
  beforeEach(() => {
    vi.resetModules();
    vi.useFakeTimers();
    vi.setSystemTime(new Date("2026-01-01T00:00:00.000Z"));

    process.env.CALCOM_WEBHOOK_SECRET = "correct-secret";
    delete process.env.CALCOM_WEBHOOK_HEADER_NAME; // use default
    process.env.CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY = "test";

    vi.doMock("@calcom/lib/constants", () => ({
      APP_CREDENTIAL_SHARING_ENABLED: true,
    }));

    // Ensure module under test can load without requiring real infra.
    vi.doMock("@calcom/prisma", () => ({
      default: {
        user: { findUnique: vi.fn() },
        app: { findUnique: vi.fn() },
        credential: {
          findFirst: vi.fn(),
          update: vi.fn(),
          create: vi.fn(),
        },
      },
    }));

    vi.doMock("@calcom/app-store/appStoreMetaData", () => ({
      appStoreMetadata: {},
    }));

    vi.doMock("@calcom/lib/crypto", () => ({
      symmetricDecrypt: (v: string) => v,
    }));
  });

  afterEach(() => {
    vi.useRealTimers();
  });

  it("should rate limit repeated invalid webhook secret attempts (prevents unlimited online guessing)", async () => {
    const mod = await import("./app-credential");
    const handler = mod.default;

    const reqBase: any = {
      headers: {
        "calcom-webhook-secret": "wrong-secret",
        "x-forwarded-for": "203.0.113.10",
      },
      body: { userId: 1, appSlug: "x", keys: "{}" },
      socket: { remoteAddress: "203.0.113.10" },
    };

    // First 5 invalid guesses: 403
    for (let i = 0; i < 5; i++) {
      const res = createRes();
      await handler({ ...reqBase }, res);
      expect(res.statusCode).toBe(403);
      expect(res.body?.message).toBe("Invalid webhook secret");
    }

    // 6th guess in same window should be rate-limited
    const res6 = createRes();
    await handler({ ...reqBase }, res6);

    expect(
      res6.statusCode,
      "CLAIM: Webhook secret check has no rate limiting, enabling unlimited online guessing/brute force"
    ).toBe(429);
    expect(res6.body?.message).toMatch(/too many/i);
  });
});
