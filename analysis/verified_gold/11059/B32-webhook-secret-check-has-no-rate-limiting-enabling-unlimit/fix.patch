   // Keys should be AES256 encrypted with the CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY
   keys: z.string(),
 });
+
+// Minimal in-memory rate limit for invalid secret guessing attempts.
+// Note: In serverless environments this may be per-instance, but it still prevents unlimited guessing.
+const MAX_INVALID_SECRET_ATTEMPTS = 5;
+const INVALID_SECRET_WINDOW_MS = 60_000;
+const invalidSecretAttempts = new Map<string, { count: number; windowStart: number }>();
+
+function getClientIp(req: NextApiRequest) {
+  const xff = req.headers["x-forwarded-for"];
+  const forwarded = Array.isArray(xff) ? xff[0] : xff;
+  const ipFromHeader = forwarded?.split(",")[0]?.trim();
+  return ipFromHeader || req.socket?.remoteAddress || "unknown";
+}
+
+function isRateLimited(ip: string, now: number) {
+  const entry = invalidSecretAttempts.get(ip);
+  if (!entry) return false;
+  if (now - entry.windowStart > INVALID_SECRET_WINDOW_MS) {
+    invalidSecretAttempts.delete(ip);
+    return false;
+  }
+  return entry.count >= MAX_INVALID_SECRET_ATTEMPTS;
+}
+
+function recordInvalidSecret(ip: string, now: number) {
+  const entry = invalidSecretAttempts.get(ip);
+  if (!entry || now - entry.windowStart > INVALID_SECRET_WINDOW_MS) {
+    invalidSecretAttempts.set(ip, { count: 1, windowStart: now });
+    return;
+  }
+  entry.count += 1;
+  invalidSecretAttempts.set(ip, entry);
+}
+
