import { beforeEach, describe, expect, it, vi } from "vitest";

const { findUnique } = vi.hoisted(() => ({ findUnique: vi.fn() }));

vi.mock("@calcom/prisma", () => ({
  default: {
    user: { findUnique },
    app: { findUnique: vi.fn() },
    credential: { findFirst: vi.fn(), update: vi.fn(), create: vi.fn() },
  },
}));

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn(),
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {},
}));

describe("app-credential webhook secret auth", () => {
  beforeEach(() => {
    vi.resetModules();
    findUnique.mockReset();
    delete process.env.CALCOM_WEBHOOK_HEADER_NAME;
    delete process.env.CALCOM_WEBHOOK_SECRET;
  });

  it("rejects requests when webhook secret is unset and the webhook header is absent", async () => {
    findUnique.mockResolvedValue(null);
    const { default: handler } = await import("./app-credential");

    const req = {
      method: "POST",
      headers: {},
      body: { userId: 1, appSlug: "test-app", keys: "encrypted" },
    } as any;

    const statusMock = vi.fn().mockReturnThis();
    const jsonMock = vi.fn().mockReturnThis();
    const res = { status: statusMock, json: jsonMock } as any;

    await handler(req, res);

    expect(statusMock).toHaveBeenCalledWith(403);
    expect(jsonMock).toHaveBeenCalledWith(
      expect.objectContaining({ message: "Invalid webhook secret" })
    );
  });
});
