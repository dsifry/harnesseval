import { beforeEach, describe, expect, it, vi } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

const prismaMock = {
  user: { findUnique: vi.fn() },
  app: { findUnique: vi.fn() },
  credential: {
    findFirst: vi.fn(),
    update: vi.fn(),
    create: vi.fn(),
  },
};

vi.mock("@calcom/prisma", () => ({
  default: prismaMock,
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {
    "test-app": { slug: "test-app", type: "test" },
  },
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn(() => "{}"),
}));

describe("app-credential webhook", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("accepts a valid secret when CALCOM_WEBHOOK_HEADER_NAME contains uppercase letters", async () => {
    process.env.CALCOM_WEBHOOK_HEADER_NAME = "Calcom-Webhook-Secret";
    process.env.CALCOM_WEBHOOK_SECRET = "super-secret";

    const { default: handler } = await import("./app-credential");

    const req = {
      method: "POST",
      headers: {
        // Node.js lowercases incoming header keys
        "calcom-webhook-secret": "super-secret",
      },
      body: {
        userId: 1,
        appSlug: "test-app",
        keys: "encrypted",
      },
    } as any;

    const res = {
      status: vi.fn().mockReturnThis(),
      json: vi.fn().mockReturnThis(),
    } as any;

    prismaMock.user.findUnique.mockResolvedValue({ id: 1 });
    prismaMock.app.findUnique.mockResolvedValue({ slug: "test-app" });
    prismaMock.credential.findFirst.mockResolvedValue(null);
    prismaMock.credential.create.mockResolvedValue({});

    await handler(req, res);

    expect(res.status).not.toHaveBeenCalledWith(403);
    expect(res.status).toHaveBeenCalledWith(200);
    expect(res.json).toHaveBeenCalledWith({ message: "Credentials created for userId: 1" });
  });
});