import { beforeEach, expect, it, vi } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/prisma", () => ({
  default: {
    user: { findUnique: vi.fn().mockResolvedValue(null) },
    app: { findUnique: vi.fn() },
    credential: { findFirst: vi.fn(), update: vi.fn(), create: vi.fn() },
  },
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn(),
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {},
}));

beforeEach(() => {
  process.env.CALCOM_WEBHOOK_HEADER_NAME = "CalCom-Webhook-Secret";
  process.env.CALCOM_WEBHOOK_SECRET = "s3cret";
});

it("matches the incoming lowercased webhook header even when CALCOM_WEBHOOK_HEADER_NAME contains uppercase", async () => {
  const { default: handler } = await import("./app-credential");

  let responseBody: { message?: string } = {};
  const res = {
    status(code: number) {
      void code;
      return this;
    },
    json(payload: { message?: string }) {
      responseBody = payload;
      return this;
    },
  };

  const req = {
    headers: { "calcom-webhook-secret": "s3cret" },
    body: { userId: 1, appSlug: "some-app", keys: "encrypted-keys" },
  };

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  await handler(req as any, res as any);

  expect(
    responseBody.message,
    "the mixed-case CALCOM_WEBHOOK_HEADER_NAME should be lowercased before lookup so the lowercased incoming header matches"
  ).toBe("User not found");
});
