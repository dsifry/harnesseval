import { afterEach, beforeEach, expect, test, vi } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

const fetchMock = vi.fn();

beforeEach(() => {
  process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT = "https://example.com/credential-sync";
  vi.stubGlobal("fetch", fetchMock);
  fetchMock.mockReset();
});

afterEach(() => {
  delete process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT;
  vi.unstubAllGlobals();
});

test("hubspot credential sync refresh returns a token object, not the raw fetch response", async () => {
  // A fetch Response has no accessToken/refreshToken fields; spreading it yields undefined tokens.
  const rawSyncResponse = {
    status: 200,
    ok: true,
    json: async () => ({}),
  } as unknown as Response;
  fetchMock.mockResolvedValue(rawSyncResponse);

  const { default: refreshOAuthTokens } = await import("./refreshOAuthTokens");

  const result = await refreshOAuthTokens(
    async () => ({ accessToken: "fallback-access", refreshToken: "fallback-refresh" }),
    "hubspot",
    42
  );

  // The credential-sync path must produce a HubSpotToken-like object, not the raw fetch response.
  expect(result).not.toBe(rawSyncResponse);
  expect((result as { accessToken?: unknown }).accessToken).toBeDefined();
  expect((result as { refreshToken?: unknown }).refreshToken).toBeDefined();
});