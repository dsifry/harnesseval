import { expect, test, vi, beforeEach, afterEach } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

const originalEnv = process.env;

beforeEach(() => {
  vi.resetModules();
  process.env = { ...originalEnv, CALCOM_CREDENTIAL_SYNC_ENDPOINT: "https://example.com/sync" };
});

afterEach(() => {
  process.env = originalEnv;
  vi.restoreAllMocks();
});

test("credential sharing returns parsed token data, not a raw fetch Response", async () => {
  const tokenData = { access_token: "test-token", expiry_date: 1234567890 };
  const mockResponse = new Response(JSON.stringify(tokenData), {
    status: 200,
    headers: { "Content-Type": "application/json" },
  });
  const fetchMock = vi.fn().mockResolvedValue(mockResponse);
  vi.stubGlobal("fetch", fetchMock);

  const { default: refreshOAuthTokens } = await import("./refreshOAuthTokens");

  const result = await refreshOAuthTokens(async () => ({ fallback: true }), "lark", 42);

  // The function should parse the response body and return the token data.
  // If it returns the raw Response, callers like handleLarkError will receive
  // a Response object instead of the expected token object.
  expect(result).not.toBeInstanceOf(Response);
  expect(result).toEqual(tokenData);
});
