import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";

// Feature flag is an external dependency for this unit
vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

describe("refreshOAuthTokens (credential-sync)", () => {
  const originalEnv = process.env;

  beforeEach(() => {
    process.env = { ...originalEnv };
    process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT = "https://example.test/credential-sync";
    process.env.CALCOM_CREDENTIAL_SYNC_SECRET = "supersecret";

    globalThis.fetch = vi.fn().mockResolvedValue({ ok: true }) as any;
  });

  afterEach(() => {
    process.env = originalEnv;
    vi.restoreAllMocks();
  });

  it("includes an Authorization header (shared secret) when calling the credential-sync endpoint", async () => {
    const { default: refreshOAuthTokens } = await import("./refreshOAuthTokens");

    const refreshFunction = vi.fn(() => {
      throw new Error("refreshFunction should not be called when credential-sync is enabled");
    });

    await refreshOAuthTokens(refreshFunction, "zoom", 123);

    expect(globalThis.fetch).toHaveBeenCalledTimes(1);

    const [url, options] = (globalThis.fetch as any).mock.calls[0];
    expect(url).toBe(process.env.CALCOM_CREDENTIAL_SYNC_ENDPOINT);

    // Executable evidence of the claim: request must carry caller authentication
    expect(options?.headers?.Authorization).toBe(
      `Bearer ${process.env.CALCOM_CREDENTIAL_SYNC_SECRET}`
    );
  });
});
