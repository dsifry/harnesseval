   // Keys should be AES256 encrypted with the CALCOM_APP_CREDENTIAL_ENCRYPTION_KEY
   keys: z.string(),
 });
+
+function getHeaderValue(req: NextApiRequest, headerName: string) {
+  const val = req.headers[headerName];
+  if (typeof val === "string") return val;
+  return undefined;
+}
+
+function getPerUserExpectedSecret(userId: number, appSlug: string) {
+  const raw = process.env.CALCOM_WEBHOOK_SECRETS;
+  if (!raw) {
+    // Refuse insecure instance-wide shared secret configuration.
+    return { ok: false as const, error: "Per-user webhook secrets not configured" };
+  }
+
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch {
+    return { ok: false as const, error: "Per-user webhook secrets not configured" };
+  }
+
+  if (!parsed || typeof parsed !== "object") {
+    return { ok: false as const, error: "Per-user webhook secrets not configured" };
+  }
+
+  const map = parsed as Record<string, unknown>;
+  const scoped = map[`${userId}:${appSlug}`];
+  const perUser = map[String(userId)];
+
+  const secret = (typeof scoped === "string" && scoped) || (typeof perUser === "string" && perUser) || undefined;
+  if (!secret) {
+    return { ok: false as const, error: "Missing per-user webhook secret" };
+  }
+
+  return { ok: true as const, secret };
+}
+
