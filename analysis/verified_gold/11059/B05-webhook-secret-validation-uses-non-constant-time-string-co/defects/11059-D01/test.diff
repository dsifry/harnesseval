import { describe, it, expect, vi } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/prisma", () => ({
  default: {
    user: {
      findUnique: vi.fn(async () => null),
    },
    app: {
      findUnique: vi.fn(async () => null),
    },
    credential: {
      findFirst: vi.fn(async () => null),
      update: vi.fn(async () => null),
      create: vi.fn(async () => null),
    },
  },
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {},
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn(() => "{}"),
}));

vi.mock("crypto", async (importOriginal) => {
  const actual = await importOriginal<typeof import("crypto")>();
  return {
    ...actual,
    // Wrap to observe usage without changing behavior
    timingSafeEqual: vi.fn(actual.timingSafeEqual),
  };
});

describe("apps/web/pages/api/webhook/app-credential", () => {
  it("treats webhook header lookup as case-insensitive and uses timingSafeEqual for secret validation", async () => {
    process.env.CALCOM_WEBHOOK_SECRET = "supersecret";
    // Mixed-case env var simulates config as commonly written in docs
    process.env.CALCOM_WEBHOOK_HEADER_NAME = "Calcom-Webhook-Secret";

    const crypto = await import("crypto");

    const req = {
      headers: {
        // Node/Next normalize incoming header keys to lowercase
        "calcom-webhook-secret": "supersecret",
      },
      body: {
        userId: 123,
        appSlug: "zoom",
        keys: "{}",
      },
    } as any;

    const res = {
      statusCode: 0,
      body: undefined as any,
      status(code: number) {
        this.statusCode = code;
        return this;
      },
      json(payload: any) {
        this.body = payload;
        return this;
      },
    } as any;

    const { default: handler } = await import("./app-credential");
    await handler(req, res);

    expect(
      res.statusCode,
      "should accept mixed-case CALCOM_WEBHOOK_HEADER_NAME and validate secret using timingSafeEqual"
    ).toBe(404);
    expect(res.body).toEqual({ message: "User not found" });

    expect(
      (crypto as any).timingSafeEqual,
      "should use crypto.timingSafeEqual for webhook secret validation"
    ).toHaveBeenCalled();
  });
});
