import { describe, it, expect, vi, beforeEach } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/prisma", () => ({
  default: {
    user: { findUnique: vi.fn() },
    app: { findUnique: vi.fn() },
    credential: { findFirst: vi.fn(), update: vi.fn(), create: vi.fn() },
  },
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn(() => "{}"),
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {},
}));

describe("app-credential webhook rate limiting", () => {
  beforeEach(() => {
    process.env.CALCOM_WEBHOOK_SECRET = "correct-secret";
    process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
    vi.clearAllMocks();
  });

  it("should rate limit repeated failed authentication attempts", async () => {
    const { default: handler } = await import("./app-credential");

    const requestCount = 20;
    const statusCodes: number[] = [];

    for (let i = 0; i < requestCount; i++) {
      const req = {
        headers: { "calcom-webhook-secret": "wrong-secret" },
        body: {},
        method: "POST",
        socket: { remoteAddress: "127.0.0.1" },
      } as any;
      const res = {
        statusCode: 0,
        status: (code: number) => {
          res.statusCode = code;
          return res;
        },
        json: (data: any) => {
          res.body = data;
          return res;
        },
      } as any;

      await handler(req, res);
      statusCodes.push(res.statusCode);
    }

    expect(statusCodes).toContain(429);
  });
});
