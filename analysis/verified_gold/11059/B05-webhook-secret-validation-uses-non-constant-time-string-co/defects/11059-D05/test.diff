import { beforeEach, describe, expect, it, vi } from "vitest";

vi.mock("@calcom/lib/constants", () => ({
  APP_CREDENTIAL_SHARING_ENABLED: true,
}));

vi.mock("@calcom/prisma", () => ({
  default: {
    user: { findUnique: vi.fn().mockResolvedValue({ id: 1 }) },
    app: { findUnique: vi.fn().mockResolvedValue({ slug: "test" }) },
    credential: {
      findFirst: vi.fn().mockResolvedValue(null),
      create: vi.fn().mockResolvedValue({ id: 1 }),
      update: vi.fn().mockResolvedValue({ id: 1 }),
    },
  },
}));

vi.mock("@calcom/app-store/appStoreMetaData", () => ({
  appStoreMetadata: {
    test: { slug: "test", type: "test_type" },
  },
}));

vi.mock("@calcom/lib/crypto", () => ({
  symmetricDecrypt: vi.fn().mockReturnValue("{}"),
}));

describe("app-credential webhook secret verification", () => {
  beforeEach(() => {
    process.env.CALCOM_WEBHOOK_HEADER_NAME = "calcom-webhook-secret";
    process.env.CALCOM_WEBHOOK_SECRET = "top-secret";
  });

  it("accepts a duplicated header (array value) as the valid secret", async () => {
    const { default: handler } = await import("./app-credential");

    const req = {
      headers: {
        "calcom-webhook-secret": ["top-secret", "top-secret"],
      },
      body: {
        userId: 1,
        appSlug: "test",
        keys: "encrypted",
      },
    } as any;

    const res = {
      status: vi.fn().mockReturnThis(),
      json: vi.fn().mockReturnThis(),
    } as any;

    await handler(req, res);

    expect(
      res.status,
      "Duplicated header array should still be verified against the secret"
    ).not.toHaveBeenCalledWith(403);
  });
});
