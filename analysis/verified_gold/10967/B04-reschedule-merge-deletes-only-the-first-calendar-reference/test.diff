+describe("handleCancelBooking — recurring collective cancellation", () => {
+  beforeEach(() => {
+    deleteEventMock.mockClear();
+  });
+
+  it("deletes each recurring event exactly once, not once per calendar reference", async () => {
+    const prisma = (await import("@calcom/prisma")).default as any;
+
+    const organizer = {
+      id: 1,
+      email: "organizer@example.com",
+      name: "Organizer",
+      timeZone: "UTC",
+      destinationCalendar: null,
+      credentials: [
+        { id: 11, type: "google_calendar", key: {}, appId: "google-calendar" },
+        { id: 22, type: "office365_calendar", key: {}, appId: "office365-calendar" },
+      ],
+    };
+
+    const bookingToDelete = {
+      id: 1,
+      uid: "booking-1",
+      title: "Collective",
+      description: "",
+      startTime: new Date("2030-01-01T10:00:00Z"),
+      endTime: new Date("2030-01-01T11:00:00Z"),
+      location: "integrations:zoom",
+      paid: false,
+      status: "ACCEPTED",
+      recurringEventId: "recurring-1",
+      customInputs: {},
+      responses: {},
+      attendees: [],
+      user: organizer,
+      userPrimaryEmail: organizer.email,
+      eventType: {
+        id: 1,
+        title: "ET",
+        recurringEvent: { freq: 2, count: 5, interval: 1 },
+        bookingFields: null,
+        owner: null,
+        teamId: null,
+        seatsPerTimeSlot: null,
+      },
+      eventTypeId: 1,
+      references: [
+        { id: 1, type: "google_calendar", uid: "g-cal-uid", credentialId: 11, externalCalendarId: "g-ext" },
+        { id: 2, type: "office365_calendar", uid: "o-cal-uid", credentialId: 22, externalCalendarId: "o-ext" },
+      ],
+      payment: [],
+      destinationCalendar: null,
+      smsReminders: [],
+      emailReminders: [],
+      workflowReminders: [],
+      seatsReferences: [],
+      team: null,
+      metadata: {},
+    };
+
+    const updatedBookings = [
+      {
+        ...bookingToDelete,
+        id: 2,
+        uid: "booking-2",
+        references: [
+          { id: 3, type: "google_calendar", uid: "g-cal-uid-2", credentialId: 11, externalCalendarId: "g-ext-2" },
+        ],
+      },
+      {
+        ...bookingToDelete,
+        id: 3,
+        uid: "booking-3",
+        references: [
+          { id: 4, type: "office365_calendar", uid: "o-cal-uid-2", credentialId: 22, externalCalendarId: "o-ext-2" },
+        ],
+      },
+    ];
+
+    prisma.booking.findUnique.mockResolvedValue(bookingToDelete);
+    prisma.booking.findMany.mockResolvedValue(updatedBookings);
+    prisma.booking.update.mockResolvedValue(bookingToDelete);
+
+    const { default: handler } = await import("./handleCancelBooking");
+
+    const req: any = {
+      method: "POST",
+      body: { id: 1, uid: "booking-1", allRemainingBookings: true, cancellationReason: "test" },
+      query: { id: "1", uid: "booking-1" },
+      headers: {},
+      cookies: {},
+      session: {
+        user: { id: 1, email: "organizer@example.com", role: "USER", username: "organizer" },
+      },
+    };
+
+    try {
+      await handler(req);
+    } catch {
+      // unrelated cleanup paths may throw; we only assert calendar delete fan-out
+    }
+
+    // 2 calendar credentials x 2 updated bookings = 4 unique deleteEvent calls.
+    // The recurring branch must not re-run the whole sweep once per calendar
+    // reference on bookingToDelete, which would yield 8 calls.
+    expect(deleteEventMock.mock.calls.length).toBe(4);
+  });
+});
