import { createMeeting } from "./videoClient";
import EventManager from "./EventManager";

describe("EventManager video reference credentialId", () => {
  it("persists the video integration credentialId on non-calendar references returned by create()", async () => {
    const videoCredentialId = 42;

    vi.mocked(createMeeting).mockImplementation(async (_credential: any, event: any) => ({
      type: "office365_video",
      success: true,
      uid: event.uid,
      createdEvent: {
        id: "video-meeting-abc",
        type: "office365_video",
        url: "https://video.example.com/abc",
        password: "",
      },
      originalEvent: event,
      credentialId: videoCredentialId,
    }));

    const manager = new EventManager([
      {
        id: videoCredentialId,
        type: "office365_video",
        appId: "office365-video",
        userId: 1,
        key: {},
        invalid: false,
        appName: "office365-video",
      } as any,
    ] as any);

    const event: any = {
      uid: "booking-uid-123",
      type: "test-event",
      title: "Test",
      description: "",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
      location: "integrations:office365-video",
      destinationCalendar: [
        {
          integration: "google_calendar",
          externalId: "ext-1",
          credentialId: 999,
        },
      ],
      attendees: [],
      organizer: {
        email: "organizer@example.com",
        name: "Organizer",
        timeZone: "UTC",
        language: { locale: "en" },
      },
      customInputs: [],
      videoCallData: undefined,
      conferenceData: undefined,
    };

    const result = await (manager as any).create(event);

    const videoReference = result.referencesToCreate.find(
      (ref: any) => !ref.type.includes("_calendar")
    );

    // Claimed behavior: video (non-calendar) references must retain the
    // credentialId of the video integration result so later cancel/update
    // lookups can resolve the account. Current post-PR code always writes
    // `undefined` here for non-calendar results.
    expect(videoReference, "expected a non-calendar (video) reference to be returned").toBeDefined();
    expect(
      videoReference.credentialId,
      "video reference must persist the video integration credentialId"
    ).toBe(videoCredentialId);
  });
});
