import { describe, expect, it, vi, beforeEach } from "vitest";

vi.mock("@calcom/prisma", () => ({
  default: {
    credential: {
      findUnique: vi.fn(),
    },
  },
}));

vi.mock("./videoClient", () => ({
  createMeeting: vi.fn(),
  updateMeeting: vi.fn(),
}));

vi.mock("./CalendarManager", () => ({
  createEvent: vi.fn().mockResolvedValue(null),
  updateEvent: vi.fn(),
}));

import EventManager from "./EventManager";
import { createMeeting } from "./videoClient";

describe("EventManager video reference credentialId", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("should preserve credentialId for non-calendar (video) references", async () => {
    const mockVideoResult = {
      credentialId: "video-cred-1",
      type: "daily_video",
      createdEvent: {
        id: "meeting-123",
        type: "daily_video",
      },
      originalEvent: {
        location: "integrations:daily",
      },
    };
    (createMeeting as any).mockResolvedValue(mockVideoResult);

    const eventManager = new EventManager([]);
    const event = {
      type: "test",
      title: "Test",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
      location: "integrations:daily",
      destinationCalendar: [],
    } as any;

    const result = await eventManager.createEvent(event);

    expect(result.referencesToCreate).toHaveLength(1);
    expect(result.referencesToCreate[0].credentialId).toBe("video-cred-1");
  });
});
