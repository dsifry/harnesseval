+  const booking: any = {
+    id: 1,
+    uid: "booking-uid",
+    title: "Test",
+    description: "",
+    startTime: new Date("2024-01-01T10:00:00Z"),
+    endTime: new Date("2024-01-01T11:00:00Z"),
+    location: null,
+    status: "ACCEPTED",
+    recurringEventId: null,
+    teamId: null,
+    userId: 1,
+    eventTypeId: 1,
+    metadata: null,
+    destinationCalendar: null,
+    payment: [],
+    attendees: [],
+    seatsReferences: [],
+    workflowReminders: [],
+    references: [
+      { type: "google_calendar", credentialId: 999, uid: "ext-uid", externalCalendarId: "ext-cal" },
+    ],
+    user: {
+      id: 1,
+      email: "u@example.com",
+      name: "User",
+      username: "user",
+      avatarUrl: null,
+      timeZone: "UTC",
+      timeFormat: 12,
+      locale: "en",
+      credentials: [],
+      destinationCalendar: null,
+      role: "USER",
+      completedOnboarding: true,
+    },
+    eventType: {
+      id: 1,
+      slug: "test",
+      eventName: "Test",
+      recurringEvent: null,
+      seatsPerTimeSlot: null,
+      teamId: null,
+      owner: null,
+      team: null,
+      metadata: null,
+      requiresConfirmation: false,
+    },
+  };
+  const prismaMock: any = {
+    booking: {
+      findUnique: vi.fn(async () => booking),
+      findMany: vi.fn(async () => [booking]),
+      update: vi.fn(async () => booking),
+    },
+    credential: {
+      findUnique: vi.fn(async () => ({
+        id: 999,
+        type: "google_calendar",
+        key: {},
+        userId: 1,
+        appId: null,
+        app: null,
+      })),
+    },
+    bookingReference: { deleteMany: vi.fn(async () => ({ count: 0 })) },
+    webhook: { findMany: vi.fn(async () => []) },
+    workflowReminder: { findMany: vi.fn(async () => []) },
+  };
+  return { getCalendarCalls, booking, prismaMock };
+});
+
+vi.mock("@calcom/prisma", () => ({ prisma: prismaMock, bookingMinimalSelect: {} }));
+vi.mock("@calcom/app-store/_utils/getCalendar", () => ({
+  getCalendar: vi.fn(async (credential: any) => {
+    getCalendarCalls.push(credential);
+    return { deleteEvent: vi.fn(async () => ({ id: "deleted" })) };
+  }),
+}));
+vi.mock("@calcom/app-store", () => ({ default: new Proxy({}, { get: () => async () => ({}) }) }));
+vi.mock("@calcom/app-store/dailyvideo/lib/VideoApiAdapter", () => ({ FAKE_DAILY_CREDENTIAL: {} }));
+vi.mock("@calcom/app-store/locations", () => ({ DailyLocationType: "daily" }));
+vi.mock("@calcom/app-store/zapier/lib/nodeScheduler", () => ({ cancelScheduledJobs: vi.fn() }));
+vi.mock("@calcom/core/videoClient", () => ({ deleteMeeting: vi.fn(async () => ({})), updateMeeting: vi.fn(async () => ({})) }));
+vi.mock("@calcom/emails", () => ({ sendCancelledEmails: vi.fn(async () => {}), sendCancelledSeatEmails: vi.fn(async () => {}) }));
+vi.mock("@calcom/features/webhooks/lib/getWebhooks", () => ({ default: vi.fn(async () => []) }));
+vi.mock("@calcom/features/webhooks/lib/sendPayload", () => ({ default: vi.fn(async () => {}) }));
+vi.mock("@calcom/features/ee/workflows/lib/reminders/emailReminderManager", () => ({ deleteScheduledEmailReminder: vi.fn() }));
+vi.mock("@calcom/features/ee/workflows/lib/reminders/smsReminderManager", () => ({ deleteScheduledSMSReminder: vi.fn() }));
+vi.mock("@calcom/features/ee/workflows/lib/reminders/whatsappReminderManager", () => ({ deleteScheduledWhatsappReminder: vi.fn() }));
+vi.mock("@calcom/features/ee/workflows/lib/reminders/reminderScheduler", () => ({ sendCancelledReminders: vi.fn(async () => {}) }));
+vi.mock("@calcom/features/ee/workflows/lib/isEventTypeOwnerKYCVerified", () => ({ isEventTypeOwnerKYCVerified: vi.fn(async () => true) }));
+vi.mock("@calcom/features/bookings/lib/getCalEventResponses", () => ({ getCalEventResponses: vi.fn(() => ({ responses: {}, editable: {} })) }));
+vi.mock("@calcom/lib/getTeamIdFromEventType", () => ({ getTeamIdFromEventType: vi.fn(async () => null) }));
+vi.mock("@calcom/lib/server/i18n", () => ({ getTranslation: vi.fn(async () => (k: string) => k) }));
+vi.mock("@calcom/lib/timeFormat", () => ({ getTimeFormatStringFromUserTimeFormat: vi.fn(() => "h:mma") }));
+vi.mock("@calcom/lib", () => ({ isPrismaObjOrUndefined: vi.fn(() => undefined), parseRecurringEvent: vi.fn(() => null) }));
+vi.mock("@calcom/lib/payment/handleRefundError", () => ({ handleRefundError: vi.fn() }));
+vi.mock("@calcom/lib/logger", () => ({ default: { error: vi.fn(), warn: vi.fn(), info: vi.fn(), debug: vi.fn() } }));
+
+describe("handleCancelBooking calendar fallback credential", () => {
+  it("passes a credential with appName to getCalendar when the reference credential is loaded from the DB fallback", async () => {
+    const handler = (await import("./handleCancelBooking")).default;
+    const req: any = { body: { id: 1, uid: "booking-uid" }, method: "POST", bookingToDelete: booking };
+    try {
+      await handler(req);
+    } catch {
+      // The handler may throw after the calendar deletion path; we only assert on the getCalendar calls.
+    }
+    const fallbackCall = getCalendarCalls.find((c) => c && c.id === 999);
+    expect(fallbackCall).toBeDefined();
+    expect(
+      fallbackCall.appName,
+      "DB-fallback credential passed to getCalendar must include appName (app.slug) so the calendar app can be resolved"
+    ).toBeTruthy();
+  });
+});
