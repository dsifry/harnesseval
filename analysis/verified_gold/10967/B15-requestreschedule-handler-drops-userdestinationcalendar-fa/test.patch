vi.mock("@calcom/prisma", () => {
  const booking = {
    id: 1,
    uid: "booking-uid",
    title: "Test Booking",
    description: "desc",
    customInputs: null,
    startTime: new Date("2024-01-01T10:00:00Z"),
    endTime: new Date("2024-01-01T11:00:00Z"),
    location: "Zoom",
    eventTypeId: 1,
    userId: 1,
    destinationCalendar: null,
    cancellationReason: null,
    smsReminderNumber: null,
    references: [],
    attendees: [],
    user: {
      id: 1,
      username: "testuser",
      name: "Test User",
      email: "test@example.com",
      timeZone: "UTC",
      locale: "en",
      avatarUrl: null,
      destinationCalendar: "user-destination-calendar-id",
    },
    eventType: {
      id: 1,
      title: "Test Event",
      slug: "test-event",
      teamId: null,
      parentId: null,
      bookingFields: null,
    },
  };

  const prismaTarget: Record<string, any> = {};
  const prismaProxy: any = new Proxy(prismaTarget, {
    get(target, prop: string) {
      if (!(prop in target)) {
        target[prop] = new Proxy(
          {},
          {
            get(t: any, p: string) {
              if (!(p in t)) t[p] = vi.fn().mockResolvedValue([]);
              return t[p];
            },
          }
        );
      }
      return target[prop];
    },
  });

  prismaProxy.booking = {
    findFirstOrThrow: vi.fn().mockResolvedValue(booking),
    findFirst: vi.fn().mockResolvedValue(booking),
    findUnique: vi.fn().mockResolvedValue(booking),
    findUniqueOrThrow: vi.fn().mockResolvedValue(booking),
  };

  return { prisma: prismaProxy };
});

