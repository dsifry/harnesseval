describe("requestRescheduleHandler destinationCalendar fallback", () => {
  it("falls back to user.destinationCalendar when bookingToReschedule.destinationCalendar is null", async () => {
    const { requestRescheduleHandler } = await import("./requestReschedule.handler");

    await requestRescheduleHandler({
      ctx: {
        user: {
          id: 1,
          username: "testuser",
          name: "Test User",
          email: "test@example.com",
          timeZone: "UTC",
          locale: "en",
          avatarUrl: null,
          destinationCalendar: "user-destination-calendar-id",
        } as any,
      },
      input: { bookingId: 1, rescheduleReason: "changed plans" } as any,
    });

    expect(sendPayloadMock).toHaveBeenCalled();
    const payload = sendPayloadMock.mock.calls[0][4] as { destinationCalendar: unknown };
    expect(payload.destinationCalendar).toEqual(["user-destination-calendar-id"]);
  });
});
