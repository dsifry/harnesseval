describe("handleCancelBooking - recurring event deletion", () => {
  it("should delete all calendar references for each updated booking, not just the first", async () => {
    const { getCalendar } = await import("@calcom/app-store/_utils/getCalendar");
    const prisma = (await import("@calcom/prisma")).default;

    const mockDeleteEvent = vi.fn().mockResolvedValue({});
    (getCalendar as any).mockResolvedValue({ deleteEvent: mockDeleteEvent });

    const mainBooking = {
      id: 1,
      userId: 1,
      uid: "main-uid",
      title: "Test Booking",
      description: "Test Description",
      status: "ACCEPTED",
      startTime: new Date(),
      endTime: new Date(),
      location: "integrations:google:meet",
      eventType: {
        id: 1,
        slug: "test-event",
        title: "Test Event",
        length: 30,
        recurringEvent: true,
        teamId: null,
        owner: { id: 1, username: "testuser", name: "Test User", email: "user@example.com", timeFormat: 12, locale: "en" },
      },
      recurringEventId: "recurring-123",
      user: {
        id: 1,
        username: "testuser",
        name: "Test User",
        email: "user@example.com",
        timeFormat: 12,
        locale: "en",
        credentials: [
          { id: 101, type: "google_calendar", key: {}, userId: 1, teamId: null, appId: "google", invalid: false },
        ],
      },
      references: [
        { type: "google_calendar", uid: "main-ref1", externalCalendarId: "main-cal1", credentialId: 101 },
        { type: "google_calendar", uid: "main-ref2", externalCalendarId: "main-cal2", credentialId: 101 },
      ],
      workflowReminders: [],
      scheduledJobs: [],
      attendees: [],
    };
    (prisma.booking.findUnique as any).mockResolvedValue(mainBooking);

    (prisma.booking.findMany as any).mockResolvedValue([
      { id: 2, uid: "upd-uid-1", recurringEventId: "recurring-123", status: "ACCEPTED", startTime: new Date(), endTime: new Date(),
        references: [
          { uid: "upd1-ref1", type: "google_calendar", externalCalendarId: "upd1-cal1", credentialId: 101 },
          { uid: "upd1-ref2", type: "google_calendar", externalCalendarId: "upd1-cal2", credentialId: 101 },
        ], workflowReminders: [], scheduledJobs: [] },
      { id: 3, uid: "upd-uid-2", recurringEventId: "recurring-123", status: "ACCEPTED", startTime: new Date(), endTime: new Date(),
        references: [
          { uid: "upd2-ref1", type: "google_calendar", externalCalendarId: "upd2-cal1", credentialId: 101 },
          { uid: "upd2-ref2", type: "google_calendar", externalCalendarId: "upd2-cal2", credentialId: 101 },
        ], workflowReminders: [], scheduledJobs: [] },
    ]);

    (prisma.booking.update as any).mockImplementation(({ where }: any) => {
      if (where.uid === "upd-uid-1") {
        return Promise.resolve({
          startTime: new Date(),
          endTime: new Date(),
          references: [
            { uid: "upd1-ref1", type: "google_calendar", externalCalendarId: "upd1-cal1", credentialId: 101 },
            { uid: "upd1-ref2", type: "google_calendar", externalCalendarId: "upd1-cal2", credentialId: 101 },
          ],
          workflowReminders: [],
          uid: "upd-uid-1",
          scheduledJobs: [],
        });
      }
      if (where.uid === "upd-uid-2") {
        return Promise.resolve({
          startTime: new Date(),
          endTime: new Date(),
          references: [
            { uid: "upd2-ref1", type: "google_calendar", externalCalendarId: "upd2-cal1", credentialId: 101 },
            { uid: "upd2-ref2", type: "google_calendar", externalCalendarId: "upd2-cal2", credentialId: 101 },
          ],
          workflowReminders: [],
          uid: "upd-uid-2",
          scheduledJobs: [],
        });
      }
      return Promise.resolve(null);
    });

    const { default: handleCancelBooking } = await import("./handleCancelBooking");
    const evt = {
      title: "Test Event",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
      additionalInformation: "",
      description: "",
      eventTypeId: 1,
    };

    await handleCancelBooking({
      body: { id: 1, uid: "main-uid", allRemainingBookings: true, cancellationReason: "User requested" },
      userId: 1,
    } as any);

    // The current code only deletes the first calendar reference of each updated booking.
    // It should delete all calendar references, including the secondary ones.
    expect(mockDeleteEvent).toHaveBeenCalledWith("upd1-ref2", expect.anything(), expect.anything());
    expect(mockDeleteEvent).toHaveBeenCalledWith("upd2-ref2", expect.anything(), expect.anything());
  });
});
