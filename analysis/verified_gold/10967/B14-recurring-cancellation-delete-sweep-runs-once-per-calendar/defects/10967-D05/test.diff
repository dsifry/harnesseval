describe("handleCancelBooking — recurring cancellation deletes every calendar reference per booking", () => {
  beforeEach(() => {
    deleteEventMock.mockClear();
    mockBookingFindUnique.mockReset();
    mockBookingFindMany.mockReset();
    mockBookingUpdate.mockClear();
    mockBookingUpdateMany.mockClear();
  });

  it("issues a calendar delete for EACH reference on every remaining recurring booking (secondary hosts included)", async () => {
    const { base, updatedBookingOne } = buildBookingFixture();

    mockBookingFindUnique.mockResolvedValue(base as unknown);
    mockBookingFindMany.mockResolvedValue([updatedBookingOne] as unknown);

    const mod = await import("./handleCancelBooking");
    const handler: (req: unknown) => Promise<unknown> = (mod as { default: (req: unknown) => Promise<unknown> }).default;

    const req = {
      body: {
        id: 1,
        uid: "booking-uid",
        allRemainingBookings: true,
        cancellationReason: "test",
      },
      userId: 10,
      statusCode: 200,
    };

    await handler(req);

    // updatedBookingOne has TWO references. The claim is that only the FIRST
    // (`references.find`) is deleted, leaving the secondary host's event orphaned.
    // A correct implementation must call deleteEvent once per reference.
    const deletedUids = deleteEventMock.mock.calls.map((call) => {
      const arg = call[0] as { uid?: string } | undefined;
      return arg?.uid;
    });

    expect(deletedUids).toContain("ref-a");
    expect(deletedUids).toContain("ref-b");
  });
});
