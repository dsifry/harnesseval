describe("handleCancelBooking recurring cancellation sweep", () => {
  beforeEach(() => {
    hoisted.deleteEventMock.mockReset();
    hoisted.deleteEventMock.mockResolvedValue({});

    hoisted.prisma.booking.findUnique.mockResolvedValue(buildBookingToDelete());
    hoisted.prisma.booking.findMany.mockResolvedValue([buildUpdatedBooking()]);
    hoisted.prisma.booking.update.mockResolvedValue(buildUpdatedBooking());
    hoisted.prisma.booking.updateMany.mockResolvedValue({ count: 1 });
    hoisted.prisma.booking.deleteMany.mockResolvedValue({ count: 0 });
    hoisted.prisma.attendee.deleteMany.mockResolvedValue({ count: 0 });
    hoisted.prisma.credential.findUnique.mockResolvedValue(null);
  });

  it("deletes each recurring calendar event once, regardless of how many calendar references exist", async () => {
    const mod: any = await import("./handleCancelBooking");
    const handler = mod.default?.default ?? mod.default ?? mod.handleCancelBooking;

    const req: any = {
      method: "POST",
      query: {},
      headers: {},
      cookies: {},
      body: {
        id: 1,
        uid: "booking-uid-1",
        allRemainingBookings: true,
        cancellationReason: "test cancellation",
      },
      session: {
        expires: "2100-01-01T00:00:00.000Z",
        hasValidLicense: true,
        user: {
          id: 1,
          email: "user@example.com",
          name: "User One",
          username: "user1",
          role: "USER",
          locale: "en",
          timeZone: "UTC",
        },
      },
    };

    const res: any = {
      status: vi.fn().mockReturnThis(),
      json: vi.fn().mockReturnThis(),
      send: vi.fn().mockReturnThis(),
      end: vi.fn().mockReturnThis(),
    };

    // Booking has 2 "_calendar" references, 1 calendar credential and 1 updated recurring booking:
    // the sweep covers each unique recurring event exactly once, so deleteEvent must be called once.
    await handler(req, res);

    expect(hoisted.deleteEventMock).toHaveBeenCalledTimes(1);
  });
});
