function makeModelMock() {
  const methods = [
    "findMany",
    "findUnique",
    "findUniqueOrThrow",
    "findFirst",
    "findFirstOrThrow",
    "create",
    "createMany",
    "update",
    "updateMany",
    "upsert",
    "delete",
    "deleteMany",
    "count",
    "aggregate",
    "groupBy",
  ];
  const model: Record<string, unknown> = {};
  for (const m of methods) {
    model[m] = vi.fn().mockResolvedValue([]);
  }
  return model;
}

const hoisted = vi.hoisted(() => {
  const deleteEventMock = vi.fn();

  const prisma: any = new Proxy(
    {},
    {
      get(target: any, prop: string) {
        if (prop === "then") return undefined;
        if (prop === "$transaction") {
          return vi.fn(async (arg: any) =>
            typeof arg === "function" ? arg(prisma) : Promise.all(arg)
          );
        }
        if (!target[prop]) {
          target[prop] = new Proxy(
            {},
            {
              get(model: any, method: string) {
                if (method === "then") return undefined;
                if (!model[method]) {
                  model[method] = vi.fn().mockResolvedValue([]);
                }
                return model[method];
              },
            }
          );
        }
        return target[prop];
      },
    }
  );

  return { deleteEventMock, prisma, makeModelMock };
});

