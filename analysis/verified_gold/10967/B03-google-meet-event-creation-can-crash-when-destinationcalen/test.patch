import { describe, expect, it, vi } from "vitest";

vi.mock("@calcom/prisma", () => ({
  default: {
    app: { findFirst: vi.fn().mockResolvedValue(null) },
    credential: { findUnique: vi.fn().mockResolvedValue(null) },
  },
}));

vi.mock("@calcom/app-store/utils", () => ({
  default: vi.fn().mockReturnValue([]),
}));

vi.mock("@calcom/app-store/locations", () => ({
  MeetLocationType: "integrations:google:meet",
  getEventLocationTypeFromApp: vi.fn().mockReturnValue(null),
}));

vi.mock("./CalendarManager", () => ({
  getCalendarCredentials: vi.fn(),
  createEvent: vi.fn().mockResolvedValue(undefined),
  updateEvent: vi.fn().mockResolvedValue(undefined),
}));

vi.mock("./videoClient", () => ({
  createMeeting: vi.fn().mockResolvedValue(undefined),
  updateMeeting: vi.fn().mockResolvedValue(undefined),
}));

describe("EventManager", () => {
  it("falls back to cal video without crashing when destinationCalendar is missing", async () => {
    const { default: EventManager } = await import("./EventManager");

    const manager = new EventManager({
      credentials: [],
      destinationCalendar: null,
    });

    // Once the fallback to cal video runs, short-circuit the external video call.
    vi.spyOn(EventManager.prototype as any, "createVideoEvent").mockResolvedValue({
      type: "daily_video",
      createdEvent: { id: "fake-meeting-id", type: "daily_video" },
      originalEvent: { location: "integrations:daily" },
    });

    const calendarEvent = {
      type: "test",
      title: "Test Event",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
      location: "integrations:google:meet",
      destinationCalendar: undefined,
    } as any;

    await expect(manager.create(calendarEvent)).resolves.toBeDefined();
  });

  it("falls back to cal video without crashing when destinationCalendar is empty", async () => {
    const { default: EventManager } = await import("./EventManager");

    const manager = new EventManager({
      credentials: [],
      destinationCalendar: null,
    });

    vi.spyOn(EventManager.prototype as any, "createVideoEvent").mockResolvedValue({
      type: "daily_video",
      createdEvent: { id: "fake-meeting-id", type: "daily_video" },
      originalEvent: { location: "integrations:daily" },
    });

    const calendarEvent = {
      type: "test",
      title: "Test Event",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
      location: "integrations:google:meet",
      destinationCalendar: [],
    } as any;

    await expect(manager.create(calendarEvent)).resolves.toBeDefined();
  });
});
