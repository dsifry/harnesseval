describe("handleCancelBooking apiDeletes array", () => {
  it("does not push undefined entries into the deletion Promise array passed to Promise.all", async () => {
    // Simulate the situation where getCalendar cannot resolve a calendar implementation.
    getCalendarMock.mockResolvedValue(undefined as any);

    const realAll = Promise.all.bind(Promise);
    const captured: unknown[] = [];
    vi.spyOn(Promise, "all").mockImplementation((values: any) => {
      captured.push(values);
      return realAll(values) as any;
    });

    const { default: handler } = await import("./handleCancelBooking");

    const req = {
      method: "POST",
      body: {
        id: 1,
        uid: "test-uid",
        allRemainingBookings: false,
        cancellationReason: "test cancellation",
      },
      query: {},
      headers: {},
      cookies: {},
    } as unknown as NextApiRequest;

    await handler(req);

    const flat = (captured as any[]).flat();
    expect(flat).not.toContain(undefined);
  });
});
