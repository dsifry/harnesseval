}));

describe("EventManager.updateAllCalendarEvents", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("surfaces an error thrown before calendarReference is assigned instead of silently returning []", async () => {
    const { default: EventManager } = await import("./EventManager");
    const prisma = (await import("@calcom/prisma")).default as any;

    // Force the booking lookup (inside the try block, and before
    // `calendarReference` is assigned) to fail.
    prisma.booking.findUnique.mockRejectedValue(new Error("prisma lookup failed"));

    const manager = new EventManager([], []);

    const event: any = {
      type: "event",
      title: "reschedule",
      startTime: "2024-01-01T00:00:00.000Z",
      endTime: "2024-01-01T01:00:00.000Z",
      attendees: [],
    };

    const booking: any = {
      id: 1,
      references: [],
    };

    let threw = false;
    let value: unknown;
    try {
      value = await (manager as any).updateAllCalendarEvents(event, booking, 999);
    } catch {
      threw = true;
    }

    const resolvedAsSilentSuccess = !threw && Array.isArray(value) && value.length === 0;

    expect(
      resolvedAsSilentSuccess,
      "updateAllCalendarEvents swallowed an error thrown before calendarReference was assigned and returned [] \u2014 callers get no failure signal (and no log output)."
    ).toBe(false);
  });
});
