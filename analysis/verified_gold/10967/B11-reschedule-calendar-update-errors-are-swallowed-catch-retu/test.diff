diff --git a/packages/core/EventManager.verified.test.ts b/packages/core/EventManager.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/EventManager.verified.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it, vi, beforeEach, afterEach } from "vitest";
+
+vi.mock("@calcom/prisma", () => ({
+  default: {
+    booking: {
+      findUnique: vi.fn(),
+    },
+    credential: {
+      findUnique: vi.fn(),
+    },
+  },
+}));
+
+vi.mock("@calcom/app-store/_utils/getCalendar", () => ({ getCalendar: vi.fn() }));
+vi.mock("@calcom/app-store/dailyvideo/lib/VideoApiAdapter", () => ({ FAKE_DAILY_CREDENTIAL: {} }));
+vi.mock("@calcom/app-store/dailyvideo/zod", () => ({ appKeysSchema: {} }));
+vi.mock("@calcom/app-store/locations", () => ({
+  getEventLocationTypeFromApp: vi.fn(),
+  MeetLocationType: "integrations:google:meet",
+}));
+vi.mock("@calcom/app-store/utils", () => ({ default: vi.fn() }));
+
+import prisma from "@calcom/prisma";
+import EventManager from "./EventManager";
+
+describe("EventManager - updateAllCalendarEvents error handling", () => {
+  let consoleErrorSpy: ReturnType<typeof vi.spyOn>;
+
+  beforeEach(() => {
+    consoleErrorSpy = vi.spyOn(console, "error").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    consoleErrorSpy.mockRestore();
+    vi.clearAllMocks();
+  });
+
+  it("should log an error when prisma lookup fails during reschedule, instead of silently returning []", async () => {
+    // Arrange: prisma throws before calendarReference is assigned
+    vi.mocked(prisma.booking.findUnique).mockRejectedValue(new Error("DB connection failed"));
+
+    const eventManager = new EventManager([]);
+    const event = {} as any;
+    const booking = { references: [] } as any;
+    const newBookingId = 123;
+
+    // Act
+    const result = await eventManager.updateAllCalendarEvents(event, booking, newBookingId);
+
+    // Assert: the error should be logged
+    expect(consoleErrorSpy).toHaveBeenCalled();
+    // Optionally assert the message contains the error
+    expect(consoleErrorSpy.mock.calls[0][0]).toContain("DB connection failed");
+  });
+});
