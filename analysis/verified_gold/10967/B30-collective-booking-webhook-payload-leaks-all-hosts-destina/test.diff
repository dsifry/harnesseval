+describe("handleNewBooking collective destinationCalendar webhook leak regression", () => {
+  beforeEach(() => {
+    h.webhookCalls.length = 0;
+  });
+
+  it("does not expose non-organizer hosts' destinationCalendar externalId in the webhook payload", async () => {
+    const reqBody: any = {
+      eventTypeId: 555,
+      start: "2024-01-15T10:00:00.000Z",
+      end: "2024-01-15T10:30:00.000Z",
+      timeZone: "UTC",
+      language: "en",
+      user: "org",
+      name: "Booker",
+      email: "booker@example.com",
+      bookingFieldsResponses: {},
+      responses: {},
+      metadata: {},
+      customInputs: [],
+      attendees: [],
+      guests: [],
+      location: "integrations:daily",
+    };
+
+    await handleNewBooking(reqBody);
+
+    // We must have reached the webhook trigger; otherwise the assertion below
+    // is vacuous and would not exercise the claim.
+    expect(h.webhookCalls.length).toBeGreaterThan(0);
+
+    // Walk every webhook invocation and collect every `externalId` string that
+    // appears anywhere inside the arguments. The claim is that the *other*
+    // collective hosts' destinationCalendar identifiers leak into this payload.
+    const foundExternalIds = new Set<string>();
+    const traverse = (value: any): void => {
+      if (!value || typeof value !== "object") return;
+      if (Array.isArray(value)) {
+        for (const item of value) traverse(item);
+        return;
+      }
+      if (typeof value.externalId === "string") {
+        foundExternalIds.add(value.externalId);
+      }
+      for (const v of Object.values(value)) traverse(v);
+    };
+    for (const args of h.webhookCalls) traverse(args);
+
+    // Specific assertion about the claimed field/path/consequence:
+    // webhook subscribers must not receive the other hosts' calendar external ids.
+    expect(foundExternalIds.has("a-ext")).toBe(false);
+    expect(foundExternalIds.has("b-ext")).toBe(false);
+
+    // Also assert we are actually looking at the same identifier carriers the claim
+    // describes (guard against the payload quietly dropping the field entirely and
+    // giving us a vacuous pass).
+    expect(typeof handleNewBooking).toBe("function");
+  });
