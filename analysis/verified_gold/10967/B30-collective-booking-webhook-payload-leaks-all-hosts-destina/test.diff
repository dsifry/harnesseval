+describe("handleNewBooking collective webhook destinationCalendar leak", () => {
+  beforeEach(() => {
+    capturedWebhookPayloads.length = 0;
+  });
+
+  it("does not include every collective host's destinationCalendar in the webhook payload", async () => {
+    const mod = await import("./handleNewBooking");
+    const handler = (mod.default ?? mod) as any;
+
+    const req = {
+      body: {
+        start: "2024-01-01T10:00:00.000Z",
+        end: "2024-01-01T11:00:00.000Z",
+        eventTypeId: 100,
+        timeZone: "UTC",
+        language: "en",
+        metadata: {},
+        user: "organizer",
+        responses: {},
+        attendees: [],
+        location: "inPerson",
+        bookingFieldsResponses: {},
+        calEventResponses: {},
+      },
+      headers: {},
+      cookies: {},
+      query: {},
+      method: "POST",
+      userId: 1,
+    } as any;
+
+    try {
+      await handler(req);
+    } catch (_e) {
+      // The handler may throw for unrelated reasons; the assertion below
+      // targets the evt assembled before webhook dispatch.
+    }
+
+    const leakedExternalIds = capturedWebhookPayloads.flatMap((payload) =>
+      (payload?.destinationCalendar ?? []).map((dc: any) => dc?.externalId)
+    );
+
+    expect(leakedExternalIds).not.toContain("other-host-ext");
+  });
+});
