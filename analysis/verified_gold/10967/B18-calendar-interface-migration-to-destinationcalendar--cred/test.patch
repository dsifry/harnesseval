import { expect, expectTypeOf, test } from "vitest";

import type {
  Calendar,
  CalendarEvent,
  EventBusyDate,
  IntegrationCalendar,
  NewCalendarEventType,
} from "./Calendar";

/**
 * Claim under test:
 *   "Calendar interface migration to destinationCalendar[] + credentialId is not
 *    enforced; unmigrated implementers still type-check."
 *
 * packages/types/Calendar.d.ts (post-PR) declares:
 *
 *   export interface Calendar {
 *     createEvent(event: CalendarEvent, credentialId: number): Promise<NewCalendarEventType>;
 *     ...
 *   }
 *
 * If the migration were actually enforced, a legacy implementation whose
 * `createEvent` only accepts the old single `event` argument would have to be a
 * compile error, and the `@ts-expect-error` directive below would be USED.
 *
 * Because TypeScript happily lets a class implement an interface method with
 * FEWER parameters than the interface declares, the unmigrated implementer
 * still satisfies `implements Calendar` on the current code. The directive is
 * therefore UNUSED and type-checking fails with:
 *
 *   error TS2578: Unused '@ts-expect-error' directive.
 *
 * That is precisely the claimed defect: the migration to the provider-neutral
 * `credentialId` selector is not enforced against existing/unmigrated
 * implementations (and mocks) of `Calendar`.
 */

// A pre-migration implementer: it never learned about the new `credentialId` arg.
class UnmigratedCalendarService implements Calendar {
  createEvent(event: CalendarEvent): Promise<NewCalendarEventType> {
    return Promise.resolve({
      uid: "",
      id: "",
      type: "",
      password: "",
      url: "",
      additionalInfo: {},
    });
  }

  updateEvent(
    uid: string,
    event: CalendarEvent,
    externalCalendarId?: string | null
  ): Promise<NewCalendarEventType | NewCalendarEventType[]> {
    return Promise.resolve({} as NewCalendarEventType);
  }

  deleteEvent(uid: string, event: CalendarEvent, externalCalendarId?: string | null): Promise<unknown> {
    return Promise.resolve(undefined);
  }

  getAvailability(
    dateFrom: string,
    dateTo: string,
    selectedCalendars: IntegrationCalendar[]
  ): Promise<EventBusyDate[]> {
    return Promise.resolve([]);
  }

  listCalendars(event?: CalendarEvent): Promise<IntegrationCalendar[]> {
    return Promise.resolve([]);
  }
}

test("Calendar.createEvent must require credentialId so unmigrated implementers are rejected", () => {
  // The interface contract must expose two parameters: (event, credentialId).
  expectTypeOf<Calendar["createEvent"]>().parameters.toEqualTypeOf<[CalendarEvent, number]>();

  // Any legacy, unmigrated implementation must NOT be assignable to the migrated
  // Calendar interface. If it is (current code), the @ts-expect-error above is
  // unused and this suite fails.
  // @ts-expect-error - legacy one-argument createEvent must not satisfy Calendar
  const legacy: Calendar = new UnmigratedCalendarService();

  expect(legacy).toBeInstanceOf(UnmigratedCalendarService);
  expect(legacy.createEvent.length).toBe(1);
});
