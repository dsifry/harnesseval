+describe("handleNewBooking dynamic group booking", () => {
+  beforeEach(() => {
+    findManyMock.mockReset();
+  });
+
+  it("selects organization.slug for the dynamic user list query", async () => {
+    findManyMock.mockResolvedValue([
+      { id: 1, username: "alice", email: "alice@example.com", allowDynamicBooking: true, timeZone: "UTC", locale: "en", organization: { slug: "acme" } },
+      { id: 2, username: "bob", email: "bob@example.com", allowDynamicBooking: true, timeZone: "UTC", locale: "en", organization: { slug: "acme" } },
+    ]);
+
+    const mod: any = await import("./handleNewBooking");
+    const handleNewBooking = mod.default ?? mod.handler ?? mod.handleNewBooking;
+
+    const req: any = {
+      method: "POST",
+      headers: {},
+      cookies: {},
+      body: {
+        user: ["alice", "bob"],
+        name: "Alice",
+        email: "alice@example.com",
+        start: new Date(Date.now() + 86400000).toISOString(),
+        timeZone: "UTC",
+        language: "en",
+        metadata: {},
+        responses: {},
+        customInputs: {},
+        guests: [],
+        notes: "",
+      },
+    };
+
+    const eventType: any = {
+      id: 999,
+      slug: "dynamic",
+      schedulingType: null,
+      hosts: [],
+      users: [],
+      periodType: "UNLIMITED",
+      periodDays: null,
+      periodEndDate: null,
+      periodStartDate: null,
+      periodCountCalendarDays: false,
+      locations: [],
+      metadata: {},
+      customInputs: [],
+      bookingFields: [],
+      seatsPerTimeSlot: null,
+      destinationCalendar: null,
+      userId: null,
+      teamId: null,
+      price: 0,
+      currency: "usd",
+      length: 30,
+    };
+
+    try {
+      await handleNewBooking(req, {
+        userId: undefined,
+        eventTypeId: undefined,
+        eventType,
+        bookerName: "Alice",
+      } as any);
+    } catch {
+      // Downstream throws are irrelevant; the dynamic loadUsers query runs before them.
+    }
+
+    expect(findManyMock).toHaveBeenCalled();
+    const args = findManyMock.mock.calls[0][0] as { select: Record<string, unknown> };
+    expect(args.select).toHaveProperty("organization");
+    expect(args.select.organization).toEqual({ select: { slug: true } });
+  });
+});
