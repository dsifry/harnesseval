+    credential: { findFirst: vi.fn(), findMany: vi.fn() },
+    destinationCalendar: { findMany: vi.fn(), create: vi.fn(), update: vi.fn(), deleteMany: vi.fn(), findUnique: vi.fn() },
+    membership: { findFirst: vi.fn(), findMany: vi.fn() },
+    team: { findUnique: vi.fn(), findFirst: vi.fn() },
+    $transaction: vi.fn(async (fn: any) => (typeof fn === "function" ? fn(client) : Promise.all(fn))),
+    $queryRaw: vi.fn(),
+    $executeRaw: vi.fn(),
+  };
+  return { default: client, prisma: client };
+});
+
