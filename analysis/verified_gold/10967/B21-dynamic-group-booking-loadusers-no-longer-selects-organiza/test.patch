describe("handleNewBooking dynamic group booking loadUsers", () => {
  it("selects organization.slug for dynamic users so org-aware booker URLs are built for organization users", async () => {
    const mod = await import("./handleNewBooking");
    const handler = (mod.default ?? mod) as (...args: any[]) => Promise<unknown>;

    const req = {
      body: {
        user: "user1,user2",
        start: new Date(Date.now() + 86400000).toISOString(),
        end: new Date(Date.now() + 90000000).toISOString(),
        timeZone: "UTC",
        language: "en",
        eventTypeSlug: "dynamic",
        responses: {},
        guests: [],
      },
      method: "POST",
      headers: {},
      cookies: {},
      query: {},
    } as any;

    const res = {
      status: vi.fn().mockReturnThis(),
      json: vi.fn().mockReturnThis(),
    } as any;

    try {
      await handler(req, res);
    } catch {
      // The handler may throw further down; we only care that the dynamic
      // loadUsers query was issued.
    }

    const dynamicCall = userFindManyCalls.find((call) =>
      Array.isArray(call?.where?.username?.in)
    );

    expect(
      dynamicCall?.select,
      "dynamic group booking loadUsers must select organization.slug so downstream org-aware booker URL builders can read user.organization.slug"
    ).toMatchObject({
      organization: {
        select: {
          slug: true,
        },
      },
    });
  });
});
