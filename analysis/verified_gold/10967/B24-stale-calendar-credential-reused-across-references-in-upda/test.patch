import { beforeEach, describe, expect, it, vi } from "vitest";

import prisma from "@calcom/prisma";

import { updateEvent } from "./CalendarManager";

vi.mock("@calcom/prisma", () => ({
  default: {
    booking: { findUnique: vi.fn() },
    credential: { findUnique: vi.fn() },
  },
}));

vi.mock("./CalendarManager", () => ({
  createEvent: vi.fn(async () => null),
  updateEvent: vi.fn(async () => ({ type: "google_calendar", uid: "res" })),
}));

describe("EventManager.updateAllCalendarEvents – stale credential claim", () => {
  beforeEach(() => {
    vi.mocked(updateEvent).mockClear();
    vi.mocked(prisma.credential.findUnique).mockReset();
  });

  it("CLAIM: second reference reuses the previous reference's credential when its own credential cannot be resolved", async () => {
    const { default: EventManager } = await import("./EventManager");

    const credentialA: any = {
      id: "cred-a",
      type: "google_calendar",
      appName: "google-calendar",
      key: {},
      userId: 1,
      teamId: null,
      invalid: false,
      appId: "google-calendar",
    };

    const em = new (EventManager as any)([credentialA], []);

    // cred-b cannot be resolved from calendarCredentials nor from the DB
    vi.mocked(prisma.credential.findUnique).mockResolvedValue(null as any);

    const booking: any = {
      id: 1,
      references: [
        {
          uid: "ref-1",
          type: "google_calendar",
          credentialId: "cred-a",
          externalCalendarId: "ext-a",
        },
        {
          uid: "ref-2",
          type: "google_calendar",
          credentialId: "cred-b",
          externalCalendarId: "ext-b",
        },
      ],
    };

    const event: any = {
      title: "test",
      startTime: new Date(),
      endTime: new Date(),
      attendees: [],
      organizer: { email: "organizer@example.com", name: "Organizer" },
    };

    await (em as any).updateAllCalendarEvents(event, booking);

    expect(vi.mocked(updateEvent)).toHaveBeenCalledTimes(2);
    // The claim asserts the stale credentialA bleeds into the second iteration.
    expect(vi.mocked(updateEvent).mock.calls[1][0]).toBe(credentialA);
  });
});
