+++ b/packages/features/bookings/lib/handleNewBooking.verified.test.ts
@@ -0,0 +1,18 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+describe("collective destination calendars", () => {
+  it("should not silently drop team members' destination calendars when the organizer has none", () => {
+    const source = readFileSync(join(__dirname, "handleNewBooking.ts"), "utf-8");
+
+    // The buggy code uses optional chaining on evt.destinationCalendar, which is null
+    // when neither the event type nor the organizer has a destination calendar.
+    // This causes the push of teamDestinationCalendars to be skipped.
+    const usesOptionalPush = source.includes(
+      "evt.destinationCalendar?.push(...teamDestinationCalendars)"
+    );
+
+    expect(usesOptionalPush).toBe(false);
+  });
+});
