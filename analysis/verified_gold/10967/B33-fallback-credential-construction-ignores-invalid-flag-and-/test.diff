diff --git a/packages/core/EventManager.verified.test.ts b/packages/core/EventManager.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/EventManager.verified.test.ts
@@ -0,0 +1,69 @@
+import { describe, expect, it, vi, beforeEach } from "vitest";
+
+vi.mock("@calcom/prisma", () => {
+  const findUnique = vi.fn();
+  return {
+    default: {
+      credential: {
+        findUnique,
+      },
+    },
+    __esModule: true,
+  };
+});
+
+vi.mock("./CalendarManager", () => {
+  const createEvent = vi.fn();
+  const updateEvent = vi.fn();
+  return {
+    createEvent,
+    updateEvent,
+    __esModule: true,
+  };
+});
+
+import prisma from "@calcom/prisma";
+import { createEvent } from "./CalendarManager";
+import EventManager from "./EventManager";
+
+describe("EventManager fallback credential invalid flag", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it("should not use an invalid credential fetched from DB in createAllCalendarEvents fallback", async () => {
+    const invalidCredential = {
+      id: 123,
+      type: "google_calendar",
+      key: { access_token: "revoked" },
+      userId: 1,
+      teamId: null,
+      appId: "google-calendar",
+      invalid: true,
+      app: { slug: "google-calendar" },
+    };
+
+    (prisma.credential.findUnique as any).mockResolvedValue(invalidCredential);
+
+    (createEvent as any).mockResolvedValue({ type: "google_calendar", success: true });
+
+    const eventManager = new EventManager([]);
+
+    const event = {
+      title: "Test Event",
+      startTime: new Date().toISOString(),
+      endTime: new Date().toISOString(),
+      destinationCalendar: [
+        {
+          credentialId: 123,
+          integration: "google_calendar",
+          externalId: "external-123",
+        },
+      ],
+    };
+
+    await (eventManager as any).createAllCalendarEvents(event as any);
+
+    expect(createEvent).not.toHaveBeenCalled();
+  });
+});
