+import { describe, expect, it, vi } from "vitest";
+
+vi.mock("./CalendarManager", () => ({
+  createEvent: vi.fn(),
+  updateEvent: vi.fn(),
+}));
+
+vi.mock("./videoClient", () => ({
+  createMeeting: vi.fn(),
+  updateMeeting: vi.fn(),
+}));
+
+vi.mock("@calcom/prisma", () => ({
+  default: {
+    credential: {
+      findUnique: vi.fn(),
+    },
+  },
+}));
+
+vi.mock("@calcom/app-store/_utils/getCalendar", () => ({
+  getCalendar: vi.fn(),
+}));
+
+vi.mock("@calcom/app-store/dailyvideo/lib/VideoApiAdapter", () => ({
+  FAKE_DAILY_CREDENTIAL: {},
+}));
+
+vi.mock("@calcom/app-store/dailyvideo/zod", () => ({
+  appKeysSchema: {},
+}));
+
+vi.mock("@calcom/app-store/locations", () => ({
+  getEventLocationTypeFromApp: vi.fn(),
+  MeetLocationType: "integrations:google:meet",
+}));
+
+vi.mock("@calcom/app-store/utils", () => ({
+  default: vi.fn(),
+}));
+
+vi.mock("@calcom/prisma/zod-utils", () => ({
+  createdEventSchema: {},
+}));
+
+describe("EventManager verified regression", () => {
+  it("does not fan out duplicate external events for multiple destinations without credentialId", async () => {
+    process.env.NEXT_PUBLIC_WEBAPP_URL = "http://localhost:3000";
+    process.env.NEXTAUTH_URL = "http://localhost:3000";
+
+    const { createEvent } = await import("./CalendarManager");
+    const { default: EventManager } = await import("./EventManager");
+
+    const googleCredential = {
+      id: 1,
+      appId: "google-calendar",
+      type: "google_calendar",
+      userId: 1,
+      key: { access_token: "fake" },
+      invalid: false,
+    };
+
+    const manager = Object.create(EventManager.prototype);
+    manager.calendarCredentials = [googleCredential];
+
+    const event = {
+      destinationCalendar: [
+        { id: 1, integration: "google_calendar", externalId: null, credentialId: null, userId: 1 },
+        { id: 2, integration: "google_calendar", externalId: null, credentialId: null, userId: 1 },
+      ],
+    };
+
+    (createEvent as any).mockResolvedValue({
+      type: "google_calendar",
+      credentialId: 1,
+      externalId: "external-1",
+    });
+
+    await (manager as any).createAllCalendarEvents(event);
+
+    expect(createEvent).toHaveBeenCalledTimes(1);
+  });
+});
