import { describe, expect, it, vi, beforeEach } from "vitest";

vi.mock("@calcom/prisma", () => ({
  default: {
    booking: { findUnique: vi.fn() },
    credential: { findUnique: vi.fn() },
  },
}));

vi.mock("./CalendarManager", () => ({
  updateEvent: vi.fn(),
  createEvent: vi.fn(),
}));

vi.mock("./videoClient", () => ({
  createMeeting: vi.fn(),
  updateMeeting: vi.fn(),
}));

vi.mock("@calcom/app-store/_utils/getCalendar", () => ({
  getCalendar: vi.fn(),
}));

import { EventManager } from "./EventManager";
import { updateEvent } from "./CalendarManager";

describe("EventManager updateAllCalendarEvents", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("should throw or rollback when a host calendar update fails", async () => {
    const credentials = [
      { id: "cred1", type: "google_calendar", appName: "google-calendar", key: {}, userId: 1, teamId: null, invalid: false, appId: "1" },
      { id: "cred2", type: "office365_calendar", appName: "office365-calendar", key: {}, userId: 2, teamId: null, invalid: false, appId: "2" },
    ];
    const manager = new EventManager(credentials as any);

    const event = {} as any;
    const booking = {
      id: 1,
      references: [
        { type: "google_calendar", uid: "uid1", externalCalendarId: "ext1", credentialId: "cred1" },
        { type: "office365_calendar", uid: "uid2", externalCalendarId: "ext2", credentialId: "cred2" },
      ],
    } as any;

    (updateEvent as any).mockImplementation(async (cred: any) => {
      if (cred.id === "cred1") {
        return { success: true, type: "google_calendar", appName: "google-calendar", uid: "uid1", originalEvent: event, credentialId: "cred1" };
      } else {
        return { success: false, type: "office365_calendar", appName: "office365-calendar", uid: "", originalEvent: event, credentialId: "cred2", error: "Failed to update" };
      }
    });

    await expect((manager as any).updateAllCalendarEvents(event, booking)).rejects.toThrow();
  });
});
