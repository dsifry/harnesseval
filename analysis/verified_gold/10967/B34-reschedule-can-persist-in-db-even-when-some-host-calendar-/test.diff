--- /dev/null
+++ b/packages/core/EventManager.verified.test.ts
@@ -0,0 +1,135 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("@calcom/prisma", () => {
+  const prisma = {
+    credential: { findUnique: vi.fn().mockResolvedValue(null) },
+    booking: { findUnique: vi.fn().mockResolvedValue(null), update: vi.fn() },
+  };
+  return { default: prisma, prisma };
+});
+
+vi.mock("@calcom/app-store/_utils/getCalendar", () => ({
+  getCalendar: vi.fn(async () => ({ deleteEvent: vi.fn(async () => undefined) })),
+}));
+
+vi.mock("@calcom/app-store/utils", () => ({ default: vi.fn(async () => []) }));
+
+vi.mock("@calcom/app-store/locations", () => ({
+  MeetLocationType: "integrations:google:meet",
+  getEventLocationTypeFromApp: vi.fn(() => undefined),
+}));
+
+vi.mock("@calcom/app-store/dailyvideo/lib/VideoApiAdapter", () => ({
+  FAKE_DAILY_CREDENTIAL: { appId: "daily-video", type: "daily_video", key: {} },
+}));
+
+vi.mock("@calcom/app-store/dailyvideo/zod", () => ({ appKeysSchema: {} }));
+
+vi.mock("@calcom/prisma/zod-utils", () => ({
+  createdEventSchema: { parse: (value: unknown) => value },
+}));
+
+vi.mock("./videoClient", () => ({
+  createMeeting: vi.fn(async () => null),
+  updateMeeting: vi.fn(async () => null),
+}));
+
+vi.mock("./CalendarManager", () => ({
+  createEvent: vi.fn(async () => null),
+  updateEvent: vi.fn(),
+}));
+
+describe("EventManager – reschedule with partial host calendar failure", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it("throws so the DB reschedule can be rolled back when a host calendar update fails", async () => {
+    const { updateEvent } = await import("./CalendarManager");
+    const mockedUpdateEvent = vi.mocked(updateEvent);
+
+    mockedUpdateEvent.mockImplementation(async (credential: any) => {
+      if (credential?.id === 2) {
+        return {
+          appName: "office365",
+          type: "office365_calendar",
+          success: false,
+          uid: "uid-2",
+          originalEvent: {} as any,
+          credentialId: 2,
+        } as any;
+      }
+      return {
+        appName: "google",
+        type: "google_calendar",
+        success: true,
+        uid: "uid-1",
+        originalEvent: {} as any,
+        credentialId: 1,
+        externalId: "ext-1",
+      } as any;
+    });
+
+    const { default: EventManager } = await import("./EventManager");
+
+    const calendarCredentials = [
+      {
+        id: 1,
+        appName: "google",
+        type: "google_calendar",
+        key: {},
+        userId: 1,
+        teamId: null,
+        invalid: false,
+        appId: "google-calendar",
+      },
+      {
+        id: 2,
+        appName: "office365",
+        type: "office365_calendar",
+        key: {},
+        userId: 1,
+        teamId: null,
+        invalid: false,
+        appId: "office365-calendar",
+      },
+    ];
+
+    const manager = new EventManager(calendarCredentials as any, [] as any);
+
+    const event = {
+      title: "Rescheduled event",
+      startTime: "2024-01-01T10:00:00Z",
+      endTime: "2024-01-01T11:00:00Z",
+      destinationCalendar: [],
+    } as any;
+
+    const booking = {
+      id: 99,
+      references: [
+        { id: 1, type: "google_calendar", uid: "uid-1", credentialId: 1, externalCalendarId: "ext-1" },
+        { id: 2, type: "office365_calendar", uid: "uid-2", credentialId: 2, externalCalendarId: "ext-2" },
+      ],
+    } as any;
+
+    const updateAllCalendarEvents = (manager as any).updateAllCalendarEvents as (
+      event: any,
+      booking: any,
+      newBookingId?: number
+    ) => Promise<unknown>;
+
+    expect(typeof updateAllCalendarEvents).toBe("function");
+
+    let thrown: unknown;
+    try {
+      await updateAllCalendarEvents.call(manager, event, booking);
+    } catch (error) {
+      thrown = error;
+    }
+
+    expect(
+      thrown,
+      "Expected a reschedule to abort with an error when one host calendar update fails, instead of silently persisting the new time in the DB while that host remains on the old time"
+    ).toBeInstanceOf(Error);
+  });
+});
