import { describe, expect, it, vi, beforeEach } from "vitest";

const { createEventMock } = vi.hoisted(() => ({ createEventMock: vi.fn() }));

vi.mock("./CalendarManager", () => ({
  createEvent: createEventMock,
  updateEvent: vi.fn(),
  getCalendarCredentials: vi.fn(() => []),
}));

vi.mock("./videoClient", () => ({
  createMeeting: vi.fn(),
  updateMeeting: vi.fn(),
}));

vi.mock("@calcom/prisma", () => ({
  default: {
    credential: { findUnique: vi.fn().mockResolvedValue(null) },
    payment: { updateMany: vi.fn() },
  },
}));

describe("EventManager.createAllCalendarEvents — duplicate destinations", () => {
  beforeEach(() => {
    createEventMock.mockReset();
    createEventMock.mockResolvedValue({
      type: "google_calendar",
      success: true,
      uid: "u1",
      credentialId: 1,
      externalId: "ext-1",
    });
  });

  it("creates only one calendar event when two destinations share credentialId+externalId", async () => {
    const { default: EventManager } = await import("./EventManager");

    const credential = {
      id: 1,
      appId: "google",
      type: "google_calendar",
      key: {},
      userId: 1,
      teamId: null,
      invalid: false,
      appName: "google-calendar",
    };

    const em = new EventManager([credential] as any, [] as any);

    const destination = {
      credentialId: 1,
      externalId: "ext-1",
      integration: "google_calendar",
    };

    const event = {
      type: "test",
      title: "T",
      startTime: "2024-01-01T10:00:00Z",
      endTime: "2024-01-01T11:00:00Z",
      organizer: {
        email: "a@b.com",
        name: "a",
        timeZone: "UTC",
        language: { locale: "en" },
      },
      attendees: [],
      // Two identical destinations — e.g. event-type destination and a collective
      // host's personal destination resolving to the same credential+externalId.
      destinationCalendar: [destination, destination],
    } as any;

    await (em as any).createAllCalendarEvents(event);

    expect(createEventMock).toHaveBeenCalledTimes(1);
  });
});
