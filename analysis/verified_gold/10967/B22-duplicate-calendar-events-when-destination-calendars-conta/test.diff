diff --git a/packages/core/EventManager.verified.test.ts b/packages/core/EventManager.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/EventManager.verified.test.ts
@@ -0,0 +1,73 @@
+import { describe, expect, it, vi } from "vitest";
+
+const { createEventMock, updateEventMock } = vi.hoisted(() => ({
+  createEventMock: vi.fn(),
+  updateEventMock: vi.fn(),
+}));
+
+vi.mock("./CalendarManager", () => ({
+  createEvent: createEventMock,
+  updateEvent: updateEventMock,
+}));
+
+vi.mock("./videoClient", () => ({
+  createMeeting: vi.fn(),
+  updateMeeting: vi.fn(),
+}));
+
+vi.mock("@calcom/prisma", () => ({
+  default: {
+    credential: { findUnique: vi.fn() },
+    payment: { updateMany: vi.fn() },
+  },
+}));
+
+import EventManager from "./EventManager";
+
+describe("EventManager.createAllCalendarEvents deduplication", () => {
+  it("should create only one event when two destination calendars share the same credentialId and externalId", async () => {
+    createEventMock.mockReset();
+    createEventMock.mockResolvedValue({
+      type: "google_calendar",
+      uid: "uid-1",
+      id: "evt-id",
+      password: "",
+      url: "",
+      externalId: "primary",
+      credentialId: 1,
+    });
+
+    const credential = {
+      id: 1,
+      appId: "google-calendar",
+      type: "google_calendar",
+      userId: 1,
+      key: { access_token: "x" },
+      invalid: false,
+      appName: "google_calendar",
+    };
+
+    const manager = new EventManager([credential as any]);
+
+    const destination = {
+      credentialId: 1,
+      externalId: "primary",
+      integration: "google_calendar",
+    };
+
+    const event = {
+      destinationCalendar: [destination, destination],
+    };
+
+    await (manager as any).createAllCalendarEvents(event);
+
+    const callsForSameDestination = createEventMock.mock.calls.filter(
+      (call) => call[0]?.id === 1 && call[2] === "primary"
+    );
+
+    expect(
+      callsForSameDestination,
+      "duplicate destinations should be deduplicated so createEvent runs once per (credentialId, externalId)"
+    ).toHaveLength(1);
+  });
+});
