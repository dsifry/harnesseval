import { describe, expect, it, vi } from "vitest";

vi.mock("./CalendarManager", () => ({
  createEvent: vi.fn(async (credential: any, event: any, externalId?: string) => ({
    type: credential.type,
    externalId,
    credentialId: credential.id,
    createdEvent: { id: "123", password: "pass", url: "http://example.com" },
  })),
  updateEvent: vi.fn(),
}));

describe("EventManager externalCalendarId", () => {
  it("should use destination.externalId as externalCalendarId when destination has no credentialId", async () => {
    const { default: EventManager } = await import("./EventManager");

    const calendarCredentials = [
      {
        id: 1,
        type: "google_calendar",
        appName: "google_calendar",
        key: {},
        userId: 1,
        teamId: null,
        invalid: false,
        appId: "google-calendar",
      },
    ];

    const eventManager = new EventManager(calendarCredentials as any, []);

    const event = {
      destinationCalendar: [
        {
          credentialId: null,
          externalId: "destination-external-id",
          integration: "google_calendar",
        },
      ],
      title: "Test Event",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
      organizer: { email: "organizer@example.com", name: "Organizer" },
      attendees: [],
      location: undefined,
    };

    const result = await eventManager.createEvent(event as any);

    const reference = result.referencesToCreate.find(
      (ref: any) => ref.type.includes("google_calendar")
    );

    expect(reference).toBeDefined();
    expect(reference.externalCalendarId).toBe("destination-external-id");
  });
});
