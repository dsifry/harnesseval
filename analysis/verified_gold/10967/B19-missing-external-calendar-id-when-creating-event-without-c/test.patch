import { describe, expect, it, vi, beforeEach } from "vitest";

vi.mock("@calcom/prisma", () => ({
  default: {
    credential: {
      findUnique: vi.fn(),
    },
  },
}));

vi.mock("./CalendarManager", () => ({
  createEvent: vi.fn(),
  updateEvent: vi.fn(),
}));

describe("EventManager externalCalendarId regression", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("should preserve destination externalId in booking reference when destination has no credentialId", async () => {
    process.env.CALENDSO_ENCRYPTION_KEY = "dummy";
    process.env.NEXT_PUBLIC_WEBAPP_URL = "http://localhost:3000";

    const externalId = "dest-external-id-123";

    const credential = {
      id: 1,
      type: "google_calendar",
      appName: "google",
      key: {},
      userId: 1,
      teamId: null,
      invalid: false,
      appId: "google-calendar",
    };

    const event = {
      type: "test-event",
      title: "Test Event",
      startTime: "2024-01-01T10:00:00Z",
      endTime: "2024-01-01T11:00:00Z",
      destinationCalendar: [
        {
          integration: "google_calendar",
          externalId,
          credentialId: null,
        },
      ],
    } as any;

    const { createEvent } = await import("./CalendarManager");
    (createEvent as any).mockImplementation(async (cred: any, evt: any, extId?: string) => ({
      type: "google_calendar",
      uid: "uid-123",
      createdEvent: { id: "event-123", iCalUID: "ical-123" },
      externalId: extId,
      credentialId: cred.id,
    }));

    const { default: EventManager } = await import("./EventManager");

    const eventManager = new EventManager([credential]);
    const result = await eventManager.create(event);

    const calendarReference = result.referencesToCreate.find((ref: any) =>
      ref.type.includes("_calendar")
    );

    expect(calendarReference).toBeDefined();
    expect(calendarReference.externalCalendarId).toBe(externalId);
  });
});