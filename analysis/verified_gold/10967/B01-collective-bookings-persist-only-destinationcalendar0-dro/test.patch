describe("handleNewBooking > collective destination calendars", () => {
  beforeEach(() => {
    vi.clearAllMocks();
    bookingCreateMock.mockImplementation(async (args: { data: Record<string, unknown> }) => ({
      id: 500,
      uid: args?.data?.uid,
    }));
    credentialFindFirstOrThrowMock.mockResolvedValue({ id: 1, key: {}, appId: "office365_calendar" });
    userFindManyMock.mockResolvedValue([baseEventType.hosts[0].user, baseEventType.hosts[1].user]);
    eventTypeFindUniqueMock.mockResolvedValue(baseEventType);
  });

  it("persists every collective host's destination calendar, not only destinationCalendar[0]", async () => {
    const module = await import("./handleNewBooking");
    const handler = (module as { default?: unknown; handler?: unknown }).default ?? (module as { handler?: unknown }).handler;
    expect(typeof handler).toBe("function");

    const reqBody = {
      eventTypeId: baseEventType.id,
      start: "2030-01-01T10:00:00.000Z",
      end: "2030-01-01T10:30:00.000Z",
      timeZone: "UTC",
      language: "en",
      user: "host-one",
      email: "booker@example.com",
      name: "Booker",
      phone: "+10000000000",
      location: "integrations:daily",
      smsReminderNumber: null,
      customInputs: [],
      metadata: {},
      hashedLink: null,
      bookingUid: null,
      noEmail: true,
      guests: [],
    } as unknown as NextApiRequest["body"];

    const req = {
      cookies: {},
      headers: {},
      body: reqBody,
      method: "POST",
      query: {},
      socket: { remoteAddress: "127.0.0.1" },
    } as unknown as NextApiRequest;

    await (handler as (a: unknown, b: unknown, c: unknown) => Promise<unknown>)(reqBody, req, 1);

    expect(bookingCreateMock).toHaveBeenCalled();
    const createArgs = bookingCreateMock.mock.calls[0][0] as {
      data: { destinationCalendar?: { connect?: unknown } | unknown };
    };
    const connect = createArgs.data.destinationCalendar;
    const connectedIds: number[] = Array.isArray((connect as { connect?: unknown })?.connect)
      ? ((connect as { connect: { id: number }[] }).connect).map((c) => c.id)
      : [(connect as { connect?: { id: number } })?.connect?.id as number].filter((id) => typeof id === "number");

    // Claim under test: all collective hosts' destination calendars (including the co-host's)
    // must be persisted, not merely destinationCalendar[0].
    expect(connectedIds).toEqual(
      expect.arrayContaining([primaryDestinationCalendar.id, coHostDestinationCalendar.id])
    );
  });
});
