+const googleMeetLinksByRequestId = new Map<string, string>();
+
+function getOrSetGoogleMeetLink(event: CalendarEvent, hangoutLink: string | undefined) {
+  const requestId = event.conferenceData?.createRequest?.requestId;
+  if (!requestId || !hangoutLink) {
+    return hangoutLink || "";
+  }
+  const existingLink = googleMeetLinksByRequestId.get(requestId);
+  if (existingLink) {
+    return existingLink;
+  }
+  googleMeetLinksByRequestId.set(requestId, hangoutLink);
+  return hangoutLink;
+}
+
