import { beforeEach, describe, expect, it, vi } from "vitest";

const { mockFindUnique, mockCreateEvent } = vi.hoisted(() => ({
  mockFindUnique: vi.fn(),
  mockCreateEvent: vi.fn(),
}));

vi.mock("@calcom/prisma", () => ({
  default: {
    credential: {
      findUnique: mockFindUnique,
    },
  },
}));

vi.mock("./CalendarManager", () => ({
  createEvent: mockCreateEvent,
  updateEvent: vi.fn(),
}));

vi.mock("@calcom/app-store/_utils/getCalendar", () => ({ getCalendar: vi.fn() }));
vi.mock("@calcom/app-store/dailyvideo/lib/VideoApiAdapter", () => ({ FAKE_DAILY_CREDENTIAL: {} }));
vi.mock("@calcom/app-store/dailyvideo/zod", () => ({ appKeysSchema: {} }));
vi.mock("@calcom/app-store/locations", () => ({
  getEventLocationTypeFromApp: vi.fn(),
  MeetLocationType: "integrations:google:meet",
}));
vi.mock("@calcom/app-store/utils", () => ({ default: vi.fn(() => []) }));
vi.mock("@calcom/prisma/zod-utils", () => ({ createdEventSchema: {} }));
vi.mock("./videoClient", () => ({ createMeeting: vi.fn(), updateMeeting: vi.fn() }));

describe("EventManager createAllCalendarEvents", () => {
  beforeEach(() => {
    vi.clearAllMocks();
  });

  it("creates events in parallel for multiple destination calendars (no sequential N+1)", async () => {
    const { default: EventManager } = await import("./EventManager");
    const manager = new EventManager([], []);

    const destinations = [1, 2, 3].map((n) => ({
      credentialId: n,
      integration: "google_calendar",
      externalId: `ext-${n}`,
    }));

    mockFindUnique.mockImplementation(async ({ where }: any) => ({
      id: where.id,
      app: { slug: "google-calendar" },
      type: "google_calendar",
      key: {},
      userId: 1,
      teamId: null,
      invalid: false,
      appId: "google-calendar",
    }));

    let active = 0;
    let maxActive = 0;
    mockCreateEvent.mockImplementation(async () => {
      active++;
      maxActive = Math.max(maxActive, active);
      await new Promise((resolve) => setTimeout(resolve, 20));
      active--;
      return { type: "google_calendar", uid: "uid", externalId: "ext" };
    });

    const event = {
      destinationCalendar: destinations,
      title: "Test Booking",
      startTime: new Date().toISOString(),
      endTime: new Date().toISOString(),
    };

    await (manager as any).createAllCalendarEvents(event);

    expect(
      maxActive,
      "createAllCalendarEvents should issue createEvent calls in parallel for multiple destinations"
    ).toBeGreaterThan(1);
  });
});
