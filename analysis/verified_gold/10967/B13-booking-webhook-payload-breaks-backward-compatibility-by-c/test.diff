diff --git a/packages/types/Calendar.d.verified.test.ts b/packages/types/Calendar.d.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/types/Calendar.d.verified.test.ts
@@ -0,0 +1,22 @@
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it, expectTypeOf } from "vitest";
+
+import type { CalendarEvent } from "./Calendar";
+
+const calendarDtsPath = fileURLToPath(new URL("./Calendar.d.ts", import.meta.url));
+
+describe("CalendarEvent.destinationCalendar shape (webhook backward compatibility)", () => {
+  it("declares destinationCalendar as a single DestinationCalendar object or null, not an array", () => {
+    const source = readFileSync(calendarDtsPath, "utf8");
+    const match = source.match(/destinationCalendar\?:\s*([^;]+);/);
+    expect(match, "destinationCalendar must be declared in Calendar.d.ts").not.toBeNull();
+    expect(match![1].trim()).toBe("DestinationCalendar | null");
+  });
+
+  it("type-level: CalendarEvent['destinationCalendar'] is DestinationCalendar | null | undefined", () => {
+    expectTypeOf<CalendarEvent["destinationCalendar"]>().toEqualTypeOf<
+      import("@prisma/client").DestinationCalendar | null | undefined
+    >();
+  });
+});
