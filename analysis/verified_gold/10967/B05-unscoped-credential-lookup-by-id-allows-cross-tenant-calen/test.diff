diff --git a/packages/core/EventManager.verified.test.ts b/packages/core/EventManager.verified.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/EventManager.verified.test.ts
@@ -0,0 +1,79 @@
+import { describe, expect, it, vi } from "vitest";
+
+vi.mock("@calcom/prisma", () => {
+  const mockPrisma = {
+    credential: {
+      findUnique: vi.fn(),
+    },
+    booking: {
+      findUnique: vi.fn(),
+    },
+  };
+  return { default: mockPrisma };
+});
+
+vi.mock("./CalendarManager", () => ({
+  createEvent: vi.fn(),
+  updateEvent: vi.fn().mockResolvedValue({ type: "google_calendar", success: true }),
+}));
+
+vi.mock("@calcom/app-store/_utils/getCalendar", () => ({ getCalendar: vi.fn() }));
+vi.mock("@calcom/app-store/dailyvideo/lib/VideoApiAdapter", () => ({ FAKE_DAILY_CREDENTIAL: {} }));
+vi.mock("@calcom/app-store/dailyvideo/zod", () => ({ appKeysSchema: {} }));
+vi.mock("@calcom/app-store/locations", () => ({
+  getEventLocationTypeFromApp: vi.fn(),
+  MeetLocationType: "integrations:google:meet",
+}));
+vi.mock("@calcom/app-store/utils", () => ({ default: vi.fn() }));
+vi.mock("@calcom/prisma/zod-utils", () => ({ createdEventSchema: {} }));
+vi.mock("./videoClient", () => ({ createMeeting: vi.fn(), updateMeeting: vi.fn() }));
+
+import prisma from "@calcom/prisma";
+import { updateEvent } from "./CalendarManager";
+
+describe("EventManager credential ownership", () => {
+  it("should not use a credential belonging to a different tenant when updating calendar events", async () => {
+    const { default: EventManager } = await import("./EventManager");
+
+    const foreignCredential = {
+      id: 999,
+      appId: "google-calendar",
+      type: "google_calendar",
+      userId: 12345,
+      key: { access_token: "foreign" },
+      invalid: false,
+      teamId: null,
+      app: { slug: "google-calendar" },
+    };
+
+    (prisma as any).credential.findUnique.mockResolvedValue(foreignCredential);
+
+    const manager = new EventManager([] as any);
+
+    const event = {} as any;
+    const booking = {
+      id: 1,
+      references: [
+        {
+          type: "google_calendar",
+          uid: "ref-uid",
+          credentialId: 999,
+          externalCalendarId: "ext-123",
+        },
+      ],
+    } as any;
+
+    try {
+      await (manager as any).updateAllCalendarEvents(event, booking);
+    } catch {
+      // allow legitimate errors from a fixed implementation that rejects cross-tenant use
+    }
+
+    expect(updateEvent).not.toHaveBeenCalledWith(
+      expect.objectContaining({ userId: 12345 }),
+      expect.anything(),
+      expect.anything(),
+      expect.anything()
+    );
+  });
+});
