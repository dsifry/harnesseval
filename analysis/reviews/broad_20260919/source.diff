+                               [self.revised('coverage  gap', 'bug'), self.revised('uncertain', 'unresolved')])
+        self.assertEqual((result['accepted_count'], result['unresolved_count']), (0, 1))
+        self.assertEqual(sum(len(r['sources']) for r in result['records']), 4)
