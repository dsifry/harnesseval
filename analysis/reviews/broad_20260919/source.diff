+    return [(i, r) for i, r in enumerate(records) if not (
+        r.get('matched_golden_ids') or r.get('primary_judge_verdict') == 'matched' or
+        (r.get('adjudication') or {}).get('verdict') == 'matched' or _normalize(r['issue_text']) in matched)]
