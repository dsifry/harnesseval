# Ruby runtime for Rails-side verified-gold evidence (discourse-graphite, 2013-2015 era).
#
# The host's system Ruby 2.6 cannot compile native extensions on modern macOS, and Alpine's Ruby 2.6
# needs every gem pinned to the last release that still supports it. This image provides the minimum
# for DATABASE-semantics evidence: the repository's own Rails generation (ActiveRecord 4.2.11.3) plus
# the pg adapter, so a real migration file can be run up and down against the Postgres service.
#
#   docker compose -f docker-compose.verify.yml build verify-ruby
#   docker compose -f docker-compose.verify.yml run --rm verify-ruby ruby -I. <test>
FROM ruby:2.6-alpine
RUN apk add --no-cache build-base postgresql-dev git tzdata
RUN gem install --no-document --conservative 'activerecord:4.2.11.3' 'pg:0.21.0'
WORKDIR /work
