# secrets / env
.env

# local tool / agent state (never commit)
.metareview/
.pi/

# results & caches (commit calibration evidence via `git add -f` when intentional)
results/
.cache/
__pycache__/
*.pyc

# vendored upstream checkouts (record SHA in docs instead)
third_party/

# Inspect logs (large) — KEEP IGNORED. This covers the repo-root logs/ (superseded scratch run output:
# anchor_matcher v1/v2/v3, a3* experiments, launch markers, and .eval inspect logs that are symlinked into
# runs/<id>/ rather than duplicated — ~47 MB, 188 files, not evidence for any published claim).
logs/
# EXCEPTION: the verified hidden-gold evidence under analysis/verified_gold/ IS the evidence the final
# report cites (every defect's executed head/fixed/sibling logs). It is small (~3.7 MB total), it must be
# tracked by DEFAULT so future runs cannot be silently dropped, and it is referenced by relative path from
# DEFECT_REGISTRY.json / GOLD_DEFECT_CATALOG.json, so the paths must not move.
!analysis/verified_gold/**/logs/
!analysis/verified_gold/**/logs/**
# Advisory readjudication raw call-log bulk: per-call request/response payloads with
# full embedded prompts — pair_calls, pair_attempts, group_calls, grouping_calls,
# grouping_attempts, and scoring-policy attempts. These are mode-(iii) inputs only:
# the identity decisions they fed are frozen in hash-bound groups/ and audit/ artifacts,
# so the offline numeric chain never needs the raw calls.
# The CURATED evidence IS tracked by default: verdicts, groups, proposals, audits,
# manifests, policies, thresholds, pilots, source snapshots, and the frozen per-run
# adjudication records in passes/*/runs/ (required input to the offline F2' chain —
# do NOT ignore).
analysis/verified_gold/advisory_readjudication/**/pair_calls/
analysis/verified_gold/advisory_readjudication/**/pair_attempts/
analysis/verified_gold/advisory_readjudication/**/group_calls/
analysis/verified_gold/advisory_readjudication/**/grouping_calls/
analysis/verified_gold/advisory_readjudication/**/grouping_attempts/
analysis/verified_gold/advisory_readjudication/**/attempts/

*.eval
/bin/
.venv/

# build artifacts
*.egg-info/
build/

# run registry IS committed (the index for analyzing runs over time)
# (do NOT ignore runs/registry.jsonl or runs/*/manifest.json or runs/*/summary.json)
# only the symlinked inspect_log.eval inside runs/ is covered by *.eval above
