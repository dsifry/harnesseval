# secrets / env
.env

# local tool / agent state (never commit)
.metareview/
.pi/

# results & caches (commit calibration evidence via `git add -f` when intentional)
results/
.cache/
__pycache__/
*.pyc

# vendored upstream checkouts (record SHA in docs instead)
third_party/

# Inspect logs (large) — commit selected evidence via `git add -f` when intentional;
# full evidence is linked into runs/<id>/ via symlink, not duplicated
logs/
*.eval
/bin/
.venv/

# build artifacts
*.egg-info/
build/

# run registry IS committed (the index for analyzing runs over time)
# (do NOT ignore runs/registry.jsonl or runs/*/manifest.json or runs/*/summary.json)
# only the symlinked inspect_log.eval inside runs/ is covered by *.eval above
